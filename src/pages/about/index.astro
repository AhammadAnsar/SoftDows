---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import ConceptualVisual from '../../components/ui/ConceptualVisual.astro';
import { aboutContent } from '../../lib/content/about';
import { teamData } from '../../lib/content/team';

const c = aboutContent;
const founderData = teamData['ansar-ahammad'];
---
export const prerender = true;

<MainLayout title={c.seo.title} description={c.seo.description}>
  <!-- 1. HERO SECTION -->
  <Section variant="light" size="large" class="pt-24 pb-20 md:pt-40 md:pb-32 bg-slate-50 relative overflow-hidden">
    <div class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_at_bottom_left,_var(--tw-gradient-stops))] from-indigo-100/40 via-transparent to-transparent pointer-events-none"></div>
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-16 relative z-10">
      <div class="w-full md:w-1/2">
        <Badge variant="primary" class="mb-6">{c.hero.eyebrow}</Badge>
        <h1 class="mb-8 text-5xl md:text-6xl lg:text-[4.5rem] text-[var(--color-brand-navy)] font-bold tracking-tight leading-[1.05]">
          {c.hero.heading}
        </h1>
        <p class="text-xl sm:text-2xl text-[var(--color-text-muted)] font-light leading-relaxed max-w-xl">
          {c.hero.description}
        </p>
      </div>
      <div class="w-full md:w-1/2">
        <ConceptualVisual concept="collaboration" class="w-full h-full min-h-[400px] shadow-xl" />
      </div>
    </div>
  </Section>

  <!-- 2. WHO WE ARE (STORY) -->
  <Section variant="default" size="normal" class="border-y border-slate-100">
    <div class="flex flex-col lg:flex-row gap-16 lg:gap-24 max-w-7xl mx-auto items-center">
      <div class="lg:w-1/2">
        <Badge variant="secondary" class="mb-6">{c.story.heading}</Badge>
        <h2 class="mb-10 text-4xl font-bold text-[var(--color-brand-navy)] tracking-tight leading-tight">We build technology that elevates human potential.</h2>
        <div class="space-y-6 text-lg text-[var(--color-text-muted)] leading-relaxed font-light">
          {c.story.paragraphs.map((p: string) => (
            <p>{p}</p>
          ))}
        </div>
      </div>
      <div class="lg:w-1/2 w-full">
        <div class="bg-[var(--color-brand-navy)] text-white p-12 rounded-3xl h-full flex flex-col justify-center shadow-2xl relative overflow-hidden group">
          <div class="absolute top-0 right-0 -mt-10 -mr-10 w-64 h-64 bg-[var(--color-brand-purple)] opacity-20 rounded-full blur-[60px] group-hover:bg-indigo-500 transition-colors duration-700"></div>
          <h3 class="text-3xl font-bold mb-6 text-white relative z-10 tracking-tight">{c.story.mission.title}</h3>
          <p class="text-[var(--color-brand-light)] text-xl leading-relaxed opacity-90 relative z-10 font-light">
            {c.story.mission.description}
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- 3. FOUNDER SECTION -->
  <Section variant="alternate" size="normal" class="bg-slate-50 border-b border-slate-100">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-16">
      <div class="w-full md:w-5/12 flex justify-center md:justify-end">
        <img src="/ansar-ahammad.jpg" alt={founderData.displayName} class="w-full max-w-sm rounded-[2rem] shadow-xl rotate-1 hover:rotate-0 transition-transform duration-500 object-cover object-top aspect-[4/5]" />
      </div>
      <div class="w-full md:w-2/3 text-center md:text-left">
        <Badge class="mb-4">{c.founder.heading}</Badge>
        <h2 class="text-3xl font-bold text-[var(--color-brand-navy)] mb-2">{founderData.displayName}</h2>
        <p class="text-[var(--color-brand-purple)] font-medium mb-6 uppercase tracking-wider text-sm">{founderData.role}</p>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed max-w-2xl">
          {founderData.shortBio}
        </p>
      </div>
    </div>
  </Section>

  <!-- 4. CORE PRINCIPLES -->
  <Section variant="default" size="normal">
    <div class="mb-16 md:mb-20 max-w-3xl">
      <h2 class="mb-6 text-3xl md:text-4xl font-bold text-[var(--color-brand-navy)] tracking-tight">{c.principles.heading}</h2>
      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
        {c.principles.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {c.principles.items.map((principle, index) => (
        <div class="border-t-2 border-slate-200 pt-6 group hover:border-[var(--color-brand-purple)] transition-colors">
          <div class="text-sm font-bold text-[var(--color-brand-purple)] mb-4 tracking-widest uppercase opacity-70">
            0{index + 1}
          </div>
          <h3 class="text-xl font-bold mb-4 text-[var(--color-brand-navy)]">{principle.title}</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed">
            {principle.description}
          </p>
        </div>
      ))}
    </div>
  </Section>

  <!-- 5. FINAL CTA -->
  <Section variant="dark" size="normal" class="text-center bg-[#1a1f3c]">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-6 text-3xl md:text-5xl font-bold text-white tracking-tight">{c.cta.heading}</h2>
      <p class="mb-10 text-lg sm:text-xl text-[var(--color-brand-light)] opacity-90 leading-relaxed">
        {c.cta.description}
      </p>
      <div class="flex justify-center">
        <Button href={c.cta.primaryCta.url} variant="inverse" class="text-lg px-10 py-3">{c.cta.primaryCta.label}</Button>
      </div>
    </div>
  </Section>
</MainLayout>






