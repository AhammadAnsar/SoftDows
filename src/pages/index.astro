---
export const prerender = true;
import MainLayout from '../layouts/MainLayout.astro';
import ConceptualVisual from '../components/ui/ConceptualVisual.astro';
import { homeContent } from '../lib/content/home';
import { getPublishedVentures } from '../lib/content/ventures';
import { getPublishedProducts } from '../lib/content/products';
import { getPublishedTeam } from '../lib/content/team';
import { clientPartners } from '../lib/content/clients';

const c: any = homeContent;

const publishedVentures = getPublishedVentures();
const allProducts = getPublishedProducts();
const featuredProducts = allProducts.slice(0, 6);
const featuredVentures = publishedVentures.filter(v => v.featured).slice(0, 4);
const founder = getPublishedTeam().find(m => m.id === 'ansar-ahammad');

const productVisuals: Record<string, { gradient: string; badge: string; svgPath: string }> = {
  'biddalok': {
    gradient: 'from-blue-500 to-indigo-600',
    badge: 'EdTech ERP',
    svgPath: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222'
  },
  'eduweb': {
    gradient: 'from-cyan-500 to-blue-600',
    badge: 'Portal Engine',
    svgPath: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9'
  },
  'smarttutor': {
    gradient: 'from-violet-500 to-purple-600',
    badge: 'Adaptive LMS',
    svgPath: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'
  },
  'mymosque': {
    gradient: 'from-emerald-500 to-teal-600',
    badge: 'Community Tech',
    svgPath: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4'
  },
  'experthunter': {
    gradient: 'from-amber-500 to-orange-600',
    badge: 'Talent Discovery',
    svgPath: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7'
  },
  'easywebdev': {
    gradient: 'from-rose-500 to-pink-600',
    badge: 'Dev Platform',
    svgPath: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4'
  }
};
---

<MainLayout title={c.seo.title} description={c.seo.description}>
  
  <!-- ========================================================================= -->
  <!-- 1. HERO: Visual-First, High-Impact Visual Console with Icon Indicators   -->
  <!-- ========================================================================= -->
  <section class="relative overflow-hidden pt-8 pb-16 md:pt-14 md:pb-24 lg:pt-16 lg:pb-28 bg-[#FCFDFE] border-b border-slate-100">
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-[15%] right-[5%] w-[600px] h-[600px] rounded-full bg-gradient-to-br from-[#5568d3]/10 to-indigo-100/30 blur-3xl"></div>
      <div class="absolute top-[30%] -left-[10%] w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-sky-100/30 to-transparent blur-3xl"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#00000004_1px,transparent_1px),linear-gradient(to_bottom,#00000004_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center gap-2.5 text-xs font-semibold text-[#5568d3] mb-6">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="tracking-wide uppercase">Software Engineering & Digital Platforms</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <div class="lg:col-span-6 flex flex-col items-start text-left">
          
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[#192040] tracking-tight leading-[1.1] mb-5">
            Architecting <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#192040] via-[#5568d3] to-[#4557c2]">
              Digital Excellence
            </span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed max-w-lg mb-8">
            High-performance web apps, scalable software platforms, and modern eCommerce systems built with clean code and zero technical debt.
          </p>

          <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto mb-10">
            <a 
              href="/start-a-project/" 
              class="inline-flex items-center justify-center px-6 py-3.5 bg-[#192040] hover:bg-[#242a56] text-white text-sm font-semibold rounded-xl shadow-lg shadow-[#192040]/15 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200 gap-2.5"
            >
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <span>Start a Project</span>
            </a>
            
            <a 
              href="#services" 
              class="inline-flex items-center justify-center px-5 py-3.5 bg-white hover:bg-slate-50 text-slate-800 text-sm font-semibold rounded-xl border border-slate-200 shadow-sm transition-all duration-200 gap-2"
            >
              <span>Explore Services</span>
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 w-full pt-4 border-t border-slate-100">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-[#5568d3] shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <div>
                <div class="text-xs font-bold text-slate-800">100% IP</div>
                <div class="text-[10px] text-slate-500">Ownership</div>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600 shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <div>
                <div class="text-xs font-bold text-slate-800">&lt;100ms</div>
                <div class="text-[10px] text-slate-500">Edge Speed</div>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center text-blue-600 shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
              </div>
              <div>
                <div class="text-xs font-bold text-slate-800">6 Platforms</div>
                <div class="text-[10px] text-slate-500">Active Live</div>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-purple-50 flex items-center justify-center text-purple-600 shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
              </div>
              <div>
                <div class="text-xs font-bold text-slate-800">24/7 SLA</div>
                <div class="text-[10px] text-slate-500">Support</div>
              </div>
            </div>
          </div>

        </div>

        <div class="lg:col-span-6 relative">
          <div class="relative rounded-2xl shadow-2xl overflow-hidden border border-slate-200/80 bg-white">
            <ConceptualVisual concept="hero-system" class="w-full aspect-[4/3] min-h-[360px] sm:min-h-[420px]" />
            
            <div class="absolute z-30 bottom-4 left-4 right-4 bg-white/95 backdrop-blur-md p-3.5 rounded-xl border border-slate-200/80 shadow-lg flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-[#192040] text-white flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                  <div class="text-xs font-bold text-[#192040]">Engineered by SoftDows</div>
                  <div class="text-[11px] text-slate-500">Clean Architecture · Zero Technical Debt</div>
                </div>
              </div>
              <a href="/services/" class="text-xs font-bold text-[#5568d3] hover:underline flex items-center gap-1">
                Explore &rarr;
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. THE THREE ECOSYSTEM PILLARS: Visual Triad                             -->
  <!-- ========================================================================= -->
  <section class="py-16 md:py-20 bg-white border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#192040]">The SoftDows Ecosystem</h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2">Three focused divisions powering complete digital transformation.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Pillar 1 -->
        <a href="/services/" class="group p-6 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-[#5568d3]/40 hover:bg-white hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-indigo-50 border border-indigo-100 text-[#5568d3] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">01 · Services</div>
            <h3 class="text-xl font-bold text-[#192040] mb-2 group-hover:text-[#5568d3] transition-colors">Client Engineering</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Bespoke web applications, UI/UX systems, and tailored digital platforms engineered to order.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200/60 flex items-center justify-between text-xs font-bold text-[#5568d3]">
            <span>8 Specialized Services</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Pillar 2 -->
        <a href="/products/" class="group p-6 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-[#5568d3]/40 hover:bg-white hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            </div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">02 · Products</div>
            <h3 class="text-xl font-bold text-[#192040] mb-2 group-hover:text-[#5568d3] transition-colors">Software Platforms</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Ready-to-deploy platforms for school workflows, community management, and developer tools.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200/60 flex items-center justify-between text-xs font-bold text-[#5568d3]">
            <span>6 Turnkey Products</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Pillar 3 -->
        <a href="/ventures/" class="group p-6 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-[#5568d3]/40 hover:bg-white hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-5">
              <div class="w-12 h-12 rounded-xl bg-violet-50 border border-violet-100 text-violet-600 flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
              </div>
              <div class="flex -space-x-1.5 overflow-hidden">
                <img src="/images/ventures/banglanotice.png" alt="BanglaNotice" class="inline-block h-6 w-6 rounded-full ring-2 ring-white object-contain bg-white" />
                <img src="/images/ventures/bidyashikhi.png" alt="BidyaShikhi" class="inline-block h-6 w-6 rounded-full ring-2 ring-white object-contain bg-white" />
                <img src="/images/ventures/nicetrix.png" alt="NiceTrix" class="inline-block h-6 w-6 rounded-full ring-2 ring-white object-contain bg-white" />
                <img src="/images/ventures/baharimart.png" alt="BahariMart" class="inline-block h-6 w-6 rounded-full ring-2 ring-white object-contain bg-white" />
              </div>
            </div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">03 · Studio</div>
            <h3 class="text-xl font-bold text-[#192040] mb-2 group-hover:text-[#5568d3] transition-colors">Venture Studio</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Internal brands and regional educational portals reaching large scale organic audiences.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200/60 flex items-center justify-between text-xs font-bold text-[#5568d3]">
            <span>4 Active Ventures</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. VISUAL CAPABILITY SHOWCASE                                            -->
  <!-- ========================================================================= -->
  <section id="services" class="py-16 md:py-24 bg-[#f8fafc] border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
        <div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-[#192040]">Core Capabilities</h2>
          <p class="text-slate-600 text-sm sm:text-base mt-1">Full-stack technical execution across modern web and software.</p>
        </div>
        <a href="/services/" class="text-xs sm:text-sm font-semibold text-[#5568d3] hover:underline flex items-center gap-1">
          View all 8 services &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- 1. Custom Software -->
        <a href="/services/custom-software-web-applications/" class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col">
          <div class="h-44 w-full bg-slate-50 border-b border-slate-100 overflow-hidden relative">
            <ConceptualVisual concept="custom-software" class="w-full h-full" />
          </div>
          <div class="p-5 flex flex-col flex-grow justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2 text-[#5568d3]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span class="text-[11px] font-bold uppercase tracking-wider">Web Apps</span>
              </div>
              <h3 class="text-lg font-bold text-[#192040] group-hover:text-[#5568d3] transition-colors">Custom Software</h3>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">Scalable web applications, portals & dashboards.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-semibold text-[#5568d3] flex items-center justify-between">
              <span>Explore</span>
              <span>&rarr;</span>
            </div>
          </div>
        </a>

        <!-- 2. Website Design -->
        <a href="/services/website-design-development/" class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col">
          <div class="h-44 w-full bg-slate-50 border-b border-slate-100 overflow-hidden relative">
            <ConceptualVisual concept="website-design" class="w-full h-full" />
          </div>
          <div class="p-5 flex flex-col flex-grow justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2 text-[#5568d3]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span class="text-[11px] font-bold uppercase tracking-wider">Modern Web</span>
              </div>
              <h3 class="text-lg font-bold text-[#192040] group-hover:text-[#5568d3] transition-colors">Website Design</h3>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">Fast, responsive & high-converting brand sites.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-semibold text-[#5568d3] flex items-center justify-between">
              <span>Explore</span>
              <span>&rarr;</span>
            </div>
          </div>
        </a>

        <!-- 3. eCommerce Development -->
        <a href="/services/ecommerce-development/" class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col">
          <div class="h-44 w-full bg-slate-50 border-b border-slate-100 overflow-hidden relative">
            <ConceptualVisual concept="ecommerce" class="w-full h-full" />
          </div>
          <div class="p-5 flex flex-col flex-grow justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2 text-[#5568d3]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                <span class="text-[11px] font-bold uppercase tracking-wider">Commerce</span>
              </div>
              <h3 class="text-lg font-bold text-[#192040] group-hover:text-[#5568d3] transition-colors">eCommerce Systems</h3>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">Seamless checkout funnels & payment gateways.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-semibold text-[#5568d3] flex items-center justify-between">
              <span>Explore</span>
              <span>&rarr;</span>
            </div>
          </div>
        </a>

        <!-- 4. Maintenance & Cloud -->
        <a href="/services/website-maintenance-support/" class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col">
          <div class="h-44 w-full bg-slate-50 border-b border-slate-100 overflow-hidden relative">
            <ConceptualVisual concept="maintenance" class="w-full h-full" />
          </div>
          <div class="p-5 flex flex-col flex-grow justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2 text-[#5568d3]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                <span class="text-[11px] font-bold uppercase tracking-wider">Support</span>
              </div>
              <h3 class="text-lg font-bold text-[#192040] group-hover:text-[#5568d3] transition-colors">Cloud & Maintenance</h3>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">24/7 security monitoring, backups & SLAs.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-semibold text-[#5568d3] flex items-center justify-between">
              <span>Explore</span>
              <span>&rarr;</span>
            </div>
          </div>
