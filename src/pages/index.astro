---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import ConceptualVisual from '../components/ui/ConceptualVisual.astro';
import { homeContent } from '../lib/content/home';
import { getPublishedVentures } from '../lib/content/ventures';
import { getPublishedProducts } from '../lib/content/products';
import { getPublishedTeam } from '../lib/content/team';

const c = homeContent;
const publishedVentures = getPublishedVentures();
const featuredProducts = getPublishedProducts().filter(p => p.featured).slice(0, 4);
const featuredVentures = publishedVentures.filter(v => v.featured).slice(0, 3);
const founder = getPublishedTeam().find(m => m.id === 'ansar-ahammad');
---

<MainLayout title={c.seo.title} description={c.seo.description}>
  <!-- 1. HERO -->
  <Section variant="light" size="large" class="relative overflow-hidden pt-28 pb-12 md:pt-32 md:pb-16 bg-slate-50 border-b border-slate-100">
    <div class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-100/40 via-white to-white opacity-80 pointer-events-none"></div>
    <div class="relative z-10 flex flex-col lg:flex-row items-center gap-16 lg:gap-20">
      <div class="w-full lg:w-1/2 flex flex-col items-start text-left">
        <Badge variant="primary" class="mb-8">{c.hero.eyebrow}</Badge>
        <h1 class="mb-6 text-5xl md:text-6xl lg:text-7xl font-bold text-[var(--color-brand-navy)] tracking-tight leading-[1.05]">
          {c.hero.heading}
        </h1>
        <p class="mb-10 text-xl lg:text-2xl text-[var(--color-text-muted)] font-light leading-relaxed max-w-xl">
          {c.hero.description}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <Button href={c.hero.primaryCta.url} variant="primary" size="large">{c.hero.primaryCta.label}</Button>
          <Button href={c.hero.secondaryCta.url} variant="outline" size="large">{c.hero.secondaryCta.label}</Button>
        </div>
      </div>
      <div class="w-full lg:w-1/2 relative">
        <ConceptualVisual concept="hero-system" class="w-full h-full min-h-[500px] lg:min-h-[650px] shadow-2xl rounded-[2rem] hover:scale-[1.02] transition-transform duration-700 ease-out" />
      </div>
    </div>
  </Section>

  <!-- 2. ECOSYSTEM / WHAT WE BUILD -->
  <Section variant="default" size="normal" class="border-b border-slate-100">
    <div class="mb-16 md:mb-20 max-w-3xl mx-auto text-center">
      <Badge class="mb-4">The SoftDows Ecosystem</Badge>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--color-brand-navy)] mb-6 tracking-tight">Comprehensive Digital Engineering</h2>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] font-light leading-relaxed">
        We operate across three distinct pillars to provide end-to-end technological capabilities for modern businesses.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {/* Services */}
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
        <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">What We Do</div>
        <h3 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-3">Client Services</h3>
        <p class="text-[var(--color-text-muted)] mb-6 leading-relaxed">Professional engineering, design, and digital visibility services tailored to your specific commercial requirements.</p>
        <a href="/services/" class="font-semibold text-[var(--color-brand-purple)] hover:underline">Explore Services &rarr;</a>
      </div>
      {/* Products */}
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
        <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">What We Build</div>
        <h3 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-3">Software Products</h3>
        <p class="text-[var(--color-text-muted)] mb-6 leading-relaxed">Proprietary software platforms providing structured solutions for administration, learning, and discovery.</p>
        <a href="/products/" class="font-semibold text-[var(--color-brand-purple)] hover:underline">View Products &rarr;</a>
      </div>
      {/* Ventures */}
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
        <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">What We Operate</div>
        <h3 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-3">Ventures</h3>
        <p class="text-[var(--color-text-muted)] mb-6 leading-relaxed">Internal platforms and brands owned and operated by SoftDows reaching regional audiences.</p>
        <a href="/ventures/" class="font-semibold text-[var(--color-brand-purple)] hover:underline">Discover Ventures &rarr;</a>
      </div>
    </div>
  </Section>

  <!-- 3. SERVICES -->
  <Section variant="alternate" size="normal" class="bg-slate-50 border-b border-slate-100 relative overflow-hidden">
    <div class="mb-12 md:mb-16 max-w-3xl mx-auto text-center relative z-10">
      <Badge class="mb-6">{c.services.heading}</Badge>
      <h2 class="mb-6 text-3xl md:text-5xl font-bold text-[var(--color-brand-navy)] tracking-tight">Technical Capability</h2>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] font-light leading-relaxed">
        {c.services.description}
      </p>
    </div>
    <div class="max-w-4xl mx-auto relative z-10">
      <div class="flex flex-col gap-0 border-t border-slate-200">
        {c.services.items.map((service: any, index: number) => (
          <a href={service.url} class="group block py-6 md:py-8 border-b border-slate-200 hover:bg-white transition-colors -mx-6 px-6 md:-mx-8 md:px-8 rounded-lg">
            <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6 mb-2">
              <span class="text-sm font-bold text-[var(--color-brand-purple)] opacity-70 w-8 shrink-0 font-mono">0{index + 1}</span>
              <h3 class="text-2xl font-bold text-[var(--color-brand-navy)] group-hover:text-[var(--color-brand-purple)] transition-colors">{service.title}</h3>
            </div>
            <p class="text-[var(--color-text-muted)] leading-relaxed md:pl-14 text-lg max-w-2xl">
              {service.description}
            </p>
          </a>
        ))}
        
        <!-- Infrastructure manually added for homepage display -->
        <a href="/services/domain-registration-management/" class="group block py-6 md:py-8 border-b border-slate-200 hover:bg-white transition-colors -mx-6 px-6 md:-mx-8 md:px-8 rounded-lg">
            <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6 mb-2">
              <span class="text-sm font-bold text-[var(--color-brand-purple)] opacity-70 w-8 shrink-0 font-mono">07</span>
              <h3 class="text-2xl font-bold text-[var(--color-brand-navy)] group-hover:text-[var(--color-brand-purple)] transition-colors">Domain & Hosting Infrastructure</h3>
            </div>
            <p class="text-[var(--color-text-muted)] leading-relaxed md:pl-14 text-lg max-w-2xl">
              Professional domain registration and managed high-performance hosting for robust digital operations.
            </p>
          </a>
      </div>
    </div>
    <div class="text-center mt-12 relative z-10">
      <Button href="/services/" variant="outline">Explore All Services</Button>
    </div>
  </Section>

  <!-- 4. PRODUCTS -->
  <Section variant="dark" size="normal" class="bg-[#0B0E23] text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    <div class="absolute top-0 right-0 w-full h-full bg-[radial-gradient(ellipse_at_bottom_right,_var(--tw-gradient-stops))] from-[var(--color-brand-purple)]/30 via-[var(--color-brand-navy)]/20 to-transparent opacity-80 pointer-events-none"></div>

    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 max-w-7xl mx-auto gap-6 relative z-10">
      <div class="max-w-2xl">
        <Badge variant="primary" class="mb-4 bg-[var(--color-brand-purple)] text-white border-transparent">Software Platforms</Badge>
        <h2 class="text-3xl md:text-5xl text-white font-bold tracking-tight">Products</h2>
      </div>
      <a href="/products/" class="text-[var(--color-brand-light)] font-medium hover:text-white hover:underline underline-offset-4 rounded-sm whitespace-nowrap">
        View all products &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 relative z-10">
      {featuredProducts.map((product) => (
        <a href={`/products/${product.slug}/`} class="group bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8 hover:bg-white/10 transition-colors">
          <Badge variant="inverse" class="mb-4 inline-block">Software</Badge>
          <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-[var(--color-brand-light)] transition-colors">{product.name}</h3>
          <p class="text-slate-300 mb-6 font-light leading-relaxed">{product.shortDescription}</p>
          <span class="text-[var(--color-brand-purple)] font-medium">Explore Details &rarr;</span>
        </a>
      ))}
    </div>
  </Section>

  <!-- 5. VENTURES -->
  <Section variant="default" size="normal" class="border-b border-slate-100">
    <div class="mb-12 max-w-3xl mx-auto text-center">
      <Badge class="mb-6">Our Operations</Badge>
      <h2 class="text-3xl md:text-5xl font-bold text-[var(--color-brand-navy)] mb-6 tracking-tight">Ventures</h2>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] font-light leading-relaxed">
        SoftDows actively builds and operates internal platforms and brands addressing regional audiences.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto">
      {featuredVentures.map(venture => (
        <a href={`/ventures/${venture.slug}/`} class="group block border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-300 bg-white hover:-translate-y-1">
          <div class="h-40 bg-slate-50 border-b border-slate-100 flex items-center justify-center relative overflow-hidden">
             <ConceptualVisual concept={venture.slug === 'banglanotice' ? 'seo' : venture.slug === 'bidyashikhi' ? 'website-design' : 'custom-software'} class="absolute inset-0 opacity-20" />
             <div class="relative z-10 w-16 h-16 rounded-xl bg-white shadow-sm border border-slate-200 flex items-center justify-center text-xl font-bold text-[var(--color-brand-navy)]">
               {venture?.brandName.charAt(0)}
             </div>
          </div>
          <div class="p-8">
            <Badge variant="primary" class="mb-3">{venture.category}</Badge>
            <h3 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-2 group-hover:text-[var(--color-brand-purple)] transition-colors">{venture?.brandName}</h3>
            <p class="text-[var(--color-text-muted)] mb-4">{venture?.shortDescription}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="text-center mt-12 relative z-10">
      <Button href="/ventures/" variant="outline">Explore All Ventures</Button>
    </div>
  </Section>

  <!-- 6. HOW WE WORK -->
  <Section variant="alternate" size="normal" class="bg-slate-50 border-b border-slate-100">
    <div class="mb-16 md:mb-20 max-w-3xl mx-auto text-center">
      <Badge class="mb-4">{c.process.heading}</Badge>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--color-brand-navy)] mb-6 tracking-tight">Structured Engineering</h2>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] font-light leading-relaxed">
        {c.process.description}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto relative">
      <div class="hidden lg:block absolute top-12 left-1/4 right-1/4 h-0.5 bg-slate-200 z-0"></div>
      {c.process.steps.map((step: any, idx: number) => (
        <div class="relative z-10 bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center font-bold text-[var(--color-brand-purple)] mb-6">
            0{idx + 1}
          </div>
          <h3 class="text-xl font-bold text-[var(--color-brand-navy)] mb-3">{step.title}</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- 7. TEAM -->
  <Section variant="default" size="normal">
    <div class="flex flex-col md:flex-row justify-between items-center mb-16 max-w-7xl mx-auto gap-8">
      <div class="max-w-2xl text-center md:text-left">
        <Badge class="mb-4">Leadership</Badge>
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-brand-navy)] tracking-tight mb-4">The Team Behind SoftDows</h2>
        <p class="text-lg text-[var(--color-text-muted)] font-light leading-relaxed">
          Meet the people and specialists engineering our solutions.
        </p>
      </div>
      <Button href="/team/" variant="outline">Meet the Team</Button>
    </div>

    {founder && (
      <div class="max-w-4xl mx-auto bg-slate-50 rounded-3xl p-8 md:p-12 border border-slate-100 flex flex-col md:flex-row items-center gap-8">
        <div class="w-32 h-32 md:w-40 md:h-40 shrink-0 rounded-full bg-slate-200 border-4 border-white shadow-lg overflow-hidden flex items-center justify-center text-4xl font-bold text-slate-400">
          {founder?.photo ? <img src={founder?.photo} alt={founder?.fullName} class="w-full h-full object-cover" /> : founder?.fullName.charAt(0)}
        </div>
        <div class="text-center md:text-left">
          <Badge variant="primary" class="mb-3">{founder?.role}</Badge>
          <h3 class="text-2xl md:text-3xl font-bold text-[var(--color-brand-navy)] mb-4">{founder?.fullName}</h3>
          <p class="text-[var(--color-text-muted)] text-lg leading-relaxed mb-6">
            {founder?.shortBio}
          </p>
          <a href={`/team/${founder?.slug}/`} class="font-semibold text-[var(--color-brand-purple)] hover:underline">View Profile &rarr;</a>
        </div>
      </div>
    )}
  </Section>

  <!-- 8. CAPABILITY / TRUST -->
  <Section variant="alternate" size="large" class="bg-[var(--color-brand-navy)] text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white/5 to-transparent opacity-50"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-8 tracking-tight text-white leading-tight">
        {c.finalCta.heading}
      </h2>
      <p class="text-xl text-slate-300 font-light mb-12 leading-relaxed max-w-2xl mx-auto">
        {c.finalCta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={c.finalCta.primaryCta.url} variant="primary" size="large" class="bg-[var(--color-brand-purple)] text-white border-transparent hover:bg-purple-600">
          {c.finalCta.primaryCta.label}
        </Button>
        <Button href={c.finalCta.secondaryCta.url} variant="outline" size="large" class="border-white/20 text-white hover:bg-white/10">
          {c.finalCta.secondaryCta.label}
        </Button>
      </div>
    </div>
  </Section>
</MainLayout>


