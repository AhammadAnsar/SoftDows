---
export const prerender = true;
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/ui/Section.astro';
import Badge from '../components/ui/Badge.astro';
---

<style>
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');
  .font-bengali {
    font-family: 'Hind Siliguri', sans-serif;
  }
  
  @media print {
    body {
      background: white !important;
      color: black !important;
    }
    nav, footer, #legal-notice-trigger, .no-print {
      display: none !important;
    }
    .print-container {
      width: 100% !important;
      max-width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
      box-shadow: none !important;
      border: none !important;
    }
    h1 {
      font-size: 24pt !important;
      margin-bottom: 16pt !important;
    }
    h3 {
      font-size: 16pt !important;
    }
    p, li {
      font-size: 12pt !important;
      line-height: 1.5 !important;
    }
    .page-break {
      page-break-before: always;
    }
  }
</style>

<MainLayout title="Legal Notice & Disclaimer | SoftDows" description="Official legal disclaimer regarding mygovbd.com and domain registration policy.">
  <Section variant="light" size="large" class="pt-32 pb-24 bg-slate-50 min-h-screen font-bengali">
    <div class="max-w-4xl mx-auto print-container bg-white rounded-3xl shadow-xl shadow-slate-200/50 p-8 md:p-14 border-t-8 border-[var(--color-brand-navy)]">
      
      <!-- Top Action Bar (Hide in Print) -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-10 no-print border-b border-slate-100 pb-6">
        <Badge>Official Document</Badge>
        <button onclick="window.print()" class="inline-flex items-center gap-2 bg-[var(--color-brand-navy)] text-white px-5 py-2.5 rounded-lg hover:bg-slate-800 transition-colors shadow-sm font-semibold text-sm">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
          প্রিন্ট / PDF সংরক্ষণ করুন
        </button>
      </div>

      <!-- Header Content -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-amber-100 text-amber-600 mb-6">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-900 leading-tight mb-4 text-balance">
          mygovbd.com ডোমেইন সংক্রান্ত জরুরি সতর্কবার্তা ও আনুষ্ঠানিক দায়মুক্তি ঘোষণা (Official Legal Disclaimer)
        </h1>
        <div class="inline-block bg-slate-100 text-slate-600 px-4 py-2 rounded-lg text-sm font-medium">
          প্রকাশের তারিখ: ০৪ অক্টোবর, ২০২৬ খ্রি. | অনুসন্ধান সূত্র: সিআই/সিপিসি/অনুসন্ধান/১৮৪-২০২৬/২৫২১
        </div>
      </div>

      <!-- Main Body -->
      <div class="prose prose-lg max-w-none text-slate-700 space-y-8">
        <p class="text-xl leading-relaxed text-slate-800 font-medium text-justify">
          প্রিয় ভিজিটর ও সংশ্লিষ্ট কর্তৃপক্ষ, আমরা অত্যন্ত উদ্বেগের সাথে লক্ষ্য করছি যে, <strong>mygovbd.com</strong> নামক একটি ওয়েবসাইট ব্যবহার করে কোনো অসাধু চক্র ভুয়া সরকারি সনদ বা অ্যাপোস্টিল (Apostille) ডকুমেন্ট যাচাইয়ের নামে সাধারণ মানুষের সাথে প্রতারণা করছে। ইন্টারনেটের পুরনো আর্কাইভ বা ডোমেইন হিস্ট্রিতে আমাদের প্রতিষ্ঠান <strong>SoftDows (softdows.com)</strong>-এর নাম থাকায় অনেকে বিভ্রান্ত হচ্ছেন। সকলের কাছে বিষয়টি শতভাগ স্বচ্ছ ও পরিষ্কার করার লক্ষ্যে আমাদের অবস্থান ও আইনি ঘোষণা নিচে তুলে ধরা হলো:
        </p>

        <div class="space-y-6">
          <section>
            <h3 class="text-xl font-bold text-[var(--color-brand-navy)] mb-3 flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center text-sm">১</span>
              প্রকৃত ঘটনা ও ডোমেইন পরিত্যাগ
            </h3>
            <p class="text-justify leading-relaxed">
              আমরা মূলত বিভিন্ন শিক্ষক, শিক্ষা প্রতিষ্ঠান ও ক্লায়েন্টদের জন্য ওয়েব ডিজাইন, ওয়েবসাইট ডেভেলপমেন্ট ও ডিজিটাল মার্কেটিংয়ের কাজ করে দেওয়ার লক্ষ্যে softdows.com পরিচালনা করি। গত ২০২৩ সালে বিভিন্ন সরকারি সেবার নিয়মাবলি সহজ বাংলায় সাধারণ মানুষের কাছে ব্লগ বা আর্টিকেল আকারে তুলে ধরার প্রাথমিক চিন্তা থেকে আমরা অজ্ঞতাবশত mygovbd.com ডোমেইনটি নিবন্ধন করেছিলাম। কিন্তু পরবর্তীতে আমরা নিজেরাই উপলব্ধি করি যে, নামের ভেতরে সরকারি প্রতিষ্ঠানের নামের সাদৃশ্য (gov এবং bd) থাকায় সাধারণ মানুষ বিভ্রান্ত হতে পারে। এই নৈতিক অবস্থান থেকে আমরা সাইটটি নিয়ে কোনো কাজ না করার সিদ্ধান্ত নিই এবং হোস্টিং থেকে তা মুছে ফেলি। পরবর্তীতে ১ বছরের মেয়াদ শেষ হওয়ার পর আমরা ডোমেইনটি আর নবায়ন (Renew) করিনি।
            </p>
          </section>

          <section>
            <h3 class="text-xl font-bold text-[var(--color-brand-navy)] mb-3 flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center text-sm">২</span>
              আন্তর্জাতিক ডোমেইন নীতিমালা (ICANN Policy) ও মালিকানা সমাপ্তি
            </h3>
            <p class="text-justify leading-relaxed">
              আন্তর্জাতিক ডোমেইন নিয়ন্ত্রণকারী সংস্থা ICANN (Internet Corporation for Assigned Names and Numbers)-এর Expired Registration Recovery Policy (ERRP) অনুযায়ী, কোনো ডোমেইন নির্ধারিত সময়ে নবায়ন না করলে তা 'Redemption Grace Period' ও 'Pending Delete' ধাপ অতিক্রম করে পুনরায় উন্মুক্ত বাজারে (Public Pool) চলে যায়। তখন যে কেউ ডোমেইনটি নতুন করে কিনে নিতে পারে। আমাদের নবায়ন না করার ফলে ডোমেইনটির ওপর আমাদের সমস্ত অধিকার ও কারিগরি নিয়ন্ত্রণ স্বয়ংক্রিয়ভাবে সমাপ্ত হয়েছে। পরবর্তীতে কোন প্রতারক চক্র ডোমেইনটি পুনরায় কিনেছে এবং কী কাজে ব্যবহার করছে, তা আমাদের জানার বা নিয়ন্ত্রণের সম্পূর্ণ বাইরে।
            </p>
          </section>

          <section>
            <h3 class="text-xl font-bold text-[var(--color-brand-navy)] mb-3 flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center text-sm">৩</span>
              প্রচলিত আইন ও দায়মুক্তি (Legal Indemnity)
            </h3>
            <p class="text-justify leading-relaxed">
              বাংলাদেশের প্রচলিত সাইবার নিরাপত্তা আইন, ২০২৩ এবং দণ্ডবিধি, ১৮৬০ (Penal Code, 1860)-এর জালিয়াতি ও প্রতারণা সংক্রান্ত ধারা অনুযায়ী, কোনো ডিজিটাল মাধ্যম বা ডোমেইনের অপরাধমূলক দায়ভার সম্পূর্ণভাবে উক্ত অপরাধ সংঘটনের সময়ে ডোমেইনটির প্রকৃত নিয়ন্ত্রণকারী (Current Registrant & Hosting Operator)-এর ওপর বর্তায়। যেহেতু ডোমেইনটি আমরা পরিত্যাগ করেছি এবং এর বর্তমান হোস্টিং, সার্ভার বা কন্ট্রোল প্যানেলের সাথে SoftDows (softdows.com)-এর দূরতম কোনো সম্পর্ক নেই, সেহেতু উক্ত ডোমেইন ব্যবহার করে সংঘটিত কোনো অপরাধ, জালিয়াতি বা আর্থিক লেনদেনের জন্য SoftDows বা এর স্বত্বাধিকারী আইনত কোনোভাবেই দায়ী থাকবে না।
            </p>
          </section>

          <section>
            <h3 class="text-xl font-bold text-[var(--color-brand-navy)] mb-3 flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center text-sm">৪</span>
              আইনশৃঙ্খলা বাহিনীর সাথে সহযোগিতা
            </h3>
            <p class="text-justify leading-relaxed">
              একজন আইনের প্রতি শ্রদ্ধাশীল নাগরিক হিসেবে, পররাষ্ট্র মন্ত্রণালয়ের সূত্র (স্মারক নং- ১৯.০০.০০০০.৫১০.৯৯.০০২.২৪.৩৬১) এবং সিআইডির সাইবার পুলিশ সেন্টারের অনুসন্ধান (সূত্র: সিআই/সিপিসি/অনুসন্ধান/১৮৪-২০২৬/২৫২১) অনুযায়ী আমরা গত ০৪/১০/২০২৬ খ্রি. তারিখে সশরীরে সিআইডি (সাইবার ইন্টেলিজেন্স এন্ড রিস্ক ম্যানেজমেন্ট, মালিবাগ, ঢাকা) কার্যালয়ে উপস্থিত হয়ে আমাদের লিখিত বক্তব্য ও ডোমেইন মেয়াদোত্তীর্ণ হওয়ার সকল দালিলিক প্রমাণাদি তদন্তকারী কর্মকর্তার নিকট জমা দিয়েছি।
            </p>
          </section>
        </div>

        <div class="mt-12 bg-amber-50 border border-amber-200 rounded-xl p-8 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-1.5 h-full bg-amber-500"></div>
          <p class="text-lg text-amber-900 font-bold mb-6 text-justify">
            দয়া করে কেউ mygovbd.com ওয়েবসাইটটিকে সরকারি পোর্টাল ভেবে প্রতারিত হবেন না এবং এর সাথে আমাদের প্রতিষ্ঠানকে জড়াবেন না। যেকোনো সরকারি সেবা বা সনদ যাচাইয়ের জন্য শুধুমাত্র বাংলাদেশ সরকারের অফিসিয়াল ডোমেইন (.gov.bd) ব্যবহার করুন।
          </p>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center border border-amber-200 text-[var(--color-brand-navy)] font-bold shadow-sm">
              AA
            </div>
            <div>
              <p class="font-bold text-slate-900 text-lg">— আনসার আহাম্মদ</p>
              <p class="text-slate-600 text-sm">স্বত্বাধিকারী, SoftDows (softdows.com)</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </Section>
</MainLayout>


