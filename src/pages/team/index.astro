---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { teamMembers } from '../../lib/db/schema/cms';
import { eq, asc } from 'drizzle-orm';

export const prerender = false;

const db = getDb((env as any).DB);
const allTeam = await db.select().from(teamMembers)
  .where(eq(teamMembers.isVisible, true))
  .orderBy(asc(teamMembers.displayOrder))
  .all();
---
<MainLayout title="Team" description="SoftDows Team">
  <Section variant="light" size="large" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6">Our Team</h1>
    </div>
  </Section>
  <Section variant="default" size="large">
    <div class="max-w-7xl mx-auto grid md:grid-cols-3 gap-8">
      {allTeam.map(t => (
        <a href={`/team/${t.slug}/`} class="block p-8 border rounded-3xl hover:shadow-xl text-center">
          {t.avatarKey ? <img src={t.avatarKey} alt={t.name} class="w-32 h-32 rounded-full mx-auto mb-6 object-cover" /> : <div class="w-32 h-32 bg-slate-200 rounded-full mx-auto mb-6 flex items-center justify-center text-2xl font-bold text-slate-500">{t.monogramFallback}</div>}
          <h3 class="text-xl font-bold">{t.name}</h3>
          <p class="text-[var(--color-brand-purple)]">{t.role}</p>
        </a>
      ))}
    </div>
  </Section>
</MainLayout>

