---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import { getPublishedTeam } from '../../lib/content/team';

const allTeam = getPublishedTeam();
---
<MainLayout title="Team | SoftDows" description="SoftDows Engineering Leadership and Team">
  <Section variant="light" size="large" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 text-[#192040]">Our Team</h1>
      <p class="text-slate-600 max-w-2xl mx-auto text-lg">Senior architects & technical leadership driving digital excellence.</p>
    </div>
  </Section>
  <Section variant="default" size="large">
    <div class="max-w-7xl mx-auto grid md:grid-cols-3 gap-8">
      {allTeam.map(t => (
        <a href={`/team/${t.slug}/`} class="group block p-8 border border-slate-200 rounded-3xl hover:shadow-xl hover:border-indigo-200 transition-all text-center bg-white">
          {t.photo ? (
            <img src={t.photo} alt={t.photoAlt || t.displayName} class="w-32 h-32 rounded-full mx-auto mb-6 object-cover border border-slate-200 shadow-sm group-hover:scale-105 transition-transform" />
          ) : (
            <div class="w-32 h-32 bg-slate-100 rounded-full mx-auto mb-6 flex items-center justify-center text-3xl font-bold text-slate-400 group-hover:bg-indigo-50 group-hover:text-indigo-400 transition-colors">
              {t.monogramFallback}
            </div>
          )}
          <h3 class="text-xl font-bold text-[#192040] group-hover:text-indigo-600 transition-colors">{t.displayName}</h3>
          <p class="text-indigo-500 font-medium text-sm mt-1">{t.role}</p>
        </a>
      ))}
    </div>
  </Section>
</MainLayout>


