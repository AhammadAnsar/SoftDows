---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Badge from '../../components/ui/Badge.astro';
import ConceptualVisual from '../../components/ui/ConceptualVisual.astro';
import { getPublishedTeam } from '../../lib/content/team';

const team = getPublishedTeam();
---
<MainLayout title="Team & Leadership | SoftDows" description="Meet the leadership and engineering team behind SoftDows.">
  <Section variant="light" size="large" class="pt-28 pb-20 md:pt-40 md:pb-32 bg-slate-50 border-b border-slate-100 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-100/50 via-transparent to-transparent opacity-70"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <Badge variant="primary" class="mb-6">Our People</Badge>
      <h1 class="mb-8 text-5xl md:text-6xl text-[var(--color-brand-navy)] font-bold tracking-tight leading-[1.05]">
        Leadership &amp; Team
      </h1>
      <p class="text-xl md:text-2xl font-light text-[var(--color-text-muted)] leading-relaxed">
        Meet the people behind SoftDows and the specialists contributing to our work.
      </p>
    </div>
  </Section>

  <Section variant="default" size="normal">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 max-w-7xl mx-auto">
      {team.map(member => (
        <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden hover:shadow-xl transition-shadow duration-300 flex flex-col">
          <div class="h-64 bg-slate-100 relative overflow-hidden flex items-center justify-center p-8">
             <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-slate-200 to-slate-100 opacity-50"></div>
             {member.photo ? (
                <img src={member.photo} alt={member.photoAlt || member.displayName} class="w-full h-full object-cover relative z-10 rounded-2xl shadow-md" />
             ) : (
                <ConceptualVisual concept="founder-monogram" name={member.displayName} class="w-full h-full rounded-2xl shadow-md relative z-10" />
             )}
          </div>
          <div class="p-8 flex flex-col flex-grow text-center">
            <h2 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-1">{member.displayName}</h2>
            <p class="text-[var(--color-brand-purple)] font-medium mb-4 uppercase tracking-wider text-sm">{member.role}</p>
            <p class="text-slate-600 mb-8 leading-relaxed flex-grow line-clamp-3">{member.shortBio}</p>
            
            <a href={`/team/${member.slug}/`} class="inline-flex items-center justify-center px-6 py-3 bg-slate-50 text-[var(--color-brand-navy)] font-semibold rounded-lg hover:bg-[var(--color-brand-purple)] hover:text-white transition-colors border border-slate-200 w-full">
              View Profile
            </a>
          </div>
        </div>
      ))}
    </div>
  </Section>
</MainLayout>

