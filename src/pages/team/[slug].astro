---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import ConceptualVisual from '../../components/ui/ConceptualVisual.astro';
import { teamData } from '../../lib/content/team';

export function getStaticPaths() {
  return Object.values(teamData).filter(m => m.publicVisibility && m.status === 'active').map(member => ({
    params: { slug: member.slug },
    props: { member },
  }));
}

const { member } = Astro.props;
---
<MainLayout title={member.seoTitle} description={member.seoDescription}>
  <Section variant="light" size="large" class="pt-28 pb-16 md:pt-32 md:pb-20 bg-slate-50 border-b border-slate-100">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center md:items-start gap-12">
      <div class="w-full md:w-1/3 max-w-sm">
        {member.photo ? (
          <img src={member.photo} alt={member.photoAlt || member.displayName} class="w-full aspect-square object-cover rounded-3xl shadow-xl" />
        ) : (
          <ConceptualVisual concept="founder-monogram" name={member.displayName} class="w-full aspect-square rounded-3xl shadow-xl" />
        )}
      </div>
      <div class="w-full md:w-2/3 text-center md:text-left pt-4">
        <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-brand-navy)] mb-2 tracking-tight">{member.displayName}</h1>
        <p class="text-xl text-[var(--color-brand-purple)] font-medium mb-8 uppercase tracking-wider">{member.role}</p>
        
        <div class="flex flex-wrap justify-center md:justify-start gap-3 mb-8">
          {member.expertise.map(exp => (
            <span class="px-4 py-2 bg-white border border-slate-200 rounded-full text-sm font-medium text-slate-700 shadow-sm">{exp}</span>
          ))}
        </div>

        {member.email && (
           <a href={`mailto:${member.email}`} class="inline-flex items-center text-[var(--color-brand-purple)] font-medium hover:underline mb-4">
             {member.email}
           </a>
        )}
      </div>
    </div>
  </Section>

  <Section variant="default" size="normal">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
      <div class="md:col-span-2 space-y-12">
        <!-- Biography -->
        <section>
          <h2 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-6">About</h2>
          <div class="prose prose-lg text-[var(--color-text-muted)] max-w-none font-light leading-relaxed">
            <p>{member.fullBio}</p>
          </div>
        </section>

        <!-- Experience -->
        {member.experience && member.experience.length > 0 && (
          <section>
            <h2 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-6">Experience</h2>
            <div class="space-y-8">
              {member.experience.map(exp => (
                <div class="border-l-2 border-slate-200 pl-6 relative">
                  <div class="absolute w-3 h-3 bg-white border-2 border-[var(--color-brand-purple)] rounded-full -left-[7px] top-2"></div>
                  <h3 class="text-xl font-bold text-slate-800">{exp.title}</h3>
                  <div class="flex flex-wrap gap-2 text-sm text-slate-500 font-medium mb-3 mt-1">
                    <span>{exp.company}</span>
                    <span>&bull;</span>
                    <span>{exp.period}</span>
                  </div>
                  {exp.description && <p class="text-slate-600 leading-relaxed">{exp.description}</p>}
                </div>
              ))}
            </div>
          </section>
        )}
      </div>

      <div class="space-y-10">
        <!-- Languages -->
        {member.languages && member.languages.length > 0 && (
          <section class="bg-slate-50 p-6 rounded-2xl border border-slate-100">
            <h3 class="text-lg font-bold text-[var(--color-brand-navy)] mb-4 uppercase tracking-wider text-sm">Languages</h3>
            <ul class="space-y-2 text-slate-700">
              {member.languages.map(lang => (
                <li class="flex items-center gap-2">
                  <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand-purple)]"></div>
                  {lang}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  </Section>
</MainLayout>

