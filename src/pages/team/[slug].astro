---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import { getPublishedTeam, teamData } from '../../lib/content/team';

export function getStaticPaths() {
  return getPublishedTeam().map(member => ({
    params: { slug: member.slug },
    props: { member }
  }));
}

const { member } = Astro.props;
---
export const prerender = true;
<MainLayout title={member.seoTitle || member.displayName} description={member.seoDescription || undefined}>
  <Section variant="light" size="large" class="pt-32 pb-24">
    <div class="max-w-3xl mx-auto text-center">
      {member.photo ? (
        <img src={member.photo} alt={member.photoAlt || member.displayName} class="w-48 h-48 rounded-full mx-auto mb-8 object-cover shadow-lg border-4 border-white" />
      ) : (
        <div class="w-48 h-48 bg-slate-100 rounded-full mx-auto mb-8 flex items-center justify-center text-5xl font-bold text-slate-400 border-4 border-white shadow-sm">
          {member.monogramFallback}
        </div>
      )}
      <h1 class="text-4xl md:text-6xl font-bold mb-4 text-[#192040]">{member.displayName}</h1>
      <p class="text-2xl text-indigo-600 mb-8">{member.role}</p>
      <p class="text-lg text-slate-600 leading-relaxed text-left max-w-2xl mx-auto">
        {member.fullBio}
      </p>
    </div>
  </Section>
</MainLayout>

