---
export const prerender = false;
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../lib/db';
import { getAuthorizedClientContext } from '../../../lib/portal/auth';
import { projects } from '../../../lib/db/schema/agency';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const db = getDb((env as any).DB);
const ctx = await getAuthorizedClientContext(db, user.id);
if (!ctx.authorized || !ctx.clientId) return Astro.redirect('/admin/access-denied');
const clientId = ctx.clientId;

const clientProjects = await db.select({
  id: projects.id,
  name: projects.name
}).from(projects).where(eq(projects.clientId, clientId));
---

<PortalLayout title="New Support Ticket" user={user}>
  <div class="mb-6">
    <div class="flex items-center text-sm text-slate-500 mb-2">
      <a href="/portal/support" class="hover:text-blue-600 transition-colors">Support</a>
      <span class="mx-2">/</span>
      <span class="text-slate-900">New Ticket</span>
    </div>
    <h1 class="text-2xl font-semibold text-slate-900">Create New Ticket</h1>
  </div>

  <div class="bg-white shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg max-w-3xl">
    <form id="new-ticket-form" class="p-6 space-y-6">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="subject" class="block text-sm font-medium text-slate-700">Subject *</label>
          <input type="text" name="subject" id="subject" required class="mt-1 block w-full rounded-md border border-slate-300 py-2 px-3 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 sm:text-sm" placeholder="Brief summary of the issue">
        </div>

        <div>
          <label for="category" class="block text-sm font-medium text-slate-700">Category *</label>
          <select id="category" name="category" required class="mt-1 block w-full rounded-md border border-slate-300 py-2 px-3 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 sm:text-sm bg-white">
            <option value="general">General Inquiry</option>
            <option value="technical">Technical Support</option>
            <option value="billing">Billing</option>
            <option value="feature_request">Feature Request</option>
            <option value="bug_report">Bug Report</option>
          </select>
        </div>

        <div>
          <label for="projectId" class="block text-sm font-medium text-slate-700">Related Project (Optional)</label>
          <select id="projectId" name="projectId" class="mt-1 block w-full rounded-md border border-slate-300 py-2 px-3 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 sm:text-sm bg-white">
            <option value="">None</option>
            {clientProjects.map((p: any) => (
              <option value={p.id}>{p.name}</option>
            ))}
          </select>
        </div>

        <div class="sm:col-span-2">
          <label for="description" class="block text-sm font-medium text-slate-700">Description *</label>
          <textarea id="description" name="description" rows="6" required class="mt-1 block w-full rounded-md border border-slate-300 py-2 px-3 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 sm:text-sm" placeholder="Please describe your issue in detail..."></textarea>
        </div>
      </div>

      <div class="flex justify-end space-x-3 border-t border-slate-200 pt-5">
        <a href="/portal/support" class="rounded-md border border-slate-300 bg-white py-2 px-4 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">Cancel</a>
        <button type="submit" id="submit-btn" class="inline-flex justify-center rounded-md border border-transparent bg-blue-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
          Submit Ticket
        </button>
      </div>
    </form>
  </div>

  <script>
    document.getElementById('new-ticket-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      
      const formData = new FormData(form);
      const data = {
        subject: formData.get('subject'),
        category: formData.get('category'),
        projectId: formData.get('projectId') || null,
        description: formData.get('description')
      };

      try {
        btn.disabled = true;
        btn.textContent = 'Submitting...';
        
        const res = await fetch('/api/portal/support/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (!res.ok) {
          const result = await res.json() as any;
          throw new Error(result.error || 'Failed to create ticket');
        }

        const result = await res.json() as any;
        window.location.href = `/portal/support/${result.ticketId}`;
      } catch (err: any) {
        alert(err.message);
        btn.disabled = false;
        btn.textContent = 'Submit Ticket';
      }
    });
  </script>
</PortalLayout>
