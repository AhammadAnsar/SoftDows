---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { getAuthorizedClientContext } from '../../lib/portal/auth';
import { eq, inArray, and, ne } from 'drizzle-orm';
import { projects } from '../../lib/db/schema/agency';
import { invoices } from '../../lib/db/schema/billing';
import { supportTickets } from '../../lib/db/schema/support';
import StatusBadge from '../../components/admin/StatusBadge.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const db = getDb((env as any).DB);
const ctx = await getAuthorizedClientContext(db, user.id);
if (!ctx.authorized || !ctx.clientId) {
  return Astro.redirect('/admin/access-denied');
}
const clientId = ctx.clientId;

function getProjectStatus(status: string): { label: string, variant: 'success' | 'warning' | 'neutral' | 'danger' | 'info' } {
  switch (status) {
    case 'planning': return { label: 'Planning', variant: 'neutral' };
    case 'active': return { label: 'Active', variant: 'success' };
    case 'on_hold': return { label: 'On Hold', variant: 'warning' };
    case 'completed': return { label: 'Completed', variant: 'info' };
    case 'cancelled': return { label: 'Cancelled', variant: 'danger' };
    default: return { label: status, variant: 'neutral' };
  }
}

function getInvoiceStatus(status: string): { label: string, variant: 'success' | 'warning' | 'neutral' | 'danger' | 'info' } {
  switch (status) {
    case 'draft': return { label: 'Draft', variant: 'neutral' };
    case 'issued': return { label: 'Issued', variant: 'info' };
    case 'partially_paid': return { label: 'Partially Paid', variant: 'warning' };
    case 'paid': return { label: 'Paid', variant: 'success' };
    case 'overdue': return { label: 'Overdue', variant: 'danger' };
    case 'cancelled': return { label: 'Cancelled', variant: 'neutral' };
    default: return { label: status, variant: 'neutral' };
  }
}

function getTicketStatus(status: string): { label: string, variant: 'success' | 'warning' | 'neutral' | 'danger' | 'info' } {
  switch (status) {
    case 'open': return { label: 'Open', variant: 'danger' };
    case 'in_progress': return { label: 'In Progress', variant: 'warning' };
    case 'waiting_for_client': return { label: 'Waiting', variant: 'info' };
    case 'resolved': return { label: 'Resolved', variant: 'success' };
    case 'closed': return { label: 'Closed', variant: 'neutral' };
    default: return { label: status, variant: 'neutral' };
  }
}

// Query active projects (status != completed and cancelled)
const activeProjects = await db.select()
  .from(projects)
  .where(
    and(
      eq(projects.clientId, clientId),
      ne(projects.status, 'completed'),
      ne(projects.status, 'cancelled')
    )
  )
  .orderBy(projects.createdAt)
  .limit(3);

// Query invoices (status in 'issued', 'partially_paid', 'overdue')
const pendingInvoices = await db.select()
  .from(invoices)
  .where(
    and(
      eq(invoices.clientId, clientId),
      inArray(invoices.status, ['issued', 'partially_paid', 'overdue'])
    )
  )
  .orderBy(invoices.dueDate)
  .limit(3);

// Query active support tickets (status != 'closed' and 'resolved')
const activeTickets = await db.select()
  .from(supportTickets)
  .where(
    and(
      eq(supportTickets.clientId, clientId),
      ne(supportTickets.status, 'closed'),
      ne(supportTickets.status, 'resolved')
    )
  )
  .orderBy(supportTickets.createdAt)
  .limit(3);
---
<PortalLayout title="Client Portal Dashboard" user={user} user={user}>
  <div class="px-4 sm:px-6 lg:px-8 py-8 max-w-7xl mx-auto">
    <div class="mb-8">
      <h1 class="text-2xl font-semibold text-gray-900">Welcome to Your Portal</h1>
      <p class="mt-2 text-sm text-gray-600">Here's an overview of your projects, billing, and support.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- Active Projects -->
      <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden flex flex-col">
        <div class="p-6 border-b border-[#e2e8f0] flex justify-between items-center">
          <h2 class="text-lg font-medium text-gray-900 flex items-center gap-2">
            <AdminIcon name="folder" class="w-5 h-5 text-gray-500" />
            Active Projects
          </h2>
          <a href="/portal/projects" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">View all</a>
        </div>
        <div class="flex-1 p-6">
          {activeProjects.length > 0 ? (
            <div class="space-y-4">
              {activeProjects.map((project: any) => {
                const s = getProjectStatus(project.status);
                return (
                <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg border border-gray-100">
                  <div>
                    <a href={`/portal/projects/${project.id}`} class="font-medium text-gray-900 hover:text-indigo-600">
                      {project.name}
                    </a>
                    {project.projectCode && <p class="text-xs text-gray-500 mt-1">{project.projectCode}</p>}
                  </div>
                  <StatusBadge label={s.label} variant={s.variant} />
                </div>
              )})}
            </div>
          ) : (
            <div class="h-full flex flex-col items-center justify-center py-8 text-center">
              <div class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mb-3">
                <AdminIcon name="folder" class="w-6 h-6 text-gray-400" />
              </div>
              <p class="text-sm font-medium text-gray-900">No active projects</p>
              <p class="text-sm text-gray-500 mt-1">You don't have any ongoing projects.</p>
            </div>
          )}
        </div>
      </div>

      <!-- Outstanding Invoices -->
      <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden flex flex-col">
        <div class="p-6 border-b border-[#e2e8f0] flex justify-between items-center">
          <h2 class="text-lg font-medium text-gray-900 flex items-center gap-2">
            <AdminIcon name="credit-card" class="w-5 h-5 text-gray-500" />
            Outstanding Invoices
          </h2>
          <a href="/portal/billing" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">View all</a>
        </div>
        <div class="flex-1 p-6">
          {pendingInvoices.length > 0 ? (
            <div class="space-y-4">
              {pendingInvoices.map((invoice: any) => {
                const s = getInvoiceStatus(invoice.status);
                return (
                <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg border border-gray-100">
                  <div>
                    <a href={`/portal/billing/${invoice.id}`} class="font-medium text-gray-900 hover:text-indigo-600">
                      {invoice.invoiceNumber}
                    </a>
                    <p class="text-xs text-gray-500 mt-1">Due {new Date(invoice.dueDate).toLocaleDateString()}</p>
                  </div>
                  <div class="flex flex-col items-end gap-2">
                    <span class="font-medium text-gray-900">
                      {new Intl.NumberFormat('en-US', { style: 'currency', currency: invoice.currency }).format(invoice.total / 100)}
                    </span>
                    <StatusBadge label={s.label} variant={s.variant} />
                  </div>
                </div>
              )})}
            </div>
          ) : (
            <div class="h-full flex flex-col items-center justify-center py-8 text-center">
              <div class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mb-3">
                <AdminIcon name="credit-card" class="w-6 h-6 text-gray-400" />
              </div>
              <p class="text-sm font-medium text-gray-900">All caught up!</p>
              <p class="text-sm text-gray-500 mt-1">You don't have any outstanding invoices.</p>
            </div>
          )}
        </div>
      </div>

      <!-- Active Support Tickets -->
      <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden flex flex-col lg:col-span-2">
        <div class="p-6 border-b border-[#e2e8f0] flex justify-between items-center">
          <h2 class="text-lg font-medium text-gray-900 flex items-center gap-2">
            <AdminIcon name="life-buoy" class="w-5 h-5 text-gray-500" />
            Recent Support Tickets
          </h2>
          <a href="/portal/support" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">View all</a>
        </div>
        <div class="flex-1 p-6">
          {activeTickets.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {activeTickets.map((ticket: any) => {
                const s = getTicketStatus(ticket.status);
                return (
                <div class="p-4 bg-gray-50 rounded-lg border border-gray-100 flex flex-col h-full">
                  <div class="flex justify-between items-start mb-2">
                    <StatusBadge label={s.label} variant={s.variant} />
                    <span class="text-xs text-gray-500">{new Date(ticket.createdAt).toLocaleDateString()}</span>
                  </div>
                  <a href={`/portal/support/${ticket.id}`} class="font-medium text-gray-900 hover:text-indigo-600 mb-1 line-clamp-1">
                    {ticket.subject}
                  </a>
                  <p class="text-xs text-gray-500 mb-3">{ticket.ticketNumber}</p>
                </div>
              )})}
            </div>
          ) : (
            <div class="flex flex-col items-center justify-center py-8 text-center">
              <div class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mb-3">
                <AdminIcon name="life-buoy" class="w-6 h-6 text-gray-400" />
              </div>
              <p class="text-sm font-medium text-gray-900">No active tickets</p>
              <p class="text-sm text-gray-500 mt-1">You don't have any open support requests.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</PortalLayout>
