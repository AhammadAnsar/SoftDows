---
export const prerender = false;
import PortalLayout from '../../../../layouts/PortalLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../../lib/db';
import { getAuthorizedClientContext } from '../../../../lib/portal/auth';
import { projects, projectMilestones } from '../../../../lib/db/schema/agency';
import { eq, and, asc } from 'drizzle-orm';
import StatusBadge from '../../../../components/admin/StatusBadge.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const db = getDb((env as any).DB);
const ctx = await getAuthorizedClientContext(db, user.id);
if (!ctx.authorized) return Astro.redirect('/admin/access-denied');

const { id } = Astro.params;
if (!id) return new Response('Not Found', { status: 404 });

const [project] = await db.select().from(projects).where(eq(projects.id, id)).limit(1);

if (!project) return new Response('Not Found', { status: 404 });
if (project.clientId !== ctx.clientId) return new Response('Not Found', { status: 404 });

const milestones = await db.select()
  .from(projectMilestones)
  .where(and(
    eq(projectMilestones.projectId, id),
    eq(projectMilestones.isVisibleToClient, true)
  ))
  .orderBy(asc(projectMilestones.displayOrder));

// Helper for status formatting
function getProjectStatusVariant(status: string) {
  switch(status) {
    case 'active': return 'success';
    case 'planning': return 'info';
    case 'on_hold': return 'warning';
    case 'completed': return 'success';
    case 'cancelled': return 'danger';
    default: return 'neutral';
  }
}

function getMilestoneStatusVariant(status: string) {
  switch(status) {
    case 'completed': return 'success';
    case 'active': return 'info';
    case 'pending': return 'neutral';
    case 'cancelled': return 'danger';
    default: return 'neutral';
  }
}

// format label
function formatStatus(status: string) {
  return status.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase());
}
---

<PortalLayout title={`Project: ${project.name}`} user={user} user={user}>
  <div class="px-4 sm:px-6 lg:px-8 py-8 max-w-5xl mx-auto">
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold text-slate-900">{project.name}</h1>
          <p class="mt-2 text-sm text-slate-600">
            {project.projectCode && <span class="font-medium">Code: {project.projectCode} &middot; </span>}
            {project.description || 'No description provided.'}
          </p>
        </div>
        <StatusBadge variant={getProjectStatusVariant(project.status) as any} label={formatStatus(project.status)} />
      </div>
    </div>

    <div class="mt-8">
      <h2 class="text-lg font-medium text-slate-900 mb-6">Milestones & Timeline</h2>
      
      {milestones.length === 0 ? (
        <div class="bg-white border border-slate-200 rounded-lg p-8 text-center text-slate-500">
          No milestones found for this project.
        </div>
      ) : (
        <div class="flow-root">
          <ul role="list" class="-mb-8">
            {milestones.map((milestone, milestoneIdx) => (
              <li>
                <div class="relative pb-8">
                  {milestoneIdx !== milestones.length - 1 ? (
                    <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-slate-200" aria-hidden="true" />
                  ) : null}
                  <div class="relative flex space-x-3">
                    <div>
                      <span class={`h-8 w-8 rounded-full flex items-center justify-center ring-8 ring-white ${milestone.status === 'completed' ? 'bg-green-500' : milestone.status === 'active' ? 'bg-blue-500' : 'bg-slate-200'}`}>
                        {milestone.status === 'completed' ? (
                          <svg class="h-5 w-5 text-white" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                          </svg>
                        ) : (
                           <div class="h-2.5 w-2.5 rounded-full bg-white" />
                        )}
                      </span>
                    </div>
                    <div class="flex min-w-0 flex-1 justify-between space-x-4 pt-1.5">
                      <div>
                        <p class="text-sm text-slate-900 font-medium">{milestone.title}</p>
                        {milestone.clientVisibleNote && (
                          <div class="mt-2 text-sm text-slate-600 bg-slate-50 p-3 rounded-md border border-slate-200">
                            <strong>Note:</strong> {milestone.clientVisibleNote}
                          </div>
                        )}
                      </div>
                      <div class="whitespace-nowrap text-right text-sm text-slate-500 flex flex-col items-end gap-1">
                        <StatusBadge variant={getMilestoneStatusVariant(milestone.status) as any} label={formatStatus(milestone.status)} />
                        {milestone.targetDate && (
                          <div class="text-xs mt-1">
                            Due: {new Date(milestone.targetDate).toLocaleDateString()}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</PortalLayout>
