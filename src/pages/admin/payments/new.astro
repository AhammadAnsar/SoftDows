---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db';
import { payments, invoices } from '../../../lib/db/schema/billing';
import { clients } from '../../../lib/db/schema/crm';
import { eq } from 'drizzle-orm';
import { requirePermission } from '../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';
import AdminIcon from '../../../components/admin/AdminIcon.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
requirePermission(user.role as any, 'payments', 'create');

const db = getDb((env as any).DB);
const allClients = await db.select().from(clients).orderBy(clients.name);
const allInvoices = await db.select().from(invoices).orderBy(invoices.invoiceNumber);

let errors: Record<string, string> = {};
let formData = {
  clientId: Astro.url.searchParams.get('clientId') || '',
  invoiceId: Astro.url.searchParams.get('invoiceId') || '',
  amount: '',
  currency: 'USD',
  paymentDate: new Date().toISOString().split('T')[0],
  paymentMethod: 'Bank Transfer',
  reference: '',
  notes: '',
  status: 'completed'
};

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    
    formData = {
      clientId: data.get('clientId')?.toString() || '',
      invoiceId: data.get('invoiceId')?.toString() || '',
      amount: data.get('amount')?.toString() || '',
      currency: data.get('currency')?.toString() || 'USD',
      paymentDate: data.get('paymentDate')?.toString() || new Date().toISOString().split('T')[0],
      paymentMethod: data.get('paymentMethod')?.toString() || 'Bank Transfer',
      reference: data.get('reference')?.toString() || '',
      notes: data.get('notes')?.toString() || '',
      status: data.get('status')?.toString() || 'completed'
    };

    if (!formData.clientId) errors.clientId = 'Client is required';
    if (!formData.amount || isNaN(parseFloat(formData.amount))) errors.amount = 'Valid amount is required';
    
    if (Object.keys(errors).length === 0) {
      await db.insert(payments).values({ id: crypto.randomUUID(),
        clientId: formData.clientId,
        invoiceId: formData.invoiceId,
        amount: Math.round(parseFloat(formData.amount) * 100),
        currency: formData.currency,
        paymentDate: new Date(formData.paymentDate),
        paymentMethod: formData.paymentMethod,
        reference: formData.reference,
        notes: formData.notes,
        status: formData.status as any,
        recordedById: user.id
      });
      return Astro.redirect('/admin/payments');
    }
  } catch (e: any) {
    errors.system = e.message;
  }
}
---
<AdminLayout title="New Payment" user={user as any}>
  <div class="p-6 max-w-3xl mx-auto">
    <div class="flex items-center gap-4 mb-6">
      <a href="/admin/payments" class="text-slate-400 hover:text-slate-600">
        <AdminIcon name="arrow-left" class="w-5 h-5" />
      </a>
      <h1 class="text-2xl font-bold">Record Payment</h1>
    </div>

    {errors.system && (
      <div class="bg-red-50 text-red-600 p-4 rounded-lg mb-6 border border-red-100">
        {errors.system}
      </div>
    )}

    <form method="POST" class="bg-white rounded-xl border border-slate-200 p-6 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Client *</label>
          <select name="clientId" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3] focus:border-[#5568d3]">
            <option value="">Select a client...</option>
            {allClients.map((c) => (
              <option value={c.id} selected={c.id === formData.clientId}>{c.name}</option>
            ))}
          </select>
          {errors.clientId && <p class="text-red-500 text-sm mt-1">{errors.clientId}</p>}
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Invoice *</label>
          <select name="invoiceId" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3] focus:border-[#5568d3]">
            <option value="">Select an invoice...</option>
            {allInvoices.map((inv) => (
              <option value={inv.id} selected={inv.id === formData.invoiceId}>{inv.invoiceNumber} (Due: {(inv.balanceDue / 100).toFixed(2)})</option>
            ))}
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Amount *</label>
          <div class="relative">
            <span class="absolute left-3 top-2.5 text-slate-500">$</span>
            <input type="number" step="0.01" name="amount" value={formData.amount} required placeholder="0.00" class="w-full pl-8 pr-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3] focus:border-[#5568d3]" />
          </div>
          {errors.amount && <p class="text-red-500 text-sm mt-1">{errors.amount}</p>}
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Currency</label>
          <select name="currency" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3] focus:border-[#5568d3]">
            <option value="USD" selected={formData.currency === 'USD'}>USD</option>
            <option value="BDT" selected={formData.currency === 'BDT'}>BDT</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Payment Date *</label>
          <input type="date" name="paymentDate" value={formData.paymentDate} required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3] focus:border-[#5568d3]" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Method *</label>
          <select name="paymentMethod" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3] focus:border-[#5568d3]">
            <option value="Bank Transfer" selected={formData.paymentMethod === 'Bank Transfer'}>Bank Transfer</option>
            <option value="Credit Card" selected={formData.paymentMethod === 'Credit Card'}>Credit Card</option>
            <option value="Stripe" selected={formData.paymentMethod === 'Stripe'}>Stripe</option>
            <option value="PayPal" selected={formData.paymentMethod === 'PayPal'}>PayPal</option>
            <option value="bKash" selected={formData.paymentMethod === 'bKash'}>bKash</option>
            <option value="Cash" selected={formData.paymentMethod === 'Cash'}>Cash</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Status *</label>
          <select name="status" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3] focus:border-[#5568d3]">
            <option value="completed" selected={formData.status === 'completed'}>Completed</option>
            <option value="pending" selected={formData.status === 'pending'}>Pending</option>
            <option value="failed" selected={formData.status === 'failed'}>Failed</option>
            <option value="refunded" selected={formData.status === 'refunded'}>Refunded</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Reference (Transaction ID)</label>
        <input type="text" name="reference" value={formData.reference} placeholder="e.g. TXN-987654321" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3] focus:border-[#5568d3]" />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Internal Notes</label>
        <textarea name="notes" rows="3" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3] focus:border-[#5568d3]">{formData.notes}</textarea>
      </div>

      <div class="flex justify-end gap-3 pt-6 border-t border-slate-100">
        <a href="/admin/payments" class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-lg font-medium transition-colors">Cancel</a>
        <button type="submit" class="px-4 py-2 bg-[#5568d3] text-white rounded-lg font-medium hover:bg-[#4557c2] transition-colors shadow-sm">
          Record Payment
        </button>
      </div>
    </form>
  </div>
</AdminLayout>



