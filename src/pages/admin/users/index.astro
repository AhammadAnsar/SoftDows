---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import type { BadgeVariant } from '../../../components/admin/StatusBadge.astro';
import { requirePermission } from '../../../lib/auth/authorization';
import type { AppRole } from '../../../lib/auth/permissions';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../lib/db';
import { user } from '../../../lib/db/schema/auth';
import { desc, like, eq, or, and } from 'drizzle-orm';
import type { SQL } from 'drizzle-orm';

const currentUser = Astro.locals.user;
if (!currentUser) return Astro.redirect('/login');
const role = currentUser.role as AppRole;

// Must have user:setRole permission (admin/super_admin only)
if (!requirePermission(role, 'user', 'setRole')) {
  return Astro.redirect('/admin/access-denied');
}

const db = getDb((env as any).DB);

const searchParams = Astro.url.searchParams;
const query = searchParams.get('q') || '';
const roleFilter = searchParams.get('role') || 'all';
const page = parseInt(searchParams.get('page') || '1') || 1;
const limit = 25;
const offset = (page - 1) * limit;

const filters: SQL[] = [];
if (roleFilter && roleFilter !== 'all') {
  filters.push(eq(user.role, roleFilter));
}
if (query) {
  const q = `%${query}%`;
  filters.push(or(like(user.name, q), like(user.email, q)) as SQL);
}

const where = filters.length > 0 ? and(...filters) : undefined;

const users = await db.select().from(user).where(where).orderBy(desc(user.createdAt)).limit(limit).offset(offset);

const roleColors: Record<string, BadgeVariant> = {
  super_admin: 'danger',
  admin: 'warning',
  finance: 'info',
  content_editor: 'info',
  support: 'neutral',
  client: 'neutral'
};

const formatRole = (r: string) => r?.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) || 'Unknown';

const roles = ['all', 'super_admin', 'admin', 'content_editor', 'finance', 'support', 'client'];
---
<AdminLayout title="Users & Staff" user={currentUser}>
  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
    <div>
      <h1 class="text-2xl font-bold text-[#242a56]">Users & Staff</h1>
      <p class="text-sm text-[#64748b]">Manage system users, staff roles, and access permissions</p>
    </div>
    <div class="flex items-center gap-3 w-full md:w-auto">
      <a href="#invite-section" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-[#6878d6] hover:bg-[#5665b9] text-white text-sm font-medium rounded-lg transition-colors shadow-sm w-full md:w-auto">
        <AdminIcon name="plus" class="w-4 h-4" />
        Invite User
      </a>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white p-4 rounded-xl shadow-sm border border-[#e2e8f0] mb-6 flex flex-col md:flex-row gap-4 justify-between items-center">
    <form class="flex w-full md:w-auto gap-2">
      <div class="relative flex-1 md:w-64">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <AdminIcon name="search" class="w-4 h-4" />
        </div>
        <input 
          type="search" 
          name="q" 
          value={query}
          placeholder="Search name or email..." 
          class="block w-full pl-9 pr-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]"
        />
      </div>
      <input type="hidden" name="role" value={roleFilter} />
      <button type="submit" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-lg transition-colors border border-slate-200">
        Search
      </button>
    </form>
    
    <div class="flex overflow-x-auto pb-1 md:pb-0 w-full md:w-auto hide-scrollbar gap-2">
      {roles.map(r => (
        <a 
          href={`?role=${r}${query ? `&q=${query}` : ''}`} 
          class={`whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-medium transition-colors border ${
            roleFilter === r 
              ? 'bg-[#eef0ff] text-[#6878d6] border-[#c7d0fa]' 
              : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50'
          }`}
        >
          {r === 'all' ? 'All Roles' : formatRole(r)}
        </a>
      ))}
    </div>
  </div>

  <!-- Desktop Table (Hidden on small screens) -->
  <div class="hidden md:block bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden mb-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-[#e2e8f0] text-xs uppercase tracking-wider text-slate-500 font-semibold">
            <th class="px-6 py-4">User</th>
            <th class="px-6 py-4">Role</th>
            <th class="px-6 py-4">Status</th>
            <th class="px-6 py-4">Created</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#e2e8f0]">
          {users.length === 0 ? (
            <tr>
              <td colspan="5" class="px-6 py-12 text-center">
                <AdminIcon name="users" class="w-12 h-12 text-slate-300 mx-auto mb-3" />
                <h3 class="text-sm font-medium text-slate-900">No users found</h3>
                <p class="text-sm text-slate-500 mt-1">Try adjusting your search or filters.</p>
              </td>
            </tr>
          ) : (
            users.map((u) => (
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center overflow-hidden border border-slate-200 flex-shrink-0">
                      {u.image ? (
                        <img src={u.image} alt={u.name} class="w-full h-full object-cover" />
                      ) : (
                        <span class="text-sm font-medium text-slate-500">{(u.name || 'U').charAt(0).toUpperCase()}</span>
                      )}
                    </div>
                    <div>
                      <div class="font-medium text-[#242a56]">{u.name}</div>
                      <div class="text-xs text-slate-500">{u.email}</div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <StatusBadge label={formatRole(u.role || '')} variant={roleColors[u.role || ''] || 'neutral'} />
                </td>
                <td class="px-6 py-4">
                  {u.banned ? (
                    <StatusBadge label="Banned" variant="danger" />
                  ) : (
                    <StatusBadge label="Active" variant="success" />
                  )}
                </td>
                <td class="px-6 py-4 text-sm text-slate-500">
                  {u.createdAt ? new Date(u.createdAt).toLocaleDateString() : 'Unknown'}
                </td>
                <td class="px-6 py-4 text-right">
                  <a href={`/admin/users/${u.id}`} class="inline-flex items-center justify-center p-2 text-slate-400 hover:text-[#6878d6] hover:bg-[#eef0ff] rounded-lg transition-colors">
                    <AdminIcon name="eye" class="w-4 h-4" />
                  </a>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile Cards (Hidden on md and up) -->
  <div class="md:hidden space-y-4 mb-6">
    {users.length === 0 ? (
      <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] p-8 text-center">
        <AdminIcon name="users" class="w-12 h-12 text-slate-300 mx-auto mb-3" />
        <h3 class="text-sm font-medium text-slate-900">No users found</h3>
      </div>
    ) : (
      users.map((u) => (
        <a href={`/admin/users/${u.id}`} class="block bg-white rounded-xl shadow-sm border border-[#e2e8f0] p-4 hover:border-[#c7d0fa] transition-colors">
          <div class="flex justify-between items-start mb-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center overflow-hidden border border-slate-200">
                {u.image ? (
                  <img src={u.image} alt={u.name} class="w-full h-full object-cover" />
                ) : (
                  <span class="text-sm font-medium text-slate-500">{(u.name || 'U').charAt(0).toUpperCase()}</span>
                )}
              </div>
              <div>
                <div class="font-medium text-[#242a56]">{u.name}</div>
                <div class="text-xs text-slate-500">{u.email}</div>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2 text-sm mt-4">
            <div class="bg-slate-50 p-2 rounded-lg flex flex-col gap-1">
              <span class="text-xs text-slate-500">Role</span>
              <StatusBadge label={formatRole(u.role || '')} variant={roleColors[u.role || ''] || 'neutral'} />
            </div>
            <div class="bg-slate-50 p-2 rounded-lg flex flex-col gap-1">
              <span class="text-xs text-slate-500">Status</span>
              {u.banned ? (
                <StatusBadge label="Banned" variant="danger" />
              ) : (
                <StatusBadge label="Active" variant="success" />
              )}
            </div>
          </div>
        </a>
      ))
    )}
  </div>

  <!-- Invite Section -->
  <div id="invite-section" class="mt-8 bg-white rounded-xl shadow-sm border border-[#e2e8f0] p-6 scroll-mt-24">
    <h2 class="text-lg font-bold text-[#242a56] mb-4">Invite Staff Member</h2>
    <form class="js-invite-form space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <input name="name" placeholder="Full Name" required class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" />
        <input name="email" type="email" placeholder="Email" required class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" />
        <select name="role" required class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]">
          <option value="">Select Role</option>
          <option value="admin">Admin</option>
          <option value="content_editor">Content Editor</option>
          <option value="finance">Finance</option>
          <option value="support">Support</option>
          {role === 'super_admin' && <option value="super_admin">Super Admin</option>}
        </select>
      </div>
      <button type="submit" class="inline-flex items-center justify-center px-4 py-2 bg-[#242a56] hover:bg-[#1a1e3e] text-white text-sm font-medium rounded-lg transition-colors">
        Create & Generate Invite
      </button>
      <p class="text-xs text-[#64748b]">A secure invitation will be generated. Email delivery is available in Phase 08.</p>
    </form>
  </div>
</AdminLayout>

<script>
  document.querySelector('.js-invite-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const body = Object.fromEntries(new FormData(f));
    const btn = f.querySelector('button[type="submit"]') as HTMLButtonElement;
    
    try {
      btn.disabled = true;
      btn.textContent = 'Inviting...';
      
      const res = await fetch('/api/admin/users/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();
      
      if (res.ok) {
        alert('Staff member created. Invite pending (email delivery in Phase 08).');
        window.location.reload();
      } else {
        alert((data as any).error || 'Failed to create user');
        btn.disabled = false;
        btn.textContent = 'Create & Generate Invite';
      }
    } catch (err) {
      alert('An error occurred. Please try again.');
      btn.disabled = false;
      btn.textContent = 'Create & Generate Invite';
    }
  });
</script>
