---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import StatusBadge from '../../../../components/admin/StatusBadge.astro';
import type { BadgeVariant } from '../../../../components/admin/StatusBadge.astro';
import { requirePermission, canManageRole } from '../../../../lib/auth/authorization';
import type { AppRole } from '../../../../lib/auth/permissions';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../../lib/db';
import { user } from '../../../../lib/db/schema/auth';
import { eq } from 'drizzle-orm';

const currentUser = Astro.locals.user;
if (!currentUser) return Astro.redirect('/login');
const currentRole = currentUser.role as AppRole;

// Must have basic view or manage permission
if (!requirePermission(currentRole, 'user', 'setRole')) {
  return Astro.redirect('/admin/access-denied');
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/users');

const db = getDb((env as any).DB);
const [targetUser] = await db.select().from(user).where(eq(user.id, id));

if (!targetUser) return Astro.redirect('/admin/users');

const formatRole = (r: string) => r?.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) || 'Unknown';
const userRole = targetUser.role as AppRole;
const targetCanBeManaged = canManageRole(currentRole, userRole);
const isSelf = currentUser.id === targetUser.id;

const roleColors: Record<string, BadgeVariant> = {
  super_admin: 'danger',
  admin: 'warning',
  finance: 'info',
  content_editor: 'info',
  support: 'neutral',
  client: 'neutral'
};
---
<AdminLayout title={`User Details: ${targetUser.name}`} user={currentUser}>
  <!-- Header & Back Link -->
  <div class="mb-6">
    <a href="/admin/users" class="inline-flex items-center text-sm text-[#64748b] hover:text-[#6878d6] transition-colors mb-4">
      <AdminIcon name="arrow-left" class="w-4 h-4 mr-1" />
      Back to Users
    </a>
    <h1 class="text-2xl font-bold text-[#242a56]">User Details</h1>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Profile Card -->
    <div class="lg:col-span-1 space-y-6">
      <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] p-6 text-center">
        <div class="w-24 h-24 mx-auto rounded-full bg-slate-100 flex items-center justify-center overflow-hidden border-2 border-white shadow-sm mb-4">
          {targetUser.image ? (
            <img src={targetUser.image} alt={targetUser.name} class="w-full h-full object-cover" />
          ) : (
            <span class="text-3xl font-medium text-slate-400">{(targetUser.name || 'U').charAt(0).toUpperCase()}</span>
          )}
        </div>
        <h2 class="text-xl font-bold text-[#242a56] mb-1">{targetUser.name}</h2>
        <p class="text-sm text-[#64748b] mb-4">{targetUser.email}</p>
        
        <div class="flex flex-wrap justify-center gap-2 mb-6">
          <StatusBadge label={formatRole(targetUser.role || '')} variant={roleColors[targetUser.role || ''] || 'neutral'} />
          {targetUser.banned ? (
            <StatusBadge label="Banned" variant="danger" />
          ) : (
            <StatusBadge label="Active" variant="success" />
          )}
        </div>

        <div class="text-left border-t border-[#e2e8f0] pt-4 mt-4 space-y-3">
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-500">User ID</span>
            <span class="font-mono text-slate-700 truncate ml-4" title={targetUser.id}>{targetUser.id.substring(0, 12)}...</span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-500">Created</span>
            <span class="text-slate-700">{targetUser.createdAt ? new Date(targetUser.createdAt).toLocaleDateString() : 'N/A'}</span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-500">Last Updated</span>
            <span class="text-slate-700">{targetUser.updatedAt ? new Date(targetUser.updatedAt).toLocaleDateString() : 'N/A'}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions Cards -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- Role Management -->
      <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
        <div class="p-5 border-b border-[#e2e8f0] bg-slate-50">
          <h3 class="text-[#242a56] font-semibold flex items-center gap-2">
            <AdminIcon name="shield" class="w-4 h-4 text-[#6878d6]" />
            Role Management
          </h3>
        </div>
        <div class="p-6">
          <p class="text-sm text-slate-600 mb-4">Change this user's role and permission level.</p>
          
          <form id="role-form" class="flex flex-col sm:flex-row gap-3 items-start" data-userid={targetUser.id}>
            <div class="w-full sm:max-w-xs">
              <select 
                name="newRole" 
                class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6] disabled:bg-slate-100 disabled:text-slate-500"
                disabled={!targetCanBeManaged || isSelf}
              >
                <option value="client" selected={targetUser.role === 'client'}>Client</option>
                <option value="support" selected={targetUser.role === 'support'}>Support</option>
                <option value="content_editor" selected={targetUser.role === 'content_editor'}>Content Editor</option>
                <option value="finance" selected={targetUser.role === 'finance'}>Finance</option>
                {currentRole === 'super_admin' && <option value="admin" selected={targetUser.role === 'admin'}>Admin</option>}
                {currentRole === 'super_admin' && <option value="super_admin" selected={targetUser.role === 'super_admin'} >Super Admin</option>}
              </select>
            </div>
            <button 
              type="submit" 
              class="inline-flex items-center justify-center px-4 py-2 bg-[#242a56] hover:bg-[#1a1e3e] text-white text-sm font-medium rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
              disabled={!targetCanBeManaged || isSelf}
            >
              Update Role
            </button>
          </form>
          {isSelf && <p class="text-xs text-orange-500 mt-2">You cannot change your own role.</p>}
          {!targetCanBeManaged && !isSelf && <p class="text-xs text-red-500 mt-2">You do not have permission to manage this role level.</p>}
        </div>
      </div>

      <!-- Account Status -->
      <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
        <div class="p-5 border-b border-[#e2e8f0] bg-slate-50">
          <h3 class="text-[#242a56] font-semibold flex items-center gap-2">
            <AdminIcon name="lock" class="w-4 h-4 text-[#6878d6]" />
            Account Status
          </h3>
        </div>
        <div class="p-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div>
            <h4 class="font-medium text-slate-800 text-sm mb-1">{targetUser.banned ? 'Account is Suspended' : 'Account is Active'}</h4>
            <p class="text-sm text-slate-600">
              {targetUser.banned 
                ? 'This user is currently prevented from logging in or using the system.' 
                : 'This user can log in and use the system normally.'}
            </p>
          </div>
          <button 
            id="status-btn"
            data-userid={targetUser.id}
            data-action={targetUser.banned ? 'unban' : 'ban'}
            class={`whitespace-nowrap inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed ${
              targetUser.banned 
                ? 'bg-green-100 text-green-700 hover:bg-green-200' 
                : 'bg-red-100 text-red-700 hover:bg-red-200'
            }`}
            disabled={!targetCanBeManaged || isSelf}
          >
            {targetUser.banned ? 'Reactivate Account' : 'Deactivate Account'}
          </button>
        </div>
        {isSelf && <div class="px-6 pb-4"><p class="text-xs text-orange-500">You cannot change your own account status.</p></div>}
      </div>

      <!-- Session Management -->
      <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
        <div class="p-5 border-b border-[#e2e8f0] bg-slate-50">
          <h3 class="text-[#242a56] font-semibold flex items-center gap-2">
            <AdminIcon name="log-out" class="w-4 h-4 text-[#6878d6]" />
            Session Management
          </h3>
        </div>
        <div class="p-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div>
            <h4 class="font-medium text-slate-800 text-sm mb-1">Revoke Active Sessions</h4>
            <p class="text-sm text-slate-600">Instantly sign out this user from all devices.</p>
          </div>
          <button 
            id="revoke-btn"
            data-userid={targetUser.id}
            class="whitespace-nowrap inline-flex items-center justify-center px-4 py-2 bg-slate-100 text-slate-700 hover:bg-slate-200 text-sm font-medium rounded-lg transition-colors border border-slate-300 disabled:opacity-50 disabled:cursor-not-allowed"
            disabled={!targetCanBeManaged}
          >
            Revoke All Sessions
          </button>
        </div>
      </div>

    </div>
  </div>
</AdminLayout>

<script>
  // Role Management
  const roleForm = document.getElementById('role-form') as HTMLFormElement;
  roleForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const userId = roleForm.dataset.userid;
    const formData = new FormData(roleForm);
    const newRole = formData.get('newRole');
    
    if (!confirm(`Are you sure you want to change this user's role to ${newRole}?`)) return;
    
    const btn = roleForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    
    try {
      const res = await fetch(`/api/admin/users/${userId}/role`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role: newRole })
      });
      
      const data = await res.json();
      if (res.ok) {
        alert('Role updated successfully.');
        window.location.reload();
      } else {
        alert((data as any).error || 'Error');
        btn.disabled = false;
      }
    } catch (err) {
      alert('An error occurred.');
      btn.disabled = false;
    }
  });

  // Status Management
  const statusBtn = document.getElementById('status-btn') as HTMLButtonElement;
  statusBtn?.addEventListener('click', async () => {
    const userId = statusBtn.dataset.userid;
    const action = statusBtn.dataset.action;
    const actionText = action === 'ban' ? 'deactivate' : 'reactivate';
    
    if (!confirm(`Are you sure you want to ${actionText} this account?`)) return;
    
    statusBtn.disabled = true;
    
    try {
      const res = await fetch(`/api/admin/users/${userId}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action })
      });
      
      const data = await res.json();
      if (res.ok) {
        alert(`Account ${actionText}d successfully.`);
        window.location.reload();
      } else {
        alert((data as any).error || 'Error');
        statusBtn.disabled = false;
      }
    } catch (err) {
      alert('An error occurred.');
      statusBtn.disabled = false;
    }
  });

  // Session Management
  const revokeBtn = document.getElementById('revoke-btn') as HTMLButtonElement;
  revokeBtn?.addEventListener('click', async () => {
    const userId = revokeBtn.dataset.userid;
    
    if (!confirm('Are you sure you want to revoke all sessions for this user? They will be immediately logged out.')) return;
    
    revokeBtn.disabled = true;
    
    try {
      const res = await fetch(`/api/admin/users/${userId}/revoke-sessions`, {
        method: 'POST'
      });
      
      const data = await res.json();
      if (res.ok) {
        alert('Sessions revoked successfully.');
        window.location.reload();
      } else {
        alert((data as any).error || 'Error');
        revokeBtn.disabled = false;
      }
    } catch (err) {
      alert('An error occurred.');
      revokeBtn.disabled = false;
    }
  });
</script>
