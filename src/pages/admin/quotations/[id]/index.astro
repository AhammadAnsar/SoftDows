---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../lib/db';
import { quotations, quotationItems } from '../../../../lib/db/schema/billing';
import { clients, leads } from '../../../../lib/db/schema/crm';
import { projects } from '../../../../lib/db/schema/agency';
import { eq } from 'drizzle-orm';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
requirePermission(user.role as any, 'quotations', 'read');

const { id } = Astro.params;
const db = getDb((env as any).DB);

const quotationResult = await db.select({
  id: quotations.id,
  quotationNumber: quotations.quotationNumber,
  currency: quotations.currency,
  issueDate: quotations.issueDate,
  expiryDate: quotations.expiryDate,
  status: quotations.status,
  subtotal: quotations.subtotal,
  discount: quotations.discount,
  tax: quotations.tax,
  total: quotations.total,
  notes: quotations.notes,
  terms: quotations.terms,
  clientName: clients.name,
  leadName: leads.name,
  projectName: projects.name,
}).from(quotations)
  .leftJoin(clients, eq(quotations.clientId, clients.id))
  .leftJoin(leads, eq(quotations.leadId, leads.id))
  .leftJoin(projects, eq(quotations.projectId, projects.id))
  .where(eq(quotations.id, id as string));

const quotation = quotationResult[0];

if (!quotation) {
  return Astro.redirect('/admin/quotations');
}

const items = await db.select().from(quotationItems).where(eq(quotationItems.quotationId, id as string)).orderBy(quotationItems.displayOrder);
---
<AdminLayout title={`Quotation ${quotation.quotationNumber}`} user={user as any}>
  <div class="p-6 max-w-4xl mx-auto">
    <div class="flex items-center gap-4 mb-6">
      <a href="/admin/quotations" class="text-slate-400 hover:text-slate-600">
        <AdminIcon name="arrow-left" class="w-5 h-5" />
      </a>
      <h1 class="text-2xl font-bold">Quotation {quotation.quotationNumber}</h1>
      <div class="ml-auto flex items-center gap-3">
        <a href={`/admin/quotations/${quotation.id}/pdf`} target="_blank" class="px-4 py-2 bg-indigo-50 border border-indigo-200 text-indigo-700 rounded-lg font-medium hover:bg-indigo-100 transition-colors inline-flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
          Download PDF
        </a>
        <a href={`/admin/invoices/new?quotationId=${quotation.id}&clientId=${quotation.clientId || ''}&projectId=${quotation.projectId || ''}`} class="px-4 py-2 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-lg font-medium hover:bg-emerald-100 transition-colors inline-flex items-center gap-2">
          Convert to Invoice
        </a>
        <a href={`/admin/quotations/${quotation.id}/edit`} class="px-4 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg font-medium hover:bg-slate-50 transition-colors">Edit</a>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden mb-6">
      <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Client</h3>
          <p class="text-base font-medium text-slate-900">{quotation.clientName || 'N/A'}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Lead</h3>
          <p class="text-base font-medium text-slate-900">{quotation.leadName || 'N/A'}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Project</h3>
          <p class="text-base font-medium text-slate-900">{quotation.projectName || 'N/A'}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Status</h3>
          <p class="text-base font-medium text-slate-900 capitalize">{quotation.status}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Issue Date</h3>
          <p class="text-base font-medium text-slate-900">{new Date(quotation.issueDate).toLocaleDateString()}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Expiry Date</h3>
          <p class="text-base font-medium text-slate-900">{quotation.expiryDate ? new Date(quotation.expiryDate).toLocaleDateString() : 'N/A'}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Notes</h3>
          <p class="text-base text-slate-700 whitespace-pre-wrap">{quotation.notes || '-'}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Terms</h3>
          <p class="text-base text-slate-700 whitespace-pre-wrap">{quotation.terms || '-'}</p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <div class="p-6">
        <h3 class="text-lg font-medium mb-4">Quotation Items</h3>
        <table class="w-full text-left mb-6">
          <thead class="bg-slate-50 border-y border-slate-200 text-sm">
            <tr>
              <th class="py-3 px-4">Description</th>
              <th class="py-3 px-4 text-right">Qty</th>
              <th class="py-3 px-4 text-right">Price</th>
              <th class="py-3 px-4 text-right">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {items.map(item => (
              <tr>
                <td class="py-3 px-4">{item.description}</td>
                <td class="py-3 px-4 text-right">{item.quantity}</td>
                <td class="py-3 px-4 text-right">{(item.unitPrice / 100).toFixed(2)}</td>
                <td class="py-3 px-4 text-right font-medium">{(item.lineTotal / 100).toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="flex justify-end">
          <div class="w-64 space-y-3 text-sm">
            <div class="flex justify-between text-slate-600">
              <span>Subtotal</span>
              <span>{(quotation.subtotal / 100).toFixed(2)} {quotation.currency}</span>
            </div>
            {quotation.discount > 0 && (
              <div class="flex justify-between text-red-600">
                <span>Discount</span>
                <span>-{(quotation.discount / 100).toFixed(2)} {quotation.currency}</span>
              </div>
            )}
            {quotation.tax > 0 && (
              <div class="flex justify-between text-slate-600">
                <span>Tax</span>
                <span>{(quotation.tax / 100).toFixed(2)} {quotation.currency}</span>
              </div>
            )}
            <div class="flex justify-between font-bold text-lg pt-3 border-t border-slate-200 text-slate-900">
              <span>Total</span>
              <span>{(quotation.total / 100).toFixed(2)} {quotation.currency}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
