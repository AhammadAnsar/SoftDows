---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../lib/db';
import { leads } from '../../../../lib/db/schema/crm';
import { auditLogs } from '../../../../lib/db/schema/audit';
import { eq } from 'drizzle-orm';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
requirePermission(user.role as any, 'leads', 'read');

const db = getDb((env as any).DB);
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/leads');
}

// Fetch Lead initial state for audit log comparison
const lead = await db.select().from(leads).where(eq(leads.id, id)).get();
if (!lead) {
  return Astro.redirect('/admin/leads');
}

let successMessage = '';
let errorMessage = '';

// Handle Updates
if (Astro.request.method === 'POST') {
  // Must have update permission to POST
  requirePermission(user.role as any, 'leads', 'update');

  try {
    const data = await Astro.request.formData();
    const newStatus = data.get('status')?.toString();
    const internalNotes = data.get('internalNotes')?.toString() || '';

    const allowedStatuses = ['new', 'contacted', 'qualified', 'proposal_sent', 'won', 'lost', 'spam'];
    
    if (newStatus && allowedStatuses.includes(newStatus)) {
      await db.update(leads)
        .set({
          status: newStatus as any,
          internalNotes: internalNotes,
          updatedAt: new Date()
        })
        .where(eq(leads.id, id));
      
      if (newStatus !== lead.status) {
        // Audit log for status change
        await db.insert(auditLogs).values({
          id: crypto.randomUUID(),
          action: 'lead_status_changed',
          entityType: 'lead',
          entityId: id,
          actorId: user.id,
          details: {
            previous_status: lead.status,
            new_status: newStatus
          }
        });
      }

      // Refresh lead data for the current view
      lead.status = newStatus as any;
      lead.internalNotes = internalNotes;

      successMessage = 'Lead updated successfully.';
    } else {
      errorMessage = 'Invalid status selected.';
    }
  } catch (err) {
    console.error('Failed to update lead:', err);
    errorMessage = 'An error occurred while updating the lead.';
  }
}

const statusColors: Record<string, string> = {
  new: 'bg-blue-50 text-blue-700 border-blue-200',
  contacted: 'bg-yellow-50 text-yellow-700 border-yellow-200',
  qualified: 'bg-purple-50 text-purple-700 border-purple-200',
  proposal_sent: 'bg-indigo-50 text-indigo-700 border-indigo-200',
  won: 'bg-green-50 text-green-700 border-green-200',
  lost: 'bg-slate-100 text-slate-600 border-slate-200',
  spam: 'bg-red-50 text-red-700 border-red-200'
};

const formatStatus = (s: string) => s.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
---

<AdminLayout title={`Lead: ${lead.name}`} user={user}>
  <div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <a href="/admin/leads" class="inline-flex items-center text-sm font-medium text-[#64748b] hover:text-[#242a56] transition-colors mb-2">
          <AdminIcon name="chevron-left" class="w-4 h-4 mr-1" />
          Back to Leads
        </a>
        <h1 class="text-2xl font-bold text-[#242a56] flex items-center gap-3">
          {lead.name}
          <span class={`text-xs px-2.5 py-1 rounded-full border ${statusColors[lead.status] || statusColors['new']}`}>
            {formatStatus(lead.status)}
          </span>
        </h1>
        <p class="mt-1 text-sm text-[#64748b]">
          Submitted on {lead.createdAt ? new Date(lead.createdAt).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : 'Not provided'}
        </p>
      </div>
      <div>
        {lead.convertedClientId ? (
          <a href={`/admin/clients/${lead.convertedClientId}`} class="inline-flex items-center px-4 py-2 bg-green-50 text-green-700 font-medium rounded-lg text-sm hover:bg-green-100 transition-colors">
            <AdminIcon name="check" class="w-4 h-4 mr-2" />
            View Linked Client
          </a>
        ) : requirePermission(user.role as any, 'clients', 'create') ? (
          <a href={`/admin/leads/${lead.id}/convert`} class="inline-flex items-center px-4 py-2 bg-[#6878d6] hover:bg-[#5263ca] text-white font-medium rounded-lg text-sm transition-colors shadow-sm">
            Convert to Client
          </a>
        ) : null}
      </div>
    </div>

    {successMessage && (
      <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700 font-medium text-sm flex items-center gap-2">
        <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        {successMessage}
      </div>
    )}

    {errorMessage && (
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-600 font-medium text-sm">
        {errorMessage}
      </div>
    )}

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 lg:gap-8">
      
      <div class="xl:col-span-2 space-y-6 lg:space-y-8">
        <!-- Contact Details -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
            <h2 class="text-base font-bold text-[#242a56]">Contact Details</h2>
          </div>
          <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Full Name</p>
              <p class="text-sm text-[#242a56] font-medium">{lead.name}</p>
            </div>
            <div>
              <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Company / Org</p>
              <p class="text-sm text-[#242a56] font-medium">{lead.company || <span class="text-slate-400 italic">Not provided</span>}</p>
            </div>
            <div>
              <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Email</p>
              <a href={`mailto:${lead.email}`} class="text-sm text-[#6878d6] font-medium hover:underline">{lead.email}</a>
            </div>
            <div>
              <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Phone</p>
              {lead.phone ? (
                <a href={`tel:${lead.phone}`} class="text-sm text-[#6878d6] font-medium hover:underline">{lead.phone}</a>
              ) : (
                <span class="text-sm text-slate-400 italic">Not provided</span>
              )}
            </div>
          </div>
        </div>

        <!-- Project Request -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
            <h2 class="text-base font-bold text-[#242a56]">Project Request</h2>
          </div>
          <div class="p-6 space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Requested Service</p>
                <p class="text-sm text-[#242a56] font-medium">{lead.requestedService || 'Not specified'}</p>
              </div>
              <div>
                <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Estimated Budget</p>
                <p class="text-sm text-[#242a56] font-medium">{lead.budgetRange || <span class="text-slate-400 italic">Not specified</span>}</p>
              </div>
            </div>
            <div>
              <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-2">Project Details</p>
              <div class="text-sm text-[#334155] whitespace-pre-wrap bg-slate-50 p-4 rounded-lg border border-slate-100">{lead.description || 'No description provided.'}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Lead Management Form (Sidebar) -->
      <div class="space-y-6 lg:space-y-8">
        <form method="POST" class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
            <h2 class="text-base font-bold text-[#242a56]">Lead Management</h2>
          </div>
          <div class="p-6 space-y-5">
            
            <div>
              <label for="status" class="block text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-2">Update Status</label>
              <select 
                id="status" 
                name="status"
                class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6] bg-white appearance-none font-medium text-slate-700"
              >
                <option value="new" selected={lead.status === 'new'}>New</option>
                <option value="contacted" selected={lead.status === 'contacted'}>Contacted</option>
                <option value="qualified" selected={lead.status === 'qualified'}>Qualified</option>
                <option value="proposal_sent" selected={lead.status === 'proposal_sent'}>Proposal Sent</option>
                <option value="won" selected={lead.status === 'won'}>Won</option>
                <option value="lost" selected={lead.status === 'lost'}>Lost</option>
                <option value="spam" selected={lead.status === 'spam'}>Spam</option>
              </select>
            </div>

            <div>
              <label for="internalNotes" class="block text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-2">Internal Notes (Private)</label>
              <textarea 
                id="internalNotes" 
                name="internalNotes" 
                rows="6"
                class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6] bg-white resize-y"
                placeholder="Staff notes go here..."
              >{lead.internalNotes || ''}</textarea>
            </div>

            <button type="submit" class="w-full inline-flex items-center justify-center px-4 py-2.5 bg-[#242a56] hover:bg-[#1a1e3e] text-white text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#242a56]">
              Save Changes
            </button>
            
          </div>
        </form>
      </div>
      
    </div>
  </div>
</AdminLayout>


