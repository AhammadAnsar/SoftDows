---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../lib/db';
import { leads, clients, clientContacts } from '../../../../lib/db/schema/crm';
import { auditLogs } from '../../../../lib/db/schema/audit';
import { eq, ne } from 'drizzle-orm';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

// Needs both lead update and client create permissions
requirePermission(user.role as any, 'leads', 'update');
requirePermission(user.role as any, 'clients', 'create');

const db = getDb((env as any).DB);
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/leads');
}

const leadResult = await db.select().from(leads).where(eq(leads.id, id)).limit(1);
const lead = leadResult[0];

if (!lead) {
  return new Response('Lead not found', { status: 404 });
}

if (lead.convertedClientId) {
  // Already converted
  return Astro.redirect(`/admin/leads/${lead.id}`);
}

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const actionType = data.get('actionType')?.toString();

      if (actionType === 'create_new') {
      const clientName = data.get('clientName')?.toString().trim();
      const contactFirstName = data.get('contactFirstName')?.toString().trim();
      const contactLastName = data.get('contactLastName')?.toString().trim();
      const contactEmail = data.get('contactEmail')?.toString().trim();
      const contactPhone = data.get('contactPhone')?.toString().trim();

      if (!clientName || !contactFirstName || (!contactEmail && !contactPhone)) {
        errorMessage = 'Business name, contact name, and at least one contact method (email or phone) are required.';
      } else {
        // Safe lock: Read-before-write to ensure lead hasn't been converted
        const freshLead = await db.select().from(leads).where(eq(leads.id, lead.id)).limit(1);
        if (freshLead[0].convertedClientId) {
          errorMessage = 'This lead has already been converted.';
        } else {
          const clientId = crypto.randomUUID();
          const contactId = crypto.randomUUID();
          const auditId = crypto.randomUUID();

          // 2. Transaction via batch
          await db.batch([
            db.insert(clients).values({
              id: clientId,
              name: clientName,
            status: 'active'
          }),
          db.insert(clientContacts).values({
            id: contactId,
            clientId: clientId,
            firstName: contactFirstName,
            lastName: contactLastName,
            email: contactEmail,
            phone: contactPhone || null,
            isPrimary: true
          }),
          db.update(leads)
            .set({ convertedClientId: clientId })
            .where(eq(leads.id, lead.id)),
          db.insert(auditLogs).values({
            id: auditId,
            action: 'lead_converted_to_client',
            entityType: 'client',
            entityId: clientId,
            actorId: user.id,
            details: {
              leadId: lead.id,
              clientName,
              action: 'created_new_client'
            }
          })
        ]);

        return Astro.redirect(`/admin/clients/${clientId}`);
        }
      }
    } else if (actionType === 'link_existing') {
      const existingClientId = data.get('existingClientId')?.toString();
      
      if (!existingClientId) {
        errorMessage = 'Please select a client to link.';
      } else {
        // Safe lock: Read-before-write to ensure lead hasn't been converted
        const freshLead = await db.select().from(leads).where(eq(leads.id, lead.id)).limit(1);
        if (freshLead[0].convertedClientId) {
          errorMessage = 'This lead has already been converted.';
        } else {
          // Validate client exists and is not archived
          const clientCheck = await db.select().from(clients).where(eq(clients.id, existingClientId)).limit(1);
          if (clientCheck.length === 0) {
            errorMessage = 'The selected client does not exist.';
          } else if (clientCheck[0].status === 'archived') {
            errorMessage = 'Cannot link to an archived client.';
          } else {
          const auditId = crypto.randomUUID();

          await db.batch([
            db.update(leads)
              .set({ convertedClientId: existingClientId })
              .where(eq(leads.id, lead.id)),
            db.insert(auditLogs).values({
              id: auditId,
              action: 'lead_linked_to_existing_client',
              entityType: 'client',
              entityId: existingClientId,
              actorId: user.id,
              details: {
                leadId: lead.id,
                clientName: clientCheck[0].name,
                action: 'linked_existing_client'
              }
            })
          ]);

          return Astro.redirect(`/admin/clients/${existingClientId}`);
          }
        }
      }
    }
  } catch (error: any) {
    console.error('Error converting lead:', error);
    errorMessage = 'An error occurred during conversion. Please try again.';
  }
}

// Fetch active & inactive clients for linking
const availableClients = await db.select({
  id: clients.id,
  name: clients.name,
  status: clients.status
}).from(clients).where(ne(clients.status, 'archived')).orderBy(clients.name);

// Map lead name directly to first name (representing full name if no distinct last name)
const leadFullName = lead.name.trim();

---

<AdminLayout title="Convert to Client" user={user}>
  <div class="p-4 sm:p-6 lg:p-8 max-w-4xl mx-auto">
    
    <div class="mb-8">
      <a href={`/admin/leads/${lead.id}`} class="inline-flex items-center text-sm font-medium text-[#64748b] hover:text-[#242a56] transition-colors mb-2">
        <AdminIcon name="chevron-left" class="w-4 h-4 mr-1" />
        Back to Lead
      </a>
      <h1 class="text-2xl font-bold text-[#242a56]">Convert to Client</h1>
      <p class="mt-1 text-sm text-[#64748b]">
        Convert lead <strong>{lead.name}</strong> to a new or existing client.
      </p>
    </div>

    {errorMessage && (
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-600 font-medium text-sm">
        {errorMessage}
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Create New Client -->
      <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
        <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
          <h2 class="text-base font-bold text-[#242a56]">Create New Client</h2>
        </div>
        <form method="POST" class="p-6 space-y-5">
          <input type="hidden" name="actionType" value="create_new" />
          
          <div>
            <label class="block text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-2">Business / Client Name <span class="text-red-500">*</span></label>
            <input 
              type="text" 
              name="clientName" 
              value={lead.company || lead.name}
              required
              class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]"
            />
          </div>

          <div class="pt-4 border-t border-slate-100">
            <h3 class="text-sm font-bold text-[#242a56] mb-4">Primary Contact</h3>
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div>
                <label class="block text-xs font-bold text-slate-500 mb-1.5">First Name <span class="text-red-500">*</span></label>
                <input 
                  type="text" 
                  name="contactFirstName" 
                  value={leadFullName}
                  required
                  class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]"
                />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-500 mb-1.5">Last Name <span class="text-slate-400 font-normal ml-1">(Optional)</span></label>
                <input 
                  type="text" 
                  name="contactLastName" 
                  value=""
                  class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]"
                />
              </div>
            </div>
            <div class="space-y-4">
              <div>
                <label class="block text-xs font-bold text-slate-500 mb-1.5">Email</label>
                <input 
                  type="email" 
                  name="contactEmail" 
                  value={lead.email || ''}
                  class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]"
                />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-500 mb-1.5">Phone</label>
                <input 
                  type="text" 
                  name="contactPhone" 
                  value={lead.phone || ''}
                  class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]"
                />
              </div>
            </div>
          </div>

          <button type="submit" class="w-full inline-flex items-center justify-center px-4 py-2.5 bg-[#242a56] hover:bg-[#1a1e3e] text-white text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#242a56]">
            Create Client & Link Lead
          </button>
        </form>
      </div>

      <!-- Link Existing Client -->
      <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden h-fit">
        <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
          <h2 class="text-base font-bold text-[#242a56]">Link to Existing Client</h2>
        </div>
        <form method="POST" class="p-6 space-y-5">
          <input type="hidden" name="actionType" value="link_existing" />
          
          <div>
            <label class="block text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-2">Select Existing Client <span class="text-red-500">*</span></label>
            <p class="text-sm text-slate-500 mb-3">If this lead is from an established client, link it instead of creating a duplicate.</p>
            {availableClients.length > 0 ? (
              <select 
                name="existingClientId" 
                required
                class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6] bg-white"
              >
                <option value="" disabled selected>Select a client...</option>
                {availableClients.map(c => (
                  <option value={c.id}>{c.name} ({c.status})</option>
                ))}
              </select>
            ) : (
              <div class="p-3 bg-slate-50 text-slate-500 text-sm rounded-lg border border-slate-200">
                No active clients available to link.
              </div>
            )}
          </div>

          <button type="submit" disabled={availableClients.length === 0} class="w-full inline-flex items-center justify-center px-4 py-2.5 bg-white border border-[#242a56] text-[#242a56] hover:bg-slate-50 text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#242a56] disabled:opacity-50 disabled:cursor-not-allowed">
            Link to Existing Client
          </button>
        </form>
      </div>

    </div>
  </div>
</AdminLayout>

