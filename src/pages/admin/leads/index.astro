---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db';
import { leads } from '../../../lib/db/schema/crm';
import { desc, like, eq, or, and, type SQL } from 'drizzle-orm';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { requirePermission } from '../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
requirePermission(user.role as any, 'leads', 'read');

const db = getDb((env as any).DB);

const searchParams = Astro.url.searchParams;
const query = searchParams.get('q') || '';
const statusFilter = searchParams.get('status') || '';
const page = parseInt(searchParams.get('page') || '1') || 1;
const limit = 25;
const offset = (page - 1) * limit;

const filters: SQL[] = [];
if (statusFilter && statusFilter !== 'all') {
  filters.push(eq(leads.status, statusFilter as any));
}
if (query) {
  const searchCondition = or(
    like(leads.name, `%${query}%`),
    like(leads.email, `%${query}%`),
    like(leads.company, `%${query}%`)
  );
  if (searchCondition) {
    filters.push(searchCondition);
  }
}

const where = filters.length > 0 ? and(...filters) : undefined;
const allLeads = await db.select().from(leads).where(where).orderBy(desc(leads.createdAt)).limit(limit).offset(offset);

const statusColors: Record<string, string> = {
  new: 'bg-blue-50 text-blue-700 border-blue-200',
  contacted: 'bg-yellow-50 text-yellow-700 border-yellow-200',
  qualified: 'bg-purple-50 text-purple-700 border-purple-200',
  proposal_sent: 'bg-indigo-50 text-indigo-700 border-indigo-200',
  won: 'bg-green-50 text-green-700 border-green-200',
  lost: 'bg-slate-100 text-slate-600 border-slate-200',
  spam: 'bg-red-50 text-red-700 border-red-200'
};

const formatStatus = (s: string) => s.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
---

<AdminLayout title="Leads" user={user}>
  <div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto">
    
    <!-- Header -->
    <div class="sm:flex sm:items-center sm:justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-[#242a56]">Project Enquiries</h1>
        <p class="mt-1 text-sm text-[#64748b]">Manage new business leads and incoming project requests.</p>
      </div>
      <div class="mt-4 sm:mt-0">
        <a href="/admin/leads/new" class="inline-flex items-center justify-center px-4 py-2 bg-[#242a56] hover:bg-[#1a1e3e] text-white text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#242a56] gap-2">
          <AdminIcon name="plus" class="w-4 h-4" />
          Add Lead
        </a>
      </div>
    </div>

    <!-- Filters & Search -->
    <div class="bg-white p-4 rounded-xl shadow-sm border border-[#e2e8f0] mb-6 flex flex-col sm:flex-row gap-4 justify-between items-center">
      <form class="flex flex-col sm:flex-row w-full sm:w-auto gap-3" method="GET" action="/admin/leads">
        <!-- Desktop hidden status input (managed by pills via links on desktop, but if search is submitted on desktop, we need this) -->
        <input type="hidden" name="status" value={statusFilter} class="hidden sm:block" disabled />
        
        <div class="relative w-full sm:w-64">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <AdminIcon name="search" class="w-4 h-4" />
          </div>
          <input 
            type="text" 
            name="q" 
            value={query}
            placeholder="Search leads..." 
            class="block w-full pl-9 pr-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]"
          />
        </div>
        
        <!-- Mobile Status Select (Option A) -->
        <select 
          name="status" 
          class="block sm:hidden w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-[#6878d6] focus:border-[#6878d6] appearance-none"
          onchange="this.form.submit()"
        >
          {['all', 'new', 'contacted', 'qualified', 'proposal_sent', 'won', 'lost', 'spam'].map(s => (
            <option value={s === 'all' ? '' : s} selected={(statusFilter === s) || (!statusFilter && s === 'all')}>
              {s === 'all' ? 'All Statuses' : formatStatus(s)}
            </option>
          ))}
        </select>

        <button type="submit" class="hidden sm:block px-4 py-2 bg-[#f1f5f9] hover:bg-[#e2e8f0] text-[#242a56] text-sm font-medium rounded-lg transition-colors">
          Search
        </button>
        <!-- Mobile search button, visible only on small screens -->
        <button type="submit" class="block sm:hidden w-full px-4 py-2 bg-[#242a56] text-white text-sm font-medium rounded-lg transition-colors">
          Search
        </button>
      </form>
      
      <!-- Desktop Status Pills -->
      <div class="hidden sm:flex w-full sm:w-auto gap-2 flex-wrap">
        {['all', 'new', 'contacted', 'qualified', 'proposal_sent', 'won', 'lost', 'spam'].map((s) => {
          const isActive = (statusFilter === s) || (!statusFilter && s === 'all');
          const url = new URL(Astro.url);
          url.searchParams.set('status', s === 'all' ? '' : s);
          url.searchParams.set('page', '1');
          return (
            <a 
              href={url.toString()}
              class:list={[
                "whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-semibold border transition-colors",
                isActive ? "bg-[#242a56] text-white border-[#242a56]" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50"
              ]}
            >
              {formatStatus(s)}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Leads List -->
    <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
      {allLeads.length > 0 ? (
        <div>
          <!-- Mobile Cards Layout -->
          <div class="block sm:hidden divide-y divide-[#e2e8f0]">
            {allLeads.map((lead) => (
              <div class="p-4 hover:bg-[#f8fafc] transition-colors">
                <div class="flex justify-between items-start mb-2">
                  <div>
                    <h3 class="text-sm font-bold text-[#242a56]">{lead.name}</h3>
                    <p class="text-xs text-[#64748b]">{lead.email}</p>
                  </div>
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border ${statusColors[lead.status] || statusColors['new']}`}>
                    {formatStatus(lead.status)}
                  </span>
                </div>
                {lead.requestedService && (
                  <p class="text-xs font-medium text-slate-700 mt-2">{lead.requestedService}</p>
                )}
                {lead.description && (
                  <p class="text-xs text-slate-500 mt-1 line-clamp-2">{lead.description}</p>
                )}
                <div class="mt-3 flex justify-between items-center border-t border-slate-100 pt-3">
                  <p class="text-[10px] text-slate-400">
                    {lead.createdAt ? new Date(lead.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Not provided'}
                  </p>
                  <a href={`/admin/leads/${lead.id}`} class="text-xs font-medium text-[#6878d6]">
                    View Details &rarr;
                  </a>
                </div>
              </div>
            ))}
          </div>

          <!-- Desktop Table Layout -->
          <div class="hidden sm:block overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-[#f8fafc] border-b border-[#e2e8f0]">
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Prospect</th>
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Request</th>
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider hidden md:table-cell">Received</th>
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Status</th>
                  <th class="px-6 py-4 text-right"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#e2e8f0]">
                {allLeads.map((lead) => (
                  <tr class="hover:bg-[#f8fafc] transition-colors group">
                    <td class="px-6 py-4 align-top">
                      <p class="text-sm font-bold text-[#242a56]">{lead.name}</p>
                      <p class="text-xs text-[#64748b] mt-0.5">{lead.email}</p>
                      {lead.company && <p class="text-xs text-slate-500 mt-1 flex items-center gap-1"><AdminIcon name="briefcase" class="w-3 h-3"/> {lead.company}</p>}
                    </td>
                    <td class="px-6 py-4 align-top">
                      <p class="text-sm text-slate-700 font-medium">{lead.requestedService || 'Not specified'}</p>
                      <p class="text-xs text-slate-500 mt-1 line-clamp-1 max-w-xs">{lead.description}</p>
                    </td>
                    <td class="px-6 py-4 align-top hidden md:table-cell">
                      <p class="text-sm text-slate-600">
                        {lead.createdAt ? new Date(lead.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Not provided'}
                      </p>
                    </td>
                    <td class="px-6 py-4 align-top">
                      <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold border ${statusColors[lead.status] || statusColors['new']}`}>
                        {formatStatus(lead.status)}
                      </span>
                    </td>
                    <td class="px-6 py-4 align-top text-right">
                      <a href={`/admin/leads/${lead.id}`} class="inline-flex items-center justify-center p-2 rounded-lg text-[#6878d6] hover:bg-[#eff2ff] hover:text-[#242a56] transition-colors font-medium text-sm">
                        View
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ) : (
        <div class="px-6 py-16 text-center">
          <div class="w-12 h-12 bg-slate-50 rounded-lg flex items-center justify-center mx-auto mb-4 border border-slate-200">
            <AdminIcon name="inbox" class="w-6 h-6 text-slate-400" />
          </div>
          <h3 class="text-sm font-bold text-[#242a56]">No enquiries found</h3>
          <p class="text-sm text-slate-500 mt-1 max-w-sm mx-auto">
            {query || statusFilter ? 'Try adjusting your filters or search terms.' : 'When prospective clients submit the Start a Project form, their details will appear here.'}
          </p>
          {(query || statusFilter) && (
            <a href="/admin/leads" class="mt-4 inline-flex items-center text-sm font-medium text-[#6878d6] hover:text-[#242a56]">
              Clear filters
            </a>
          )}
        </div>
      )}
    </div>
    
  </div>
</AdminLayout>
