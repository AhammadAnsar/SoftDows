---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import { getDb } from '../../../../lib/db';
import { navigationItems } from '../../../../lib/db/schema/cms';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';
import { asc } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
requirePermission(user.role as any, 'content', 'read');

const db = getDb((env as any).DB);

const items = await db.select().from(navigationItems).orderBy(asc(navigationItems.displayOrder));

// Group by groupKey
const groupedItems = items.reduce((acc, item) => {
  if (!acc[item.groupKey]) {
    acc[item.groupKey] = [];
  }
  acc[item.groupKey].push(item);
  return acc;
}, {} as Record<string, typeof items>);

---

<AdminLayout title="Navigation" user={user}>
  <div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto">
    <div class="sm:flex sm:items-center sm:justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-[#242a56]">Navigation Menus</h1>
        <p class="mt-1 text-sm text-[#64748b]">Manage header, footer, and other navigation menus across the website.</p>
      </div>
      <div class="mt-4 sm:mt-0 flex gap-3">
        <button onclick="document.getElementById('new-item-modal').classList.remove('hidden')" class="inline-flex items-center justify-center px-4 py-2 bg-[#242a56] hover:bg-[#1a1e3e] text-white text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#242a56] gap-2">
          <AdminIcon name="plus" class="w-4 h-4" />
          Add Item
        </button>
      </div>
    </div>

    <div class="space-y-8">
      {Object.entries(groupedItems).map(([groupKey, groupItems]) => (
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
            <h2 class="text-lg font-bold text-[#242a56] capitalize">{groupKey} Menu</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-[#f8fafc] border-b border-[#e2e8f0]">
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Label</th>
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Target</th>
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Order</th>
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Status</th>
                  <th class="px-6 py-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#e2e8f0]">
                {groupItems.map((item) => (
                  <tr class="hover:bg-[#f8fafc] transition-colors group">
                    <td class="px-6 py-4">
                      <p class="text-sm font-bold text-[#242a56]">{item.label}</p>
                      {item.shortDescription && <p class="text-xs text-slate-500 mt-1">{item.shortDescription}</p>}
                    </td>
                    <td class="px-6 py-4">
                      <p class="text-sm text-slate-600">
                        {item.customUrl ? (
                          <span class="text-[#6878d6]">{item.customUrl}</span>
                        ) : (
                          <span class="text-slate-500 italic">{item.entityType}: {item.entityId}</span>
                        )}
                      </p>
                    </td>
                    <td class="px-6 py-4">
                      <p class="text-sm text-slate-600">{item.displayOrder}</p>
                    </td>
                    <td class="px-6 py-4">
                      <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold border ${item.isEnabled ? 'bg-green-50 text-green-700 border-green-200' : 'bg-slate-50 text-slate-600 border-slate-200'}`}>
                        {item.isEnabled ? 'Enabled' : 'Disabled'}
                      </span>
                    </td>
                    <td class="px-6 py-4 text-right">
                      <button 
                        class="text-[#6878d6] hover:text-[#242a56] text-sm font-medium mr-3"
                        onclick={`editItem('${item.id}', '${item.label}', '${item.customUrl || ''}', '${item.groupKey}', ${item.displayOrder}, ${item.isEnabled})`}
                      >
                        Edit
                      </button>
                      <button 
                        class="text-red-500 hover:text-red-700 text-sm font-medium"
                        onclick={`deleteItem('${item.id}')`}
                      >
                        Delete
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
      
      {Object.keys(groupedItems).length === 0 && (
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] px-6 py-16 text-center">
          <div class="w-12 h-12 bg-slate-50 rounded-lg flex items-center justify-center mx-auto mb-4 border border-slate-200">
            <AdminIcon name="list" class="w-6 h-6 text-slate-400" />
          </div>
          <h3 class="text-sm font-bold text-[#242a56]">No navigation items</h3>
          <p class="text-sm text-slate-500 mt-1 max-w-sm mx-auto">
            Get started by adding a new navigation item.
          </p>
        </div>
      )}
    </div>
  </div>

  <!-- Modal for New/Edit Item -->
  <div id="new-item-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full m-4">
      <div class="px-6 py-4 border-b border-[#e2e8f0] flex justify-between items-center">
        <h3 class="text-lg font-bold text-[#242a56]" id="modal-title">Add Navigation Item</h3>
        <button onclick="document.getElementById('new-item-modal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
          <AdminIcon name="x" class="w-5 h-5" />
        </button>
      </div>
      <form id="item-form" class="p-6">
        <input type="hidden" id="item-id" name="id" />
        
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Group Key</label>
            <input type="text" id="item-group" name="groupKey" placeholder="e.g. header, footer" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Label</label>
            <input type="text" id="item-label" name="label" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Custom URL</label>
            <input type="text" id="item-url" name="customUrl" placeholder="/about" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" />
            <p class="text-xs text-slate-500 mt-1">Provide a relative or absolute URL.</p>
          </div>
          <div class="flex gap-4">
            <div class="flex-1">
              <label class="block text-sm font-medium text-slate-700 mb-1">Display Order</label>
              <input type="number" id="item-order" name="displayOrder" value="0" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" />
            </div>
            <div class="flex items-center pt-6">
              <input type="checkbox" id="item-enabled" name="isEnabled" checked class="h-4 w-4 text-[#6878d6] focus:ring-[#6878d6] border-slate-300 rounded" />
              <label for="item-enabled" class="ml-2 block text-sm text-slate-700">Enabled</label>
            </div>
          </div>
        </div>
        
        <div class="mt-6 flex justify-end gap-3">
          <button type="button" onclick="document.getElementById('new-item-modal').classList.add('hidden')" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50">Cancel</button>
          <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-[#242a56] hover:bg-[#1a1e3e] rounded-lg">Save Item</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  function editItem(id: string, label: string, url: string, group: string, order: number, enabled: boolean) {
    const modal = document.getElementById('new-item-modal');
    if (!modal) return;
    
    document.getElementById('modal-title')!.innerText = 'Edit Navigation Item';
    (document.getElementById('item-id') as HTMLInputElement).value = id;
    (document.getElementById('item-label') as HTMLInputElement).value = label;
    (document.getElementById('item-url') as HTMLInputElement).value = url;
    (document.getElementById('item-group') as HTMLInputElement).value = group;
    (document.getElementById('item-order') as HTMLInputElement).value = order.toString();
    (document.getElementById('item-enabled') as HTMLInputElement).checked = enabled;
    
    modal.classList.remove('hidden');
  }
  
  // Make available globally for inline onclick
  (window as any).editItem = editItem;

  async function deleteItem(id: string) {
    if (!confirm('Are you sure you want to delete this navigation item?')) return;
    
    try {
      const res = await fetch(`/api/admin/website/navigation/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete' })
      });
      
      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json();
        alert((data as any).error || 'Failed to delete item');
      }
    } catch (e) {
      console.error(e);
      alert('An error occurred');
    }
  }
  (window as any).deleteItem = deleteItem;

  document.getElementById('item-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    
    const id = formData.get('id') as string;
    const isEdit = !!id;
    
    const payload = {
      label: formData.get('label'),
      customUrl: formData.get('customUrl') || null,
      groupKey: formData.get('groupKey'),
      displayOrder: parseInt(formData.get('displayOrder') as string),
      isEnabled: formData.get('isEnabled') === 'on'
    };
    
    try {
      let res;
      if (isEdit) {
        res = await fetch(`/api/admin/website/navigation/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'update', ...payload })
        });
      } else {
        res = await fetch(`/api/admin/website/navigation/create`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      }
      
      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json();
        alert((data as any).error || 'Failed to save item');
      }
    } catch (e) {
      console.error(e);
      alert('An error occurred');
    }
  });
  
  // Reset form when modal is closed
  document.getElementById('new-item-modal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      (e.currentTarget as HTMLElement).classList.add('hidden');
    }
  });
</script>
