---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import Button from '../../../../components/ui/Button.astro';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../../lib/db';
import { teamMembers } from '../../../../lib/db/schema/cms';
import { asc } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user || !requirePermission(user.role as any, 'content', 'update')) {
  return Astro.redirect('/login');
}

const db = getDb((env as any).DB);
const items = await db.select().from(teamMembers).orderBy(asc(teamMembers.displayOrder)).all();
---
<AdminLayout title="Team Members CMS" user={user as any}>
  <div class="px-4 sm:px-6 lg:px-8 py-8 max-w-7xl mx-auto">
    <div class="sm:flex sm:items-center">
      <div class="sm:flex-auto">
        <h1 class="text-2xl font-bold leading-6 text-gray-900">Team Members</h1>
        <p class="mt-2 text-sm text-gray-700">Manage all canonical teamMembers.</p>
      </div>
      <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
        <Button href="/admin/website/teamMembers/new" variant="primary">Add Team Member</Button>
      </div>
    </div>
    
    <div class="mt-8 overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">Name</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Featured</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Public</th>
            <th class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">Edit</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          {items.map((item) => (
            <tr>
              <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900">{(item as any).name || (item as any).brandName || (item as any).fullName}</td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{item.status}</td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{item.featured ? 'Yes' : 'No'}</td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{item.isVisible ? 'Yes' : 'No'}</td>
              <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                <a href={`/admin/website/teamMembers/${item.id}`} class="text-[var(--color-brand-purple)] hover:text-indigo-900">Edit</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
