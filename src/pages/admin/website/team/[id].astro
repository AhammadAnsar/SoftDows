---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import Button from '../../../../components/ui/Button.astro';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../../lib/db';
import { teamMembers } from '../../../../lib/db/schema/cms';
import { eq } from 'drizzle-orm';
import crypto from 'crypto';

const user = Astro.locals.user;
if (!user || !requirePermission(user.role as any, 'content', 'update')) {
  return Astro.redirect('/login');
}

const db = getDb((env as any).DB);
const id = Astro.params.id;
const isNew = id === 'new';

let item: any = {};
if (!isNew) {
  const found = await db.select().from(teamMembers).where(eq(teamMembers.id, id as string)).get();
  if (found) item = found;
  else return Astro.redirect('/admin/website/teamMembers');
}

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  
  const payload = {
    slug: (data.get('slug') as string) || crypto.randomUUID(),
    name: data.get('name') as string,
    shortName: data.get('shortName') as string,
    category: data.get('category') as string,
    tagline: data.get('tagline') as string,
    shortDescription: data.get('shortDescription') as string,
    fullDescription: data.get('fullDescription') as string,
    status: (data.get('status') as any) || 'active',
    displayOrder: parseInt(data.get('displayOrder') as string) || 0,
    featured: data.get('featured') === 'on',
    isVisible: data.get('isVisible') === 'on',
    seoTitle: data.get('seoTitle') as string,
    seoDescription: data.get('seoDescription') as string,
    updatedAt: new Date(),
    capabilities: data.get('capabilities') ? JSON.parse(data.get('capabilities') as string) : null,
    deliverables: data.get('deliverables') ? JSON.parse(data.get('deliverables') as string) : null
  };

  if (isNew) {
    const newId = crypto.randomUUID().replace(/-/g, '');
    await db.insert(teamMembers).values({ id: newId, ...(payload as any), createdAt: new Date() });
    return Astro.redirect('/admin/website/teamMembers/' + newId);
  } else {
    await db.update(teamMembers).set(payload).where(eq(teamMembers.id, id as string));
    return Astro.redirect('/admin/website/teamMembers');
  }
}
---
<AdminLayout title={isNew ? 'New Team Member' : 'Edit Team Member'} user={user as any}>
  <div class="px-4 sm:px-6 lg:px-8 py-8 max-w-3xl mx-auto">
    <h1 class="text-2xl font-bold mb-8">{isNew ? 'New Team Member' : 'Edit Team Member'}</h1>
    <form method="POST" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700">Name</label>
        <input type="text" name="name" value={item.name || ''} required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Slug</label>
        <input type="text" name="slug" value={item.slug || ''} required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Short Name</label>
        <input type="text" name="shortName" value={item.shortName || ''} class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm p-2 border" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Short Description</label>
        <textarea name="shortDescription" rows="3" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm p-2 border">{item.shortDescription || ''}</textarea>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-gray-700">Capabilities (JSON Array)</label>
        <textarea name="capabilities" rows="5" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm p-2 border font-mono">{item.capabilities ? JSON.stringify(item.capabilities, null, 2) : ''}</textarea>
      </div>

      <div class="flex items-center gap-4">
        <label class="flex items-center">
          <input type="checkbox" name="featured" checked={item.featured} class="rounded border-gray-300 text-indigo-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
          <span class="ml-2 text-sm text-gray-900">Featured</span>
        </label>
        <label class="flex items-center">
          <input type="checkbox" name="isVisible" checked={item.isVisible} class="rounded border-gray-300 text-indigo-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
          <span class="ml-2 text-sm text-gray-900">Publicly Visible</span>
        </label>
      </div>

      <div class="flex gap-4 pt-4">
        <Button type="submit" variant="primary">Save</Button>
        <Button href="/admin/website/teamMembers" variant="outline">Cancel</Button>
      </div>
    </form>
  </div>
</AdminLayout>
