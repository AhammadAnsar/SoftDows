---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import Button from '../../../../components/ui/Button.astro';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../../lib/db';
import { mediaLibrary } from '../../../../lib/db/schema/cms';
import { desc } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user || !requirePermission(user.role as any, 'content', 'update')) {
  return Astro.redirect('/login');
}

const db = getDb((env as any).DB);
const items = await db.select().from(mediaLibrary).orderBy(desc(mediaLibrary.createdAt)).all();
---
<AdminLayout title="Media Library" user={user as any}>
  <div class="px-4 sm:px-6 lg:px-8 py-8 max-w-7xl mx-auto">
    <div class="sm:flex sm:items-center">
      <div class="sm:flex-auto">
        <h1 class="text-2xl font-bold leading-6 text-gray-900">Media Library</h1>
        <p class="mt-2 text-sm text-gray-700">Manage all media assets.</p>
      </div>
      <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none flex space-x-2">
        <form action="/api/admin/website/media" method="POST" enctype="multipart/form-data" class="flex items-center space-x-2" onsubmit="return handleUpload(event)">
            <input type="file" name="file" required class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none" />
            <Button type="submit" variant="primary">Upload</Button>
        </form>
      </div>
    </div>
    
    <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 sm:gap-x-6 lg:grid-cols-4 xl:gap-x-8">
        {items.map((item) => (
            <div class="relative">
                <div class="group aspect-h-7 aspect-w-10 block w-full overflow-hidden rounded-lg bg-gray-100 focus-within:ring-2 focus-within:ring-indigo-500 focus-within:ring-offset-2 focus-within:ring-offset-gray-100">
                    {item.mimeType.startsWith('image/') ? (
                        <img src={`/media/${item.objectKey}`} alt={item.altText || item.displayName} class="pointer-events-none object-cover group-hover:opacity-75" />
                    ) : (
                        <div class="flex items-center justify-center h-full text-gray-500 font-medium">DOCUMENT</div>
                    )}
                </div>
                <p class="pointer-events-none mt-2 block truncate text-sm font-medium text-gray-900">{item.displayName}</p>
                <p class="pointer-events-none block text-sm font-medium text-gray-500">{(item.fileSize / 1024).toFixed(1)} KB</p>
                <div class="flex space-x-2 mt-2">
                    <form action={`/api/admin/website/media/${item.id}`} method="POST" onsubmit="return handleDelete(event)">
                        <input type="hidden" name="_method" value="DELETE" />
                        <button type="submit" class="text-xs text-red-600 hover:text-red-900 font-medium">Delete</button>
                    </form>
                </div>
            </div>
        ))}
    </div>
  </div>
  
  <script is:inline>
    async function handleUpload(e) {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);
      const res = await fetch(form.action, { method: 'POST', body: formData });
      if(res.ok) {
        window.location.reload();
      } else {
        alert('Upload failed');
      }
      return false;
    }
    
    async function handleDelete(e) {
      e.preventDefault();
      if(!confirm('Delete this media?')) return false;
      const form = e.target;
      const res = await fetch(form.action, { method: 'DELETE' });
      if(res.ok) {
        window.location.reload();
      } else {
        alert('Delete failed');
      }
      return false;
    }
  </script>
</AdminLayout>
