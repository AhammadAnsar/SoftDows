---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import Button from '../../../../components/ui/Button.astro';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../../lib/db';
import { articles } from '../../../../lib/db/schema/cms';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user || !requirePermission(user.role as any, 'content', 'update')) {
  return Astro.redirect('/login');
}

const db = getDb((env as any).DB);
const { id } = Astro.params;
const item = await db.select().from(articles).where(eq(articles.id, id as string)).get();

if (!item) return Astro.redirect('/admin/website/insights');

let error = '';
let success = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  try {
    await db.update(articles).set({
      title: formData.get('title') as string,
      slug: formData.get('slug') as string,
      excerpt: formData.get('excerpt') as string,
      content: formData.get('content') as string,
      status: formData.get('status') as any,
    }).where(eq(articles.id, id as string));
    success = true;
    Object.assign(item, Object.fromEntries(formData));
  } catch (e: any) {
    error = e.message;
  }
}
---
<AdminLayout title="Edit Article" user={user as any}>
  <div class="px-4 sm:px-6 lg:px-8 py-8 max-w-2xl mx-auto">
    <h1 class="text-2xl font-bold leading-6 text-gray-900 mb-8">Edit Article</h1>
    {error && <div class="bg-red-50 text-red-700 p-4 rounded-md mb-6">{error}</div>}
    {success && <div class="bg-green-50 text-green-700 p-4 rounded-md mb-6">Saved successfully!</div>}
    
    <form method="POST" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700">Title</label>
        <input type="text" name="title" value={item.title} required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Slug</label>
        <input type="text" name="slug" value={item.slug} required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Excerpt</label>
        <textarea name="excerpt" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" rows="2">{item.excerpt}</textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Content (Markdown)</label>
        <textarea name="content" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" rows="10">{item.content}</textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Status</label>
        <select name="status" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border">
          <option value="draft" selected={item.status === 'draft'}>Draft</option>
          <option value="published" selected={item.status === 'published'}>Published</option>
          <option value="archived" selected={item.status === 'archived'}>Archived</option>
        </select>
      </div>
      <div class="flex justify-end gap-x-3">
        <Button href="/admin/website/insights" variant="secondary">Back</Button>
        <Button type="submit" variant="primary">Save Changes</Button>
      </div>
    </form>
  </div>
</AdminLayout>
