---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import StatusBadge from '../../../../components/admin/StatusBadge.astro';
import { requirePermission } from '../../../../lib/auth/authorization';
import type { AppRole } from '../../../../lib/auth/permissions';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../../lib/db';
import { sitePages, pageSections } from '../../../../lib/db/schema/cms';
import { eq, asc } from 'drizzle-orm';

const currentUser = Astro.locals.user;
if (!currentUser) return Astro.redirect('/login');
const role = currentUser.role as AppRole;

if (!requirePermission(role as any, 'content', 'update')) {
  return Astro.redirect('/admin/access-denied');
}

const db = getDb((env as any).DB);

// Get the homepage record
const [homepage] = await db.select().from(sitePages).where(eq(sitePages.slug, '/')).limit(1);

if (!homepage) {
  // If not found, create a dummy fallback or throw an error
  // But ideally, the homepage should be pre-seeded.
}

const sections = homepage 
  ? await db.select().from(pageSections).where(eq(pageSections.pageId, homepage.id)).orderBy(asc(pageSections.displayOrder))
  : [];

const formatSectionName = (identifier: string) => {
  return identifier
    .replace(/[-_]/g, ' ')
    .split(' ')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
};
---
<AdminLayout title="Homepage Sections" user={currentUser}>
  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
    <div>
      <h1 class="text-2xl font-bold text-[#242a56]">Homepage Sections</h1>
      <p class="text-sm text-[#64748b]">Manage the content and layout of the homepage</p>
    </div>
  </div>

  {!homepage ? (
    <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] p-8 text-center">
      <AdminIcon name="layout" class="w-12 h-12 text-slate-300 mx-auto mb-3" />
      <h3 class="text-sm font-medium text-slate-900">Homepage not found</h3>
      <p class="text-sm text-slate-500 mt-1">Please ensure the homepage record exists in the database.</p>
    </div>
  ) : (
    <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden mb-6">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-[#e2e8f0] text-xs uppercase tracking-wider text-slate-500 font-semibold">
              <th class="px-6 py-4">Section Name</th>
              <th class="px-6 py-4">Heading</th>
              <th class="px-6 py-4">Order</th>
              <th class="px-6 py-4">Status</th>
              <th class="px-6 py-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e2e8f0]">
            {sections.length === 0 ? (
              <tr>
                <td colspan="5" class="px-6 py-12 text-center">
                  <AdminIcon name="layout" class="w-12 h-12 text-slate-300 mx-auto mb-3" />
                  <h3 class="text-sm font-medium text-slate-900">No sections found</h3>
                  <p class="text-sm text-slate-500 mt-1">There are no sections configured for the homepage.</p>
                </td>
              </tr>
            ) : (
              sections.map((section) => (
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="px-6 py-4 font-medium text-[#242a56]">
                    {formatSectionName(section.sectionIdentifier)}
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-600 truncate max-w-[200px]">
                    {section.heading || '-'}
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-500">
                    {section.displayOrder}
                  </td>
                  <td class="px-6 py-4">
                    {section.isEnabled ? (
                      <StatusBadge label="Enabled" variant="success" />
                    ) : (
                      <StatusBadge label="Disabled" variant="neutral" />
                    )}
                  </td>
                  <td class="px-6 py-4 text-right">
                    <a href={`/admin/website/homepage/${section.id}`} class="inline-flex items-center justify-center p-2 text-slate-400 hover:text-[#6878d6] hover:bg-[#eef0ff] rounded-lg transition-colors">
                      <AdminIcon name="edit" class="w-4 h-4" />
                    </a>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
    
    <!-- Mobile Cards (Hidden on md and up) -->
    <div class="md:hidden space-y-4 mb-6">
      {sections.map((section) => (
        <a href={`/admin/website/homepage/${section.id}`} class="block bg-white rounded-xl shadow-sm border border-[#e2e8f0] p-4 hover:border-[#c7d0fa] transition-colors">
          <div class="flex justify-between items-start mb-3">
            <div class="font-medium text-[#242a56]">{formatSectionName(section.sectionIdentifier)}</div>
          </div>
          <div class="grid grid-cols-2 gap-2 text-sm mt-4">
            <div class="bg-slate-50 p-2 rounded-lg flex flex-col gap-1">
              <span class="text-xs text-slate-500">Heading</span>
              <span class="text-slate-700 truncate">{section.heading || '-'}</span>
            </div>
            <div class="bg-slate-50 p-2 rounded-lg flex flex-col gap-1">
              <span class="text-xs text-slate-500">Status</span>
              {section.isEnabled ? (
                <StatusBadge label="Enabled" variant="success" />
              ) : (
                <StatusBadge label="Disabled" variant="neutral" />
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  )}
</AdminLayout>
