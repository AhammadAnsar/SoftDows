---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import { requirePermission } from '../../../../lib/auth/authorization';
import type { AppRole } from '../../../../lib/auth/permissions';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../../lib/db';
import { pageSections } from '../../../../lib/db/schema/cms';
import { eq } from 'drizzle-orm';

const currentUser = Astro.locals.user;
if (!currentUser) return Astro.redirect('/login');
const role = currentUser.role as AppRole;

if (!requirePermission(role as any, 'content', 'update')) {
  return Astro.redirect('/admin/access-denied');
}

const db = getDb((env as any).DB);
const id = Astro.params.id;

if (!id) {
  return Astro.redirect('/admin/website/homepage');
}

const [section] = await db.select().from(pageSections).where(eq(pageSections.id, id)).limit(1);

if (!section) {
  return Astro.redirect('/admin/website/homepage');
}

const formatSectionName = (identifier: string) => {
  return identifier
    .replace(/[-_]/g, ' ')
    .split(' ')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
};

const sectionName = formatSectionName(section.sectionIdentifier);
---
<AdminLayout title={`Edit ${sectionName} Section`} user={currentUser}>
  <div class="mb-6">
    <a href="/admin/website/homepage" class="inline-flex items-center text-sm text-slate-500 hover:text-[#6878d6] transition-colors mb-4">
      <AdminIcon name="arrow-left" class="w-4 h-4 mr-1" />
      Back to Homepage Sections
    </a>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-2xl font-bold text-[#242a56]">Edit {sectionName} Section</h1>
        <p class="text-sm text-[#64748b]">Update the content and configuration for this section.</p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] p-6 max-w-3xl">
    <form id="edit-section-form" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-slate-700 mb-1">Heading</label>
          <input 
            type="text" 
            name="heading" 
            value={section.heading || ''} 
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" 
          />
        </div>
        
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-slate-700 mb-1">Subheading</label>
          <input 
            type="text" 
            name="subheading" 
            value={section.subheading || ''} 
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" 
          />
        </div>

        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-slate-700 mb-1">Content</label>
          <textarea 
            name="content" 
            rows="5"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" 
          >{section.content || ''}</textarea>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">CTA Text</label>
          <input 
            type="text" 
            name="ctaText" 
            value={section.ctaText || ''} 
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" 
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">CTA Link</label>
          <input 
            type="text" 
            name="ctaLink" 
            value={section.ctaLink || ''} 
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" 
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Display Order</label>
          <input 
            type="number" 
            name="displayOrder" 
            value={section.displayOrder} 
            required
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]" 
          />
        </div>

        <div class="flex items-center pt-6">
          <label class="flex items-center cursor-pointer">
            <div class="relative">
              <input type="checkbox" name="isEnabled" class="sr-only" checked={section.isEnabled} />
              <div class="block bg-slate-200 w-10 h-6 rounded-full transition-colors js-toggle-bg"></div>
              <div class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform js-toggle-dot"></div>
            </div>
            <div class="ml-3 text-sm font-medium text-slate-700">
              Enabled
            </div>
          </label>
        </div>
      </div>

      <div class="pt-6 border-t border-slate-200 flex justify-end gap-3">
        <a href="/admin/website/homepage" class="px-4 py-2 border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium rounded-lg transition-colors">
          Cancel
        </a>
        <button type="submit" class="px-4 py-2 bg-[#6878d6] hover:bg-[#5665b9] text-white text-sm font-medium rounded-lg transition-colors flex items-center">
          <span class="js-btn-text">Save Changes</span>
          <AdminIcon name="loader" class="w-4 h-4 ml-2 animate-spin hidden js-btn-spinner" />
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  input:checked ~ .js-toggle-bg {
    background-color: #10b981; /* emerald-500 */
  }
  input:checked ~ .js-toggle-dot {
    transform: translateX(100%);
  }
</style>

<script define:vars={{ sectionId: id }}>
  const form = document.getElementById('edit-section-form');
  const checkbox = form.querySelector('input[name="isEnabled"]');
  const toggleBg = form.querySelector('.js-toggle-bg');
  
  // Initialize toggle styles
  if (checkbox.checked) {
    toggleBg.classList.add('bg-emerald-500');
    toggleBg.classList.remove('bg-slate-200');
  }

  // Handle toggle change
  checkbox.addEventListener('change', (e) => {
    if (e.target.checked) {
      toggleBg.classList.add('bg-emerald-500');
      toggleBg.classList.remove('bg-slate-200');
    } else {
      toggleBg.classList.remove('bg-emerald-500');
      toggleBg.classList.add('bg-slate-200');
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    const btnText = form.querySelector('.js-btn-text');
    const spinner = form.querySelector('.js-btn-spinner');
    
    const formData = new FormData(form);
    const data = {
      heading: formData.get('heading'),
      subheading: formData.get('subheading'),
      content: formData.get('content'),
      ctaText: formData.get('ctaText'),
      ctaLink: formData.get('ctaLink'),
      displayOrder: parseInt(formData.get('displayOrder')),
      isEnabled: formData.get('isEnabled') === 'on'
    };

    try {
      btn.disabled = true;
      btnText.textContent = 'Saving...';
      spinner.classList.remove('hidden');
      
      const res = await fetch(`/api/admin/website/homepage/${sectionId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      const result = await res.json();
      
      if (res.ok) {
        alert('Section updated successfully');
        window.location.href = '/admin/website/homepage';
      } else {
        alert(result.error || 'Failed to update section');
      }
    } catch (err) {
      alert('An error occurred. Please try again.');
    } finally {
      btn.disabled = false;
      btnText.textContent = 'Save Changes';
      spinner.classList.add('hidden');
    }
  });
</script>
