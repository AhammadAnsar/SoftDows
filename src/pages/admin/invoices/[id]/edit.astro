---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../lib/db';
import { invoices, invoiceItems, quotations } from '../../../../lib/db/schema/billing';
import { clients } from '../../../../lib/db/schema/crm';
import { projects } from '../../../../lib/db/schema/agency';
import { eq } from 'drizzle-orm';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
requirePermission(user.role as any, 'invoices', 'update');

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/invoices');

const db = getDb((env as any).DB);

const existingResult = await db.select().from(invoices).where(eq(invoices.id, id));
if (!existingResult.length) return Astro.redirect('/admin/invoices');
const existingInvoice = existingResult[0];

const existingItems = await db.select().from(invoiceItems).where(eq(invoiceItems.invoiceId, id)).orderBy(invoiceItems.displayOrder);

const allClients = await db.select().from(clients).orderBy(clients.name);
const allProjects = await db.select().from(projects).orderBy(projects.name);
const allQuotations = await db.select().from(quotations).orderBy(quotations.quotationNumber);

let errors: Record<string, string> = {};
let formData = {
  invoiceNumber: existingInvoice.invoiceNumber,
  clientId: existingInvoice.clientId,
  projectId: existingInvoice.projectId || '',
  quotationId: existingInvoice.quotationId || '',
  currency: existingInvoice.currency,
  issueDate: existingInvoice.issueDate.toISOString().split('T')[0],
  dueDate: existingInvoice.dueDate.toISOString().split('T')[0],
  status: existingInvoice.status,
  notes: existingInvoice.notes || '',
  discount: (existingInvoice.discount / 100).toString(),
  tax: (existingInvoice.tax > 0 ? (existingInvoice.tax / (existingInvoice.subtotal - existingInvoice.discount)) * 100 : 0).toString(),
  isRecurring: existingInvoice.isRecurring || false,
  billingCycle: existingInvoice.billingCycle || 'none',
  nextBillingDate: existingInvoice.nextBillingDate ? existingInvoice.nextBillingDate.toISOString().split('T')[0] : ''
};

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action')?.toString();

    if (action === 'delete') {
      requirePermission(user.role as any, 'invoices', 'delete');
      await db.delete(invoices).where(eq(invoices.id, id));
      return Astro.redirect('/admin/invoices');
    }

    const itemsJson = data.get('itemsJson')?.toString() || '[]';
    const items = JSON.parse(itemsJson);

    formData = {
      ...formData,
      invoiceNumber: data.get('invoiceNumber')?.toString() || formData.invoiceNumber,
      clientId: data.get('clientId')?.toString() || '',
      projectId: data.get('projectId')?.toString() || '',
      quotationId: data.get('quotationId')?.toString() || '',
      currency: data.get('currency')?.toString() || 'USD',
      issueDate: data.get('issueDate')?.toString() || formData.issueDate,
      dueDate: data.get('dueDate')?.toString() || formData.dueDate,
      status: (data.get('status')?.toString() as any) || 'draft',
      notes: data.get('notes')?.toString() || '',
      discount: data.get('discount')?.toString() || '0',
      tax: data.get('tax')?.toString() || '0',
      isRecurring: data.get('isRecurring') === 'on',
      billingCycle: (data.get('billingCycle')?.toString() as any) || 'none',
      nextBillingDate: data.get('nextBillingDate')?.toString() || ''
    };

    if (!formData.clientId) errors.clientId = 'Client is required';
    if (!formData.invoiceNumber) errors.invoiceNumber = 'Invoice Number is required';

    if (Object.keys(errors).length === 0) {
      let subtotal = 0;
      for (const item of items) {
        subtotal += Math.round(parseFloat(item.quantity) * parseFloat(item.unitPrice) * 100);
      }
      
      const discount = Math.round(parseFloat(formData.discount) * 100);
      const taxPercent = parseFloat(formData.tax);
      const subAfterDiscount = subtotal - discount;
      const taxAmount = Math.round(subAfterDiscount * (taxPercent / 100));
      const total = subAfterDiscount + taxAmount;

      const invData: any = {
        invoiceNumber: formData.invoiceNumber,
        clientId: formData.clientId,
        currency: formData.currency,
        issueDate: new Date(formData.issueDate),
        dueDate: new Date(formData.dueDate),
        status: formData.status as any,
        subtotal,
        discount,
        tax: taxAmount,
        total,
        balanceDue: total - existingInvoice.amountPaid,
        isRecurring: formData.isRecurring,
        billingCycle: formData.billingCycle as any
      };
      if (formData.projectId) invData.projectId = formData.projectId;
      if (formData.quotationId) invData.quotationId = formData.quotationId;
      if (formData.notes) invData.notes = formData.notes;
      if (formData.nextBillingDate) invData.nextBillingDate = new Date(formData.nextBillingDate);

      await db.update(invoices).set(invData).where(eq(invoices.id, id));

      await db.delete(invoiceItems).where(eq(invoiceItems.invoiceId, id));

      if (items.length > 0) {
        const iItems = items.map((item: any, i: number) => ({
          id: crypto.randomUUID(), invoiceId: id,
          description: item.description,
          quantity: parseFloat(item.quantity),
          unitPrice: Math.round(parseFloat(item.unitPrice) * 100),
          lineTotal: Math.round(parseFloat(item.quantity) * parseFloat(item.unitPrice) * 100),
          displayOrder: i
        }));
        await db.insert(invoiceItems).values(iItems);
      }

      return Astro.redirect(`/admin/invoices`);
    }
  } catch (e: any) {
    errors.system = e.message;
  }
}

const initialItems = existingItems.map(i => ({
  description: i.description,
  quantity: i.quantity,
  unitPrice: i.unitPrice / 100
}));
---
<AdminLayout title="Edit Invoice" user={user as any}>
  <div class="p-6 max-w-5xl mx-auto pb-24">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div class="flex items-center gap-4">
        <a href="/admin/invoices" class="text-slate-400 hover:text-slate-600"><AdminIcon name="arrow-left" class="w-5 h-5" /></a>
        <h1 class="text-2xl font-bold">Edit Invoice {existingInvoice.invoiceNumber}</h1>
      </div>
      <form method="POST" onsubmit="return confirm('Delete this invoice permanently?');">
        <input type="hidden" name="action" value="delete" />
        <button type="submit" class="px-4 py-2 text-red-600 bg-red-50 hover:bg-red-100 rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          Delete
        </button>
      </form>
    </div>

    {errors.system && <div class="bg-red-50 text-red-600 p-4 rounded-lg mb-6 border border-red-100">{errors.system}</div>}

    <form method="POST" id="invoiceForm" class="bg-white rounded-xl border border-slate-200 p-6 space-y-8">
      
      <!-- Basic Details -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Invoice Number *</label>
          <input type="text" name="invoiceNumber" value={formData.invoiceNumber} required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3]" />
          {errors.invoiceNumber && <p class="text-red-500 text-sm mt-1">{errors.invoiceNumber}</p>}
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Client *</label>
          <select name="clientId" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3]">
            <option value="">Select a client...</option>
            {allClients.map((c) => <option value={c.id} selected={c.id === formData.clientId}>{c.name}</option>)}
          </select>
          {errors.clientId && <p class="text-red-500 text-sm mt-1">{errors.clientId}</p>}
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
          <select name="status" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3]">
            <option value="draft" selected={formData.status === 'draft'}>Draft</option>
            <option value="issued" selected={formData.status === 'issued'}>Issued</option>
            <option value="partially_paid" selected={formData.status === 'partially_paid'}>Partially Paid</option>
            <option value="paid" selected={formData.status === 'paid'}>Paid</option>
            <option value="overdue" selected={formData.status === 'overdue'}>Overdue</option>
            <option value="cancelled" selected={formData.status === 'cancelled'}>Cancelled</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Project (Optional)</label>
          <select name="projectId" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3]">
            <option value="">None</option>
            {allProjects.map((p) => <option value={p.id} selected={p.id === formData.projectId}>{p.name}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">From Quotation (Optional)</label>
          <select name="quotationId" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3]">
            <option value="">None</option>
            {allQuotations.map((q) => <option value={q.id} selected={q.id === formData.quotationId}>{q.quotationNumber}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Currency</label>
          <select name="currency" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3]">
            <option value="USD" selected={formData.currency === 'USD'}>USD</option>
            <option value="BDT" selected={formData.currency === 'BDT'}>BDT</option>
          </select>
        </div>
      </div>

      <!-- Dates & Recurring Billing -->
      <div class="bg-indigo-50/50 p-5 rounded-lg border border-indigo-100 space-y-4">
        <h3 class="font-semibold text-[#192040] flex items-center gap-2">
          <svg class="w-5 h-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Billing & Dates
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Issue Date *</label>
            <input type="date" name="issueDate" value={formData.issueDate} required class="w-full px-3 py-2 border border-slate-300 rounded-lg" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Due Date *</label>
            <input type="date" name="dueDate" value={formData.dueDate} required class="w-full px-3 py-2 border border-slate-300 rounded-lg" />
          </div>
          
          <!-- Recurring Setup -->
          <div class="col-span-1 lg:col-span-2 bg-white p-3 rounded border border-slate-200">
            <label class="flex items-center gap-2 text-sm font-medium text-slate-700 mb-3 cursor-pointer">
              <input type="checkbox" name="isRecurring" id="isRecurringCheck" checked={formData.isRecurring} class="rounded text-[#5568d3] focus:ring-[#5568d3]" />
              Setup Recurring Billing
            </label>
            
            <div id="recurringOptions" class="grid grid-cols-2 gap-3" style={formData.isRecurring ? "" : "display: none;"}>
              <div>
                <label class="block text-xs text-slate-500 mb-1">Billing Cycle</label>
                <select name="billingCycle" class="w-full px-2 py-1.5 text-sm border border-slate-300 rounded-lg focus:ring-1">
                  <option value="none" selected={formData.billingCycle === 'none'}>None</option>
                  <option value="monthly" selected={formData.billingCycle === 'monthly'}>Monthly</option>
                  <option value="quarterly" selected={formData.billingCycle === 'quarterly'}>Quarterly</option>
                  <option value="yearly" selected={formData.billingCycle === 'yearly'}>Yearly</option>
                </select>
              </div>
              <div>
                <label class="block text-xs text-slate-500 mb-1">Next Billing Date</label>
                <input type="date" name="nextBillingDate" value={formData.nextBillingDate} class="w-full px-2 py-1.5 text-sm border border-slate-300 rounded-lg" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Line Items -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold">Line Items</h2>
          <button type="button" id="addItemBtn" class="px-3 py-1.5 bg-slate-100 text-slate-700 hover:bg-slate-200 rounded-lg text-sm font-medium transition-colors">Add Item</button>
        </div>
        
        <div class="border border-slate-200 rounded-lg overflow-hidden">
          <table class="w-full text-left">
            <thead class="bg-slate-50 border-b">
              <tr>
                <th class="p-3 font-medium text-sm text-slate-600">Description</th>
                <th class="p-3 font-medium text-sm text-slate-600 w-24">Qty</th>
                <th class="p-3 font-medium text-sm text-slate-600 w-32">Unit Price</th>
                <th class="p-3 font-medium text-sm text-slate-600 w-32">Total</th>
                <th class="p-3 w-12"></th>
              </tr>
            </thead>
            <tbody id="itemsBody" class="divide-y divide-slate-100">
              <!-- JS rendered rows -->
            </tbody>
          </table>
        </div>
        <input type="hidden" name="itemsJson" id="itemsJson" value={JSON.stringify(initialItems)} />
      </div>

      <!-- Totals & Notes -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Notes / Terms</label>
          <textarea name="notes" rows="5" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#5568d3]">{formData.notes}</textarea>
        </div>

        <div class="bg-slate-50 p-5 rounded-lg border border-slate-200 space-y-3">
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-600">Subtotal</span>
            <span class="font-medium" id="displaySubtotal">0.00</span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-600">Discount (Fixed Amount)</span>
            <input type="number" step="0.01" name="discount" id="inputDiscount" value={formData.discount} class="w-24 px-2 py-1 border rounded text-right" />
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-600">Tax (%)</span>
            <input type="number" step="0.1" name="tax" id="inputTax" value={formData.tax} class="w-24 px-2 py-1 border rounded text-right" />
          </div>
          <div class="flex justify-between items-center pt-3 border-t font-bold text-lg text-slate-900">
            <span>Total</span>
            <span id="displayTotal">0.00</span>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-6 border-t border-slate-100">
        <a href="/admin/invoices" class="px-6 py-2 text-slate-600 hover:bg-slate-50 rounded-lg font-medium transition-colors">Cancel</a>
        <button type="submit" name="action" value="update" class="px-6 py-2 bg-[#5568d3] text-white rounded-lg font-medium hover:bg-[#4557c2] shadow-sm">Save Changes</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script is:inline>
  let items = [];
  
  function renderItems() {
    const tbody = document.getElementById('itemsBody');
    if(!tbody) return;
    tbody.innerHTML = '';
    let subtotal = 0;
    
    items.forEach((item, index) => {
      const lineTotal = item.quantity * item.unitPrice;
      subtotal += lineTotal;
      
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="p-2"><input type="text" class="w-full border border-slate-300 rounded px-2 py-1 item-desc" data-index="${index}" value="${item.description.replace(/"/g, '&quot;')}" required /></td>
        <td class="p-2"><input type="number" step="0.01" class="w-full border border-slate-300 rounded px-2 py-1 item-qty text-right" data-index="${index}" value="${item.quantity}" required /></td>
        <td class="p-2"><input type="number" step="0.01" class="w-full border border-slate-300 rounded px-2 py-1 item-price text-right" data-index="${index}" value="${item.unitPrice}" required /></td>
        <td class="p-2 text-right font-medium text-slate-700">${lineTotal.toFixed(2)}</td>
        <td class="p-2 text-center"><button type="button" class="text-red-500 hover:bg-red-50 p-1 rounded del-btn" data-index="${index}">×</button></td>
      `;
      tbody.appendChild(tr);
    });

    // Update totals
    const elSubtotal = document.getElementById('displaySubtotal');
    if (elSubtotal) elSubtotal.textContent = subtotal.toFixed(2);
    
    const discount = parseFloat(document.getElementById('inputDiscount').value) || 0;
    const taxPercent = parseFloat(document.getElementById('inputTax').value) || 0;
    
    const subAfterDiscount = subtotal - discount;
    const taxAmount = subAfterDiscount * (taxPercent / 100);
    const total = subAfterDiscount + taxAmount;
    
    const elTotal = document.getElementById('displayTotal');
    if (elTotal) elTotal.textContent = total.toFixed(2);
    
    // Update hidden JSON
    const elJson = document.getElementById('itemsJson');
    if (elJson) elJson.value = JSON.stringify(items);
    
    attachEvents();
  }

  function attachEvents() {
    document.querySelectorAll('.item-desc').forEach(el => el.addEventListener('input', (e) => {
      items[e.target.dataset.index].description = e.target.value;
      document.getElementById('itemsJson').value = JSON.stringify(items);
    }));
    document.querySelectorAll('.item-qty').forEach(el => el.addEventListener('input', (e) => {
      items[e.target.dataset.index].quantity = parseFloat(e.target.value) || 0;
      renderItems();
    }));
    document.querySelectorAll('.item-price').forEach(el => el.addEventListener('input', (e) => {
      items[e.target.dataset.index].unitPrice = parseFloat(e.target.value) || 0;
      renderItems();
    }));
    document.querySelectorAll('.del-btn').forEach(el => el.addEventListener('click', (e) => {
      items.splice(e.target.dataset.index, 1);
      renderItems();
    }));
  }

  document.getElementById('addItemBtn')?.addEventListener('click', () => {
    items.push({ description: '', quantity: 1, unitPrice: 0 });
    renderItems();
  });

  document.getElementById('inputDiscount')?.addEventListener('input', renderItems);
  document.getElementById('inputTax')?.addEventListener('input', renderItems);

  document.getElementById('isRecurringCheck')?.addEventListener('change', (e) => {
    const opts = document.getElementById('recurringOptions');
    if (opts) {
      opts.style.display = e.target.checked ? 'grid' : 'none';
    }
  });

  // Init
  const initialJson = document.getElementById('itemsJson')?.value;
  if (initialJson) {
    try {
      items = JSON.parse(initialJson);
    } catch(e) {}
  }
  if (items.length === 0) {
    items.push({ description: '', quantity: 1, unitPrice: 0 });
  }
  renderItems();
</script>


