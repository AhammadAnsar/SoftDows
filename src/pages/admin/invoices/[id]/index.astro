---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../lib/db';
import { invoices, invoiceItems } from '../../../../lib/db/schema/billing';
import { clients } from '../../../../lib/db/schema/crm';
import { projects } from '../../../../lib/db/schema/agency';
import { eq } from 'drizzle-orm';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
requirePermission(user.role as any, 'invoices', 'read');

const { id } = Astro.params;
const db = getDb((env as any).DB);

const invoiceResult = await db.select({
  id: invoices.id,
  invoiceNumber: invoices.invoiceNumber,
  currency: invoices.currency,
  issueDate: invoices.issueDate,
  dueDate: invoices.dueDate,
  status: invoices.status,
  subtotal: invoices.subtotal,
  discount: invoices.discount,
  tax: invoices.tax,
  total: invoices.total,
  amountPaid: invoices.amountPaid,
  balanceDue: invoices.balanceDue,
  notes: invoices.notes,
  clientName: clients.name,
  projectName: projects.name,
}).from(invoices)
  .leftJoin(clients, eq(invoices.clientId, clients.id))
  .leftJoin(projects, eq(invoices.projectId, projects.id))
  .where(eq(invoices.id, id as string));

const invoice = invoiceResult[0];

if (!invoice) {
  return Astro.redirect('/admin/invoices');
}

const items = await db.select().from(invoiceItems).where(eq(invoiceItems.invoiceId, id as string)).orderBy(invoiceItems.displayOrder);
---
<AdminLayout title={`Invoice ${invoice.invoiceNumber}`} user={user as any}>
  <div class="p-6 max-w-4xl mx-auto">
    <div class="flex items-center gap-4 mb-6">
      <a href="/admin/invoices" class="text-slate-400 hover:text-slate-600">
        <AdminIcon name="arrow-left" class="w-5 h-5" />
      </a>
      <h1 class="text-2xl font-bold">Invoice {invoice.invoiceNumber}</h1>
      <div class="ml-auto flex items-center gap-3">
        <a href={`/admin/invoices/${invoice.id}/edit`} class="px-4 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg font-medium hover:bg-slate-50 transition-colors">Edit</a>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden mb-6">
      <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Client</h3>
          <p class="text-base font-medium text-slate-900">{invoice.clientName || 'N/A'}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Project</h3>
          <p class="text-base font-medium text-slate-900">{invoice.projectName || 'N/A'}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Status</h3>
          <p class="text-base font-medium text-slate-900 capitalize">{invoice.status.replace('_', ' ')}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Issue Date</h3>
          <p class="text-base font-medium text-slate-900">{new Date(invoice.issueDate).toLocaleDateString()}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Due Date</h3>
          <p class="text-base font-medium text-slate-900">{new Date(invoice.dueDate).toLocaleDateString()}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-slate-500 mb-1">Notes</h3>
          <p class="text-base text-slate-700 whitespace-pre-wrap">{invoice.notes || '-'}</p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <div class="p-6">
        <h3 class="text-lg font-medium mb-4">Invoice Items</h3>
        <table class="w-full text-left mb-6">
          <thead class="bg-slate-50 border-y border-slate-200 text-sm">
            <tr>
              <th class="py-3 px-4">Description</th>
              <th class="py-3 px-4 text-right">Qty</th>
              <th class="py-3 px-4 text-right">Price</th>
              <th class="py-3 px-4 text-right">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {items.map(item => (
              <tr>
                <td class="py-3 px-4">{item.description}</td>
                <td class="py-3 px-4 text-right">{item.quantity}</td>
                <td class="py-3 px-4 text-right">{(item.unitPrice / 100).toFixed(2)}</td>
                <td class="py-3 px-4 text-right font-medium">{(item.lineTotal / 100).toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="flex justify-end">
          <div class="w-64 space-y-3 text-sm">
            <div class="flex justify-between text-slate-600">
              <span>Subtotal</span>
              <span>{(invoice.subtotal / 100).toFixed(2)} {invoice.currency}</span>
            </div>
            {invoice.discount > 0 && (
              <div class="flex justify-between text-red-600">
                <span>Discount</span>
                <span>-{(invoice.discount / 100).toFixed(2)} {invoice.currency}</span>
              </div>
            )}
            {invoice.tax > 0 && (
              <div class="flex justify-between text-slate-600">
                <span>Tax</span>
                <span>{(invoice.tax / 100).toFixed(2)} {invoice.currency}</span>
              </div>
            )}
            <div class="flex justify-between font-bold text-lg pt-3 border-t border-slate-200 text-slate-900">
              <span>Total</span>
              <span>{(invoice.total / 100).toFixed(2)} {invoice.currency}</span>
            </div>
            <div class="flex justify-between text-slate-600 pt-1">
              <span>Amount Paid</span>
              <span>{(invoice.amountPaid / 100).toFixed(2)} {invoice.currency}</span>
            </div>
            <div class="flex justify-between font-bold pt-1 text-slate-900">
              <span>Balance Due</span>
              <span>{(invoice.balanceDue / 100).toFixed(2)} {invoice.currency}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
