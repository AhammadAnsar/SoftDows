---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminMetricCard from '../../components/admin/AdminMetricCard.astro';
import AdminEmptyState from '../../components/admin/AdminEmptyState.astro';
import { getDashboardMetrics } from '../../lib/admin/dashboard';
import { requirePermission } from '../../lib/auth/authorization';
import type { AppRole } from '../../lib/auth/permissions';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const role = user.role as AppRole;

// Determine what this role is allowed to see
const canSeeLeads = requirePermission(role, 'leads', 'read');
const canSeeClients = requirePermission(role, 'clients', 'read');
const canSeeProjects = requirePermission(role, 'projects', 'read');
const canSeeInvoices = requirePermission(role, 'invoices', 'read');
const canSeeSupport = requirePermission(role, 'support', 'read');

// Only fetch if they have access to at least one metric to save DB calls
const hasAnyDashboardMetric = canSeeLeads || canSeeClients || canSeeProjects || canSeeInvoices || canSeeSupport;

const metrics = hasAnyDashboardMetric 
  ? await getDashboardMetrics(env) 
  : { newLeads: 0, activeClients: 0, activeProjects: 0, unpaidInvoices: 0, openSupportTickets: 0 };

// Calculate total attention items to decide on Empty State
const totalAttentionItems = 
  (canSeeLeads ? metrics.newLeads : 0) + 
  (canSeeInvoices ? metrics.unpaidInvoices : 0) + 
  (canSeeSupport ? metrics.openSupportTickets : 0);

---

<AdminLayout title="Dashboard" user={user}>
  <div class="mb-10">
    <h1 class="text-2xl font-bold text-[#242a56] hidden">Dashboard</h1>
    <h2 class="text-2xl font-bold text-[#242a56]">Welcome back, {user.name.split(' ')[0]}</h2>
    <p class="text-[15px] text-[#64748b] mt-1.5">Here is what's happening at SoftDows today.</p>
  </div>

  {hasAnyDashboardMetric ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {canSeeLeads && (
        <AdminMetricCard 
          label="New Leads" 
          value={metrics.newLeads} 
          icon="users" 
          href={metrics.newLeads > 0 ? "/admin/leads" : undefined}
        />
      )}
      
      {canSeeClients && (
        <AdminMetricCard 
          label="Active Clients" 
          value={metrics.activeClients} 
          icon="briefcase" 
          href="/admin/clients?status=active"
        />
      )}
      
      {canSeeProjects && (
        <AdminMetricCard 
          label="Active Projects" 
          value={metrics.activeProjects} 
          icon="folder" 
          href={metrics.activeProjects > 0 ? "/admin/projects" : undefined}
        />
      )}

      {canSeeInvoices && (
        <AdminMetricCard 
          label="Unpaid Invoices" 
          value={metrics.unpaidInvoices} 
          icon="receipt" 
          href={metrics.unpaidInvoices > 0 ? "/admin/invoices" : undefined}
        />
      )}

      {canSeeSupport && (
        <AdminMetricCard 
          label="Open Tickets" 
          value={metrics.openSupportTickets} 
          icon="life-buoy" 
          href={metrics.openSupportTickets > 0 ? "/admin/support" : undefined}
        />
      )}
    </div>
  ) : (
    <div class="mb-12">
      <AdminEmptyState 
        title="Your workspace is ready"
        description="Select an option from the sidebar to begin managing your modules."
        icon="layout"
      />
    </div>
  )}

  <!-- Needs Attention Area -->
  <div class="mb-8 max-w-3xl">
    <h3 class="text-lg font-bold text-[#242a56] mb-5">Requires Attention</h3>
    
    {totalAttentionItems > 0 ? (
      <div class="bg-white rounded-xl border border-[#e2e8f0] shadow-sm overflow-hidden">
        <ul class="divide-y divide-[#f1f5f9]">
          {canSeeLeads && metrics.newLeads > 0 && (
            <li class="p-5 flex items-center justify-between hover:bg-[#f8fafc] transition-colors">
              <div class="flex items-center gap-4">
                <div class="w-2.5 h-2.5 rounded-full bg-[#6878d6]"></div>
                <p class="text-[15px] font-medium text-[#242a56]">You have {metrics.newLeads} new lead{metrics.newLeads > 1 ? 's' : ''} to review.</p>
              </div>
              <a href="/admin/leads" class="text-sm text-[#6878d6] font-semibold hover:text-[#242a56] transition-colors">View leads</a>
            </li>
          )}
          {canSeeSupport && metrics.openSupportTickets > 0 && (
            <li class="p-5 flex items-center justify-between hover:bg-[#f8fafc] transition-colors">
              <div class="flex items-center gap-4">
                <div class="w-2.5 h-2.5 rounded-full bg-orange-500"></div>
                <p class="text-[15px] font-medium text-[#242a56]">{metrics.openSupportTickets} support ticket{metrics.openSupportTickets > 1 ? 's are' : ' is'} open.</p>
              </div>
              <a href="/admin/support" class="text-sm text-[#6878d6] font-semibold hover:text-[#242a56] transition-colors">View tickets</a>
            </li>
          )}
          {canSeeInvoices && metrics.unpaidInvoices > 0 && (
            <li class="p-5 flex items-center justify-between hover:bg-[#f8fafc] transition-colors">
              <div class="flex items-center gap-4">
                <div class="w-2.5 h-2.5 rounded-full bg-red-500"></div>
                <p class="text-[15px] font-medium text-[#242a56]">{metrics.unpaidInvoices} invoice{metrics.unpaidInvoices > 1 ? 's are' : ' is'} unpaid or overdue.</p>
              </div>
              <a href="/admin/invoices" class="text-sm text-[#6878d6] font-semibold hover:text-[#242a56] transition-colors">View invoices</a>
            </li>
          )}
        </ul>
      </div>
    ) : (
      <AdminEmptyState 
        title="All caught up!"
        description="Nothing needs your immediate attention right now."
        icon="activity"
      />
    )}
  </div>

</AdminLayout>



