---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db';
import { supportTickets } from '../../../lib/db/schema/support';
import { clients } from '../../../lib/db/schema/crm';
import { user as userTable } from '../../../lib/db/schema/auth';
import { eq, like, desc, or, and } from 'drizzle-orm';
import type { SQL } from 'drizzle-orm';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import type { BadgeVariant } from '../../../components/admin/StatusBadge.astro';
import { requirePermission } from '../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';

const user_ = Astro.locals.user;
if (!user_) return Astro.redirect('/login');
requirePermission(user_.role as any, 'support', 'read');

const db = getDb((env as any).DB);

const searchParams = Astro.url.searchParams;
const query = searchParams.get('q') || '';
const statusFilter = searchParams.get('status') || '';
const priorityFilter = searchParams.get('priority') || '';
const page = parseInt(searchParams.get('page') || '1') || 1;
const limit = 25;
const offset = (page - 1) * limit;

const filters: SQL[] = [];
if (statusFilter && statusFilter !== 'all') {
  filters.push(eq(supportTickets.status, statusFilter as any));
}
if (priorityFilter && priorityFilter !== 'all') {
  filters.push(eq(supportTickets.priority, priorityFilter as any));
}
if (query) {
  const searchCondition = like(supportTickets.subject, `%${query}%`);
  filters.push(searchCondition);
}

const where = filters.length > 0 ? and(...filters) : undefined;

const ticketsList = await db
  .select({
    ticket: supportTickets,
    client: clients,
    assignee: userTable
  })
  .from(supportTickets)
  .leftJoin(clients, eq(supportTickets.clientId, clients.id))
  .leftJoin(userTable, eq(supportTickets.assignedToId, userTable.id))
  .where(where)
  .orderBy(desc(supportTickets.createdAt))
  .limit(limit)
  .offset(offset);

const priorityVariant: Record<string, BadgeVariant> = {
  low: 'neutral', medium: 'info', high: 'warning', urgent: 'danger'
};
const statusVariant: Record<string, BadgeVariant> = {
  open: 'info', in_progress: 'warning', waiting_for_client: 'neutral', resolved: 'success', closed: 'neutral'
};

const formatText = (s: string) => s.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
---

<AdminLayout title="Support Tickets" user={user_}>
  <div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto">
    
    <!-- Header -->
    <div class="sm:flex sm:items-center sm:justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-[#242a56]">Support Tickets</h1>
        <p class="mt-1 text-sm text-[#64748b]">Manage and respond to client support requests.</p>
      </div>
      <div class="mt-4 sm:mt-0">
        <a href="#new-ticket-modal" class="inline-flex items-center justify-center px-4 py-2 bg-[#242a56] hover:bg-[#1a1e3e] text-white text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#242a56] gap-2">
          <AdminIcon name="plus" class="w-4 h-4" />
          New Ticket
        </a>
      </div>
    </div>

    <!-- Filters & Search -->
    <div class="bg-white p-4 rounded-xl shadow-sm border border-[#e2e8f0] mb-6 flex flex-col sm:flex-row gap-4 justify-between items-center">
      <form class="flex flex-col sm:flex-row w-full sm:w-auto gap-3" method="GET" action="/admin/support">
        <input type="hidden" name="status" value={statusFilter} class="hidden sm:block" disabled />
        
        <div class="relative w-full sm:w-64">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <AdminIcon name="search" class="w-4 h-4" />
          </div>
          <input 
            type="text" 
            name="q" 
            value={query}
            placeholder="Search subject..." 
            class="block w-full pl-9 pr-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-[#6878d6] focus:border-[#6878d6]"
          />
        </div>
        
        <!-- Mobile Status Select -->
        <select 
          name="status" 
          class="block sm:hidden w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-[#6878d6] focus:border-[#6878d6] appearance-none"
          onchange="this.form.submit()"
        >
          {['all', 'open', 'in_progress', 'waiting_for_client', 'resolved', 'closed'].map(s => (
            <option value={s === 'all' ? '' : s} selected={(statusFilter === s) || (!statusFilter && s === 'all')}>
              {s === 'all' ? 'All Statuses' : formatText(s)}
            </option>
          ))}
        </select>
        
        <select 
          name="priority" 
          class="w-full sm:w-auto px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-[#6878d6] focus:border-[#6878d6]"
          onchange="this.form.submit()"
        >
          <option value="">All Priorities</option>
          {['low', 'medium', 'high', 'urgent'].map(p => (
            <option value={p} selected={priorityFilter === p}>{formatText(p)}</option>
          ))}
        </select>

        <button type="submit" class="hidden sm:block px-4 py-2 bg-[#f1f5f9] hover:bg-[#e2e8f0] text-[#242a56] text-sm font-medium rounded-lg transition-colors">
          Search
        </button>
        <button type="submit" class="block sm:hidden w-full px-4 py-2 bg-[#242a56] text-white text-sm font-medium rounded-lg transition-colors">
          Search
        </button>
      </form>
      
      <!-- Desktop Status Pills -->
      <div class="hidden sm:flex w-full sm:w-auto gap-2 flex-wrap">
        {['all', 'open', 'in_progress', 'waiting_for_client', 'resolved', 'closed'].map((s) => {
          const isActive = (statusFilter === s) || (!statusFilter && s === 'all');
          const url = new URL(Astro.url);
          url.searchParams.set('status', s === 'all' ? '' : s);
          url.searchParams.set('page', '1');
          return (
            <a 
              href={url.toString()}
              class:list={[
                "whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-semibold border transition-colors",
                isActive ? "bg-[#242a56] text-white border-[#242a56]" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50"
              ]}
            >
              {formatText(s)}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Tickets List -->
    <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
      {ticketsList.length > 0 ? (
        <div>
          <!-- Mobile Cards Layout -->
          <div class="block sm:hidden divide-y divide-[#e2e8f0]">
            {ticketsList.map(({ ticket, client, assignee }) => (
              <div class="p-4 hover:bg-[#f8fafc] transition-colors">
                <div class="flex justify-between items-start mb-2">
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-mono font-medium text-slate-500">{ticket.ticketNumber}</span>
                      <StatusBadge label={formatText(ticket.priority)} variant={priorityVariant[ticket.priority] || 'neutral'} />
                    </div>
                    <h3 class="text-sm font-bold text-[#242a56]">{ticket.subject}</h3>
                    {client && (
                      <p class="text-xs text-[#64748b] mt-1">{client.name}</p>
                    )}
                  </div>
                  <StatusBadge label={formatText(ticket.status)} variant={statusVariant[ticket.status] || 'neutral'} />
                </div>
                
                <div class="mt-2 text-xs text-slate-600">
                  Assignee: {assignee ? assignee.name : <span class="italic text-slate-400">Unassigned</span>}
                </div>
                
                <div class="mt-3 flex justify-between items-center border-t border-slate-100 pt-3">
                  <p class="text-[10px] text-slate-400">
                    Created {ticket.createdAt ? new Date(ticket.createdAt).toLocaleDateString() : 'Unknown'}
                  </p>
                  <a href={`/admin/support/${ticket.id}`} class="text-xs font-medium text-[#6878d6]">
                    View Ticket &rarr;
                  </a>
                </div>
              </div>
            ))}
          </div>

          <!-- Desktop Table Layout -->
          <div class="hidden sm:block overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-[#f8fafc] border-b border-[#e2e8f0]">
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Ticket</th>
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Client</th>
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Status & Priority</th>
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Assignee</th>
                  <th class="px-6 py-4 text-xs font-bold text-[#64748b] uppercase tracking-wider">Created</th>
                  <th class="px-6 py-4 text-right"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#e2e8f0]">
                {ticketsList.map(({ ticket, client, assignee }) => (
                  <tr class="hover:bg-[#f8fafc] transition-colors group">
                    <td class="px-6 py-4 align-top">
                      <div class="text-xs font-mono font-medium text-slate-500 mb-1">{ticket.ticketNumber}</div>
                      <p class="text-sm font-bold text-[#242a56]">{ticket.subject}</p>
                    </td>
                    <td class="px-6 py-4 align-top">
                      {client ? (
                        <p class="text-sm text-slate-700 font-medium">{client.name}</p>
                      ) : (
                        <p class="text-xs text-slate-400 italic">Unknown</p>
                      )}
                    </td>
                    <td class="px-6 py-4 align-top">
                      <div class="flex flex-col gap-2 items-start">
                        <StatusBadge label={formatText(ticket.status)} variant={statusVariant[ticket.status] || 'neutral'} />
                        <StatusBadge label={formatText(ticket.priority)} variant={priorityVariant[ticket.priority] || 'neutral'} />
                      </div>
                    </td>
                    <td class="px-6 py-4 align-top">
                      <p class="text-sm text-slate-600">
                        {assignee ? assignee.name : <span class="italic text-slate-400">Unassigned</span>}
                      </p>
                    </td>
                    <td class="px-6 py-4 align-top">
                      <p class="text-sm text-slate-600">
                        {ticket.createdAt ? new Date(ticket.createdAt).toLocaleDateString() : 'Unknown'}
                      </p>
                    </td>
                    <td class="px-6 py-4 align-top text-right">
                      <a href={`/admin/support/${ticket.id}`} class="inline-flex items-center justify-center p-2 rounded-lg text-[#6878d6] hover:bg-[#eff2ff] hover:text-[#242a56] transition-colors font-medium text-sm">
                        View
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ) : (
        <div class="px-6 py-16 text-center">
          <div class="w-12 h-12 bg-slate-50 rounded-lg flex items-center justify-center mx-auto mb-4 border border-slate-200">
            <AdminIcon name="lifebuoy" class="w-6 h-6 text-slate-400" />
          </div>
          <h3 class="text-sm font-bold text-[#242a56]">No tickets found</h3>
          <p class="text-sm text-slate-500 mt-1 max-w-sm mx-auto">
            {query || statusFilter || priorityFilter ? 'Try adjusting your filters or search terms.' : 'Support tickets will appear here when created.'}
          </p>
          {(query || statusFilter || priorityFilter) && (
            <a href="/admin/support" class="mt-4 inline-flex items-center text-sm font-medium text-[#6878d6] hover:text-[#242a56]">
              Clear filters
            </a>
          )}
        </div>
      )}
    </div>
    
  </div>
</AdminLayout>
