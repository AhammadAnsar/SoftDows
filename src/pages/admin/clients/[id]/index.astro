---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../lib/db';
import { clients, clientContacts, leads } from '../../../../lib/db/schema/crm';
import { projects } from '../../../../lib/db/schema/agency';
import { invoices, quotations, payments } from '../../../../lib/db/schema/billing';
import { eq, desc } from 'drizzle-orm';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';
import StatusBadge from '../../../../components/admin/StatusBadge.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
requirePermission(user.role as any, 'clients', 'read');
const canEdit = requirePermission(user.role as any, 'clients', 'update');

const db = getDb((env as any).DB);
const { id } = Astro.params;

if (!id) return Astro.redirect('/admin/clients');

const clientResult = await db.select().from(clients).where(eq(clients.id, id)).limit(1);
const client = clientResult[0];

if (!client) return new Response('Client not found', { status: 404 });

const contacts = await db.select().from(clientContacts).where(eq(clientContacts.clientId, id)).orderBy(desc(clientContacts.isPrimary));
const primaryContact = contacts.find(c => c.isPrimary);
const additionalContacts = contacts.filter(c => !c.isPrimary);

const relatedLeads = await db.select().from(leads).where(eq(leads.convertedClientId, id)).orderBy(desc(leads.createdAt));
const relatedProjects = await db.select().from(projects).where(eq(projects.clientId, id)).orderBy(desc(projects.createdAt));
const relatedInvoices = await db.select().from(invoices).where(eq(invoices.clientId, id)).orderBy(desc(invoices.issueDate));
const relatedQuotations = await db.select().from(quotations).where(eq(quotations.clientId, id)).orderBy(desc(quotations.issueDate));
const relatedPayments = await db.select().from(payments).where(eq(payments.clientId, id)).orderBy(desc(payments.paymentDate));

const statusColors: Record<string, string> = {
  active: 'bg-green-50 text-green-700 border-green-200',
  inactive: 'bg-yellow-50 text-yellow-700 border-yellow-200',
  archived: 'bg-slate-100 text-slate-600 border-slate-200'
};

const formatStatus = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

let actionError = '';
let actionSuccess = '';

if (Astro.request.method === 'POST' && canEdit) {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action')?.toString();
    const contactId = data.get('contactId')?.toString();

    if (action === 'set_primary' && contactId) {
      await db.update(clientContacts).set({ isPrimary: false }).where(eq(clientContacts.clientId, id));
      await db.update(clientContacts).set({ isPrimary: true }).where(eq(clientContacts.id, contactId));
      actionSuccess = 'Primary contact updated.';
    } else if (action === 'delete_contact' && contactId) {
      await db.delete(clientContacts).where(eq(clientContacts.id, contactId));
      actionSuccess = 'Contact removed.';
    }
    return Astro.redirect(`/admin/clients/${id}`);
  } catch (e: any) {
    actionError = e.message;
  }
}
---
<AdminLayout title={`Client: ${client.name}`} user={user as any}>
  <div class="p-6 max-w-7xl mx-auto pb-24 space-y-6">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <a href="/admin/clients" class="text-slate-400 hover:text-slate-600">
            <AdminIcon name="arrow-left" class="w-5 h-5" />
          </a>
          <h1 class="text-2xl font-bold text-[#192040]">{client.name}</h1>
          <span class={`px-2.5 py-1 rounded-full text-xs font-bold border ${statusColors[client.status] || statusColors.inactive}`}>
            {formatStatus(client.status)}
          </span>
        </div>
        <p class="text-slate-500 text-sm ml-8">Client since {new Date(client.createdAt).toLocaleDateString()}</p>
      </div>
      <div class="flex items-center gap-3">
        {canEdit && (
          <a href={`/admin/clients/${client.id}/edit`} class="px-4 py-2 bg-white border border-slate-200 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors shadow-sm flex items-center gap-2">
            <AdminIcon name="edit" class="w-4 h-4" />
            Edit Client
          </a>
        )}
      </div>
    </div>

    {actionError && (
      <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 font-medium text-sm">
        {actionError}
      </div>
    )}
    {actionSuccess && (
      <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-green-700 font-medium text-sm">
        {actionSuccess}
      </div>
    )}

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- Main Content -->
      <div class="xl:col-span-2 space-y-6 lg:space-y-8">
        
        <!-- Primary Contact -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc] flex justify-between items-center">
            <h2 class="text-base font-bold text-[#242a56] flex items-center gap-2">
              <AdminIcon name="users" class="w-5 h-5 text-[#5568d3]" />
              Contacts
            </h2>
          </div>
          {primaryContact ? (
            <div class="p-6 grid grid-cols-1 sm:grid-cols-3 gap-6 bg-indigo-50/30">
              <div>
                <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Primary Contact</p>
                <p class="text-sm text-[#242a56] font-medium">{primaryContact.firstName} {primaryContact.lastName}</p>
              </div>
              <div>
                <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Email</p>
                <a href={`mailto:${primaryContact.email}`} class="text-sm text-[#5568d3] font-medium hover:underline">{primaryContact.email}</a>
              </div>
              <div>
                <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Phone</p>
                {primaryContact.phone ? (
                  <a href={`tel:${primaryContact.phone}`} class="text-sm text-[#5568d3] font-medium hover:underline">{primaryContact.phone}</a>
                ) : (
                  <span class="text-sm text-slate-400 italic">Not provided</span>
                )}
              </div>
            </div>
          ) : (
            <div class="p-6 text-sm text-slate-500 italic">No primary contact assigned.</div>
          )}
          
          <!-- Additional Contacts -->
          {additionalContacts.length > 0 && (
            <div class="divide-y divide-slate-100 border-t border-slate-100">
              {additionalContacts.map(contact => (
                <div class="p-4 sm:px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <h3 class="text-sm font-bold text-[#242a56]">{contact.firstName} {contact.lastName}</h3>
                    <div class="flex gap-4 mt-1">
                      <a href={`mailto:${contact.email}`} class="text-xs text-[#5568d3] hover:underline">{contact.email}</a>
                      {contact.phone && (
                        <a href={`tel:${contact.phone}`} class="text-xs text-slate-500 hover:underline">{contact.phone}</a>
                      )}
                    </div>
                  </div>
                  {canEdit && (
                    <div class="flex items-center gap-2">
                      <form method="POST">
                        <input type="hidden" name="action" value="set_primary" />
                        <input type="hidden" name="contactId" value={contact.id} />
                        <button type="submit" class="px-3 py-1.5 bg-slate-50 hover:bg-slate-100 text-[#242a56] text-xs font-medium rounded-lg border border-slate-200 transition-colors">Set Primary</button>
                      </form>
                      <form method="POST" onsubmit="return confirm('Remove this contact?');">
                        <input type="hidden" name="action" value="delete_contact" />
                        <input type="hidden" name="contactId" value={contact.id} />
                        <button type="submit" class="p-1.5 text-red-500 hover:bg-red-50 rounded-lg transition-colors"><AdminIcon name="trash" class="w-4 h-4" /></button>
                      </form>
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Invoices & Billing -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc] flex justify-between items-center">
            <h2 class="text-base font-bold text-[#242a56]">Invoices & Billing</h2>
            <a href={`/admin/invoices/new?clientId=${client.id}`} class="text-[#5568d3] hover:underline text-sm font-medium">+ New Invoice</a>
          </div>
          {relatedInvoices.length > 0 ? (
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-slate-50 border-b border-slate-100">
                  <tr>
                    <th class="px-6 py-3 text-xs font-bold text-slate-500 uppercase">Invoice</th>
                    <th class="px-6 py-3 text-xs font-bold text-slate-500 uppercase">Amount</th>
                    <th class="px-6 py-3 text-xs font-bold text-slate-500 uppercase">Status</th>
                    <th class="px-6 py-3 text-xs font-bold text-slate-500 uppercase">Due Date</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {relatedInvoices.map(inv => (
                    <tr class="hover:bg-slate-50">
                      <td class="px-6 py-3">
                        <a href={`/admin/invoices/${inv.id}/edit`} class="text-[#5568d3] font-medium hover:underline">{inv.invoiceNumber}</a>
                      </td>
                      <td class="px-6 py-3 font-medium text-slate-700">
                        {inv.currency} {(inv.total / 100).toFixed(2)}
                      </td>
                      <td class="px-6 py-3">
                        <span class="text-xs font-bold uppercase px-2 py-1 bg-slate-100 rounded text-slate-600">{inv.status}</span>
                      </td>
                      <td class="px-6 py-3 text-sm text-slate-500">
                        {new Date(inv.dueDate).toLocaleDateString()}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="p-6 text-sm text-slate-500 italic">No invoices found.</div>
          )}
        </div>

        <!-- Projects -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc] flex justify-between items-center">
            <h2 class="text-base font-bold text-[#242a56]">Projects</h2>
            <a href={`/admin/projects/new?clientId=${client.id}`} class="text-[#5568d3] hover:underline text-sm font-medium">+ New Project</a>
          </div>
          {relatedProjects.length > 0 ? (
            <div class="divide-y divide-slate-100">
              {relatedProjects.map(proj => (
                <div class="p-4 px-6 flex items-center justify-between hover:bg-slate-50">
                  <div>
                    <a href={`/admin/projects/${proj.id}`} class="text-sm font-bold text-[#242a56] hover:text-[#5568d3]">{proj.name}</a>
                  </div>
                  <StatusBadge variant={proj.status === 'completed' ? 'success' : proj.status === 'active' ? 'info' : 'neutral'} size="sm">
                    {proj.status}
                  </StatusBadge>
                </div>
              ))}
            </div>
          ) : (
            <div class="p-6 text-sm text-slate-500 italic">No projects found.</div>
          )}
        </div>

      </div>

      <!-- Sidebar Content -->
      <div class="space-y-6 lg:space-y-8">
        
        <!-- Quotations -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc] flex justify-between items-center">
            <h2 class="text-base font-bold text-[#242a56]">Quotations</h2>
            <a href={`/admin/quotations/new?clientId=${client.id}`} class="text-[#5568d3] hover:underline text-sm font-medium">+ Add</a>
          </div>
          {relatedQuotations.length > 0 ? (
            <div class="divide-y divide-slate-100">
              {relatedQuotations.map(quote => (
                <div class="p-4 flex items-center justify-between hover:bg-slate-50">
                  <div>
                    <a href={`/admin/quotations/${quote.id}/edit`} class="text-sm font-bold text-[#6878d6] hover:underline">{quote.quotationNumber}</a>
                    <p class="text-xs text-slate-500 mt-0.5">{quote.currency} {(quote.total / 100).toFixed(2)}</p>
                  </div>
                  <span class="text-xs font-medium px-2 py-1 rounded bg-slate-100 text-slate-600 uppercase">{quote.status}</span>
                </div>
              ))}
            </div>
          ) : (
            <div class="p-4 text-sm text-slate-500 italic">No quotations.</div>
          )}
        </div>

        <!-- Leads / Enquiries -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
            <h2 class="text-base font-bold text-[#242a56]">Originating Enquiries</h2>
          </div>
          {relatedLeads.length > 0 ? (
            <div class="divide-y divide-slate-100">
              {relatedLeads.map(lead => (
                <div class="p-4 flex items-center justify-between hover:bg-slate-50 transition-colors">
                  <div>
                    <a href={`/admin/leads/${lead.id}`} class="text-sm font-bold text-[#6878d6] hover:underline">
                      {lead.requestedService || 'General Enquiry'}
                    </a>
                    <p class="text-xs text-slate-500 mt-0.5">
                      {lead.createdAt ? new Date(lead.createdAt).toLocaleDateString() : 'Unknown date'}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="p-4 text-sm text-slate-500 italic">No associated leads found.</div>
          )}
        </div>

        <!-- Internal Notes -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
            <h2 class="text-base font-bold text-[#242a56]">Internal Notes</h2>
          </div>
          <div class="p-6">
            {client.notes ? (
              <div class="text-sm text-[#334155] whitespace-pre-wrap">{client.notes}</div>
            ) : (
              <p class="text-sm text-slate-400 italic">No notes added.</p>
            )}
          </div>
        </div>

      </div>
      
    </div>
  </div>
</AdminLayout>
