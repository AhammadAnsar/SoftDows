---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../lib/db';
import { clients, clientContacts, leads } from '../../../../lib/db/schema/crm';
import { eq, desc } from 'drizzle-orm';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import { requirePermission } from '../../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
requirePermission(user.role as any, 'clients', 'read');
const canEdit = requirePermission(user.role as any, 'clients', 'update');

const db = getDb((env as any).DB);
const { id } = Astro.params;

if (!id) return Astro.redirect('/admin/clients');

const clientResult = await db.select().from(clients).where(eq(clients.id, id)).limit(1);
const client = clientResult[0];

if (!client) return new Response('Client not found', { status: 404 });

const contacts = await db.select().from(clientContacts).where(eq(clientContacts.clientId, id)).orderBy(desc(clientContacts.isPrimary));
const primaryContact = contacts.find(c => c.isPrimary);
const additionalContacts = contacts.filter(c => !c.isPrimary);

const relatedLeads = await db.select().from(leads).where(eq(leads.convertedClientId, id)).orderBy(desc(leads.createdAt));

const statusColors: Record<string, string> = {
  active: 'bg-green-50 text-green-700 border-green-200',
  inactive: 'bg-yellow-50 text-yellow-700 border-yellow-200',
  archived: 'bg-slate-100 text-slate-600 border-slate-200'
};

const formatStatus = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Handle POST actions for contacts (e.g. set primary, delete)
let actionError = '';
let actionSuccess = '';

if (Astro.request.method === 'POST' && canEdit) {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action')?.toString();
    const contactId = data.get('contactId')?.toString();

    if (action === 'set_primary' && contactId) {
      // Begin transaction manually if supported or via batch
      // 1. Set all to non-primary
      // 2. Set chosen to primary
      await db.batch([
        db.update(clientContacts).set({ isPrimary: false }).where(eq(clientContacts.clientId, id)),
        db.update(clientContacts).set({ isPrimary: true }).where(eq(clientContacts.id, contactId))
      ]);
      actionSuccess = 'Primary contact updated.';
      return Astro.redirect(`/admin/clients/${id}`);
    } else if (action === 'delete_contact' && contactId) {
      if (contacts.length === 1) {
        actionError = 'Cannot remove the only contact for a client.';
      } else {
        const contactToDelete = contacts.find(c => c.id === contactId);
        if (contactToDelete?.isPrimary) {
          actionError = 'Cannot remove the primary contact. Set another contact as primary first.';
        } else if (contactToDelete?.userId) {
          actionError = 'Cannot remove a contact linked to a Portal account.';
        } else {
          await db.delete(clientContacts).where(eq(clientContacts.id, contactId));
          actionSuccess = 'Contact removed.';
          return Astro.redirect(`/admin/clients/${id}`);
        }
      }
    }
  } catch (err) {
    console.error(err);
    actionError = 'An error occurred processing your request.';
  }
}

---

<AdminLayout title={`Client: ${client.name}`} user={user}>
  <div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <a href="/admin/clients" class="inline-flex items-center text-sm font-medium text-[#64748b] hover:text-[#242a56] transition-colors mb-2">
          <AdminIcon name="chevron-left" class="w-4 h-4 mr-1" />
          Back to Clients
        </a>
        <h1 class="text-2xl font-bold text-[#242a56] flex items-center gap-3">
          {client.name}
          <span class={`text-xs px-2.5 py-1 rounded-full border ${statusColors[client.status] || statusColors['active']}`}>
            {formatStatus(client.status)}
          </span>
        </h1>
        <p class="mt-1 text-sm text-[#64748b]">
          Added on {client.createdAt ? new Date(client.createdAt).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : 'Not provided'}
        </p>
      </div>
      <div class="flex gap-3">
        {canEdit && (
          <a href={`/admin/clients/${client.id}/edit`} class="inline-flex items-center px-4 py-2 bg-white border border-[#242a56] text-[#242a56] hover:bg-slate-50 font-medium rounded-lg text-sm transition-colors shadow-sm">
            <AdminIcon name="settings" class="w-4 h-4 mr-2" />
            Edit Client Info
          </a>
        )}
      </div>
    </div>

    {actionError && (
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-600 font-medium text-sm">
        {actionError}
      </div>
    )}
    {actionSuccess && (
      <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700 font-medium text-sm">
        {actionSuccess}
      </div>
    )}

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- Main Content (Contacts & Leads) -->
      <div class="xl:col-span-2 space-y-6 lg:space-y-8">
        
        <!-- Primary Contact -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc] flex justify-between items-center">
            <h2 class="text-base font-bold text-[#242a56] flex items-center gap-2">
              <AdminIcon name="users" class="w-5 h-5 text-slate-400" />
              Primary Contact
            </h2>
          </div>
          {primaryContact ? (
            <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Name</p>
                <p class="text-sm text-[#242a56] font-medium">{primaryContact.firstName} {primaryContact.lastName}</p>
              </div>
              <div>
                <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Email</p>
                <a href={`mailto:${primaryContact.email}`} class="text-sm text-[#6878d6] font-medium hover:underline">{primaryContact.email}</a>
              </div>
              <div>
                <p class="text-xs font-bold text-[#8a96d1] uppercase tracking-wider mb-1">Phone</p>
                {primaryContact.phone ? (
                  <a href={`tel:${primaryContact.phone}`} class="text-sm text-[#6878d6] font-medium hover:underline">{primaryContact.phone}</a>
                ) : (
                  <span class="text-sm text-slate-400 italic">Not provided</span>
                )}
              </div>
            </div>
          ) : (
            <div class="p-6 text-sm text-slate-500 italic">No primary contact assigned.</div>
          )}
        </div>

        <!-- Additional Contacts -->
        {additionalContacts.length > 0 && (
          <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
            <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
              <h2 class="text-base font-bold text-[#242a56]">Additional Contacts</h2>
            </div>
            <div class="divide-y divide-slate-100">
              {additionalContacts.map(contact => (
                <div class="p-4 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <h3 class="text-sm font-bold text-[#242a56]">{contact.firstName} {contact.lastName}</h3>
                    <div class="flex gap-4 mt-1">
                      <a href={`mailto:${contact.email}`} class="text-xs text-[#6878d6] hover:underline">{contact.email}</a>
                      {contact.phone && (
                        <a href={`tel:${contact.phone}`} class="text-xs text-slate-500 hover:underline">{contact.phone}</a>
                      )}
                    </div>
                  </div>
                  {canEdit && (
                    <div class="flex items-center gap-2">
                      <form method="POST">
                        <input type="hidden" name="action" value="set_primary" />
                        <input type="hidden" name="contactId" value={contact.id} />
                        <button type="submit" class="px-3 py-1.5 bg-slate-50 hover:bg-slate-100 text-[#242a56] text-xs font-medium rounded-lg border border-slate-200 transition-colors">
                          Set Primary
                        </button>
                      </form>
                      <form method="POST" onsubmit="return confirm('Are you sure you want to remove this contact?');">
                        <input type="hidden" name="action" value="delete_contact" />
                        <input type="hidden" name="contactId" value={contact.id} />
                        <button type="submit" class="p-1.5 text-red-500 hover:bg-red-50 rounded-lg transition-colors" title="Remove Contact">
                          <AdminIcon name="trash" class="w-4 h-4" />
                        </button>
                      </form>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Add Contact Button */}
        {canEdit && (
          <div class="flex justify-center">
             <!-- Simplified Add Contact without full separate page, linking to future enhancement or a small modal -->
             <button disabled class="inline-flex items-center px-4 py-2 bg-slate-50 text-slate-400 font-medium rounded-lg text-sm border border-slate-200 cursor-not-allowed" title="UI to add contacts can be implemented as needed">
               <AdminIcon name="plus" class="w-4 h-4 mr-2" />
               Add Contact
             </button>
          </div>
        )}

        <!-- Related Leads -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
            <h2 class="text-base font-bold text-[#242a56]">Related Enquiries (Leads)</h2>
          </div>
          {relatedLeads.length > 0 ? (
            <div class="divide-y divide-slate-100">
              {relatedLeads.map(lead => (
                <div class="p-4 flex items-center justify-between hover:bg-slate-50 transition-colors">
                  <div>
                    <a href={`/admin/leads/${lead.id}`} class="text-sm font-bold text-[#6878d6] hover:underline">
                      {lead.requestedService || 'General Enquiry'}
                    </a>
                    <p class="text-xs text-slate-500 mt-0.5">
                      {lead.createdAt ? new Date(lead.createdAt).toLocaleDateString() : 'Unknown date'}
                    </p>
                  </div>
                  <span class="text-xs font-medium px-2 py-1 rounded bg-slate-100 text-slate-600">
                    {lead.status.replace('_', ' ').toUpperCase()}
                  </span>
                </div>
              ))}
            </div>
          ) : (
            <div class="p-6 text-sm text-slate-500 italic">No associated leads found.</div>
          )}
        </div>

      </div>

      <!-- Sidebar Content -->
      <div class="space-y-6 lg:space-y-8">
        
        <!-- Internal Notes -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
            <h2 class="text-base font-bold text-[#242a56]">Internal Notes</h2>
          </div>
          <div class="p-6">
            {client.notes ? (
              <div class="text-sm text-[#334155] whitespace-pre-wrap">{client.notes}</div>
            ) : (
              <p class="text-sm text-slate-400 italic">No notes added for this client.</p>
            )}
          </div>
        </div>

        <!-- Portal Account Info -->
        <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
          <div class="px-6 py-4 border-b border-[#e2e8f0] bg-[#f8fafc]">
            <h2 class="text-base font-bold text-[#242a56]">Client Portal</h2>
          </div>
          <div class="p-6">
            <p class="text-sm text-slate-500 mb-4">
              Client portal access and invitations are managed in a separate module (Upcoming Phase).
            </p>
            <button disabled class="w-full inline-flex items-center justify-center px-4 py-2 bg-slate-100 text-slate-400 font-medium rounded-lg text-sm cursor-not-allowed">
              Invite to Portal
            </button>
          </div>
        </div>

      </div>
      
    </div>
  </div>
</AdminLayout>


