---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db';
import { clients, clientContacts } from '../../../lib/db/schema/crm';
import { auditLogs } from '../../../lib/db/schema/audit';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { requirePermission } from '../../../lib/auth/authorization';
import { env } from 'cloudflare:workers';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
requirePermission(user.role as any, 'clients', 'create');

let errors: Record<string, string> = {};
let formData = {
  clientName: '',
  contactFirstName: '',
  contactLastName: '',
  email: '',
  phone: '',
  status: 'active',
  internalNotes: ''
};

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    
    formData = {
      clientName: data.get('clientName')?.toString().trim() || '',
      contactFirstName: data.get('contactFirstName')?.toString().trim() || '',
      contactLastName: data.get('contactLastName')?.toString().trim() || '',
      email: data.get('email')?.toString().trim() || '',
      phone: data.get('phone')?.toString().trim() || '',
      status: data.get('status')?.toString().trim() || 'active',
      internalNotes: data.get('internalNotes')?.toString().trim() || ''
    };

    if (!formData.clientName) errors.clientName = 'Client/Business name is required.';
    if (!formData.contactFirstName) errors.contactFirstName = 'Contact name is required.';
    
    // Status validation
    const VALID_STATUSES = ['active', 'inactive', 'archived'];
    if (!VALID_STATUSES.includes(formData.status)) errors.status = 'Invalid client status.';
    
    // Contact requirement: At least email or phone must be provided
    if (!formData.email && !formData.phone) {
      errors.contactInfo = 'At least one contact method (email or phone) is required.';
    }
    if (formData.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(formData.email)) {
      errors.email = 'Valid email is required.';
    }

    if (Object.keys(errors).length === 0) {
      const db = getDb((env as any).DB);
      const clientId = crypto.randomUUID();
      const contactId = crypto.randomUUID();
      const auditId = crypto.randomUUID();

      await db.batch([
        db.insert(clients).values({
          id: clientId,
          name: formData.clientName,
          status: formData.status as any,
          notes: formData.internalNotes || null
        }),
        db.insert(clientContacts).values({
          id: contactId,
          clientId: clientId,
          firstName: formData.contactFirstName,
          lastName: formData.contactLastName,
          email: formData.email || '', // Email is required in DB schema? Wait. Let me check schema!
          phone: formData.phone || null,
          isPrimary: true
        }),
        db.insert(auditLogs).values({
          id: auditId,
          action: 'client_created',
          entityType: 'client',
          entityId: clientId,
          actorId: user.id,
          details: {
            clientName: formData.clientName,
            action: 'created_manually'
          }
        })
      ]);

      return Astro.redirect(`/admin/clients/${clientId}`);
    }
  } catch (error: any) {
    console.error('Error creating client:', error);
    errors.system = 'An unexpected error occurred while saving the client.';
  }
}
---

<AdminLayout title="Add New Client" user={user}>
  <div class="p-4 sm:p-6 lg:p-8 max-w-4xl mx-auto">
    
    <div class="mb-8">
      <a href="/admin/clients" class="inline-flex items-center text-sm font-medium text-[#64748b] hover:text-[#242a56] transition-colors mb-2">
        <AdminIcon name="chevron-left" class="w-4 h-4 mr-1" />
        Back to Clients
      </a>
      <h1 class="text-2xl font-bold text-[#242a56]">Add New Client</h1>
      <p class="mt-1 text-sm text-[#64748b]">Manually create a new client and their primary contact record.</p>
    </div>

    {errors.system && (
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-600 font-medium text-sm">
        {errors.system}
      </div>
    )}

    <div class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden">
      <form method="POST" class="p-6 sm:p-8">
        
        <div class="space-y-8">
          
          <!-- Client Details -->
          <div>
            <h2 class="text-base font-bold text-[#242a56] mb-4 border-b border-slate-100 pb-2">Client Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="md:col-span-2">
                <label for="clientName" class="block text-sm font-bold text-[#242a56] mb-1.5">Client / Business Name <span class="text-red-500">*</span></label>
                <input 
                  type="text" 
                  id="clientName" 
                  name="clientName" 
                  value={formData.clientName}
                  class:list={["w-full px-3 py-2 border rounded-lg text-sm focus:outline-none focus:ring-2 bg-white", errors.clientName ? "border-red-300 focus:ring-red-200" : "border-slate-300 focus:ring-[#6878d6]/20 focus:border-[#6878d6]"]}
                />
                {errors.clientName && <p class="mt-1 text-xs text-red-500">{errors.clientName}</p>}
              </div>

              <div>
                <label for="status" class="block text-sm font-bold text-[#242a56] mb-1.5">Status</label>
                <select 
                  id="status" 
                  name="status"
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#6878d6]/20 focus:border-[#6878d6] bg-white appearance-none"
                >
                  <option value="active" selected={formData.status === 'active'}>Active</option>
                  <option value="inactive" selected={formData.status === 'inactive'}>Inactive</option>
                  <option value="archived" selected={formData.status === 'archived'}>Archived</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Primary Contact -->
          <div>
            <div class="flex justify-between items-center mb-4 border-b border-slate-100 pb-2">
              <h2 class="text-base font-bold text-[#242a56]">Primary Contact</h2>
              {errors.contactInfo && <p class="text-xs font-bold text-red-500">{errors.contactInfo}</p>}
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="contactFirstName" class="block text-sm font-bold text-[#242a56] mb-1.5">First Name <span class="text-red-500">*</span></label>
                <input 
                  type="text" 
                  id="contactFirstName" 
                  name="contactFirstName" 
                  value={formData.contactFirstName}
                  class:list={["w-full px-3 py-2 border rounded-lg text-sm focus:outline-none focus:ring-2 bg-white", errors.contactFirstName ? "border-red-300 focus:ring-red-200" : "border-slate-300 focus:ring-[#6878d6]/20 focus:border-[#6878d6]"]}
                />
                {errors.contactFirstName && <p class="mt-1 text-xs text-red-500">{errors.contactFirstName}</p>}
              </div>
              <div>
                <label for="contactLastName" class="block text-sm font-bold text-[#242a56] mb-1.5">Last Name <span class="text-slate-400 font-normal ml-1">(Optional)</span></label>
                <input 
                  type="text" 
                  id="contactLastName" 
                  name="contactLastName" 
                  value={formData.contactLastName}
                  class:list={["w-full px-3 py-2 border rounded-lg text-sm focus:outline-none focus:ring-2 bg-white", errors.contactLastName ? "border-red-300 focus:ring-red-200" : "border-slate-300 focus:ring-[#6878d6]/20 focus:border-[#6878d6]"]}
                />
                {errors.contactLastName && <p class="mt-1 text-xs text-red-500">{errors.contactLastName}</p>}
              </div>
              <div>
                <label for="email" class="block text-sm font-bold text-[#242a56] mb-1.5">Email</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  value={formData.email}
                  class:list={["w-full px-3 py-2 border rounded-lg text-sm focus:outline-none focus:ring-2 bg-white", errors.email ? "border-red-300 focus:ring-red-200" : "border-slate-300 focus:ring-[#6878d6]/20 focus:border-[#6878d6]"]}
                />
                {errors.email && <p class="mt-1 text-xs text-red-500">{errors.email}</p>}
              </div>
              <div>
                <label for="phone" class="block text-sm font-bold text-[#242a56] mb-1.5">Phone / WhatsApp <span class="text-slate-400 font-normal ml-1">(Optional)</span></label>
                <input 
                  type="text" 
                  id="phone" 
                  name="phone" 
                  value={formData.phone}
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#6878d6]/20 focus:border-[#6878d6] bg-white"
                />
              </div>
            </div>
          </div>

          <!-- Internal Notes -->
          <div>
            <h2 class="text-base font-bold text-[#242a56] mb-4 border-b border-slate-100 pb-2">Internal Notes</h2>
            <div>
              <textarea 
                id="internalNotes" 
                name="internalNotes" 
                rows="4"
                placeholder="Private staff notes (optional)"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#6878d6]/20 focus:border-[#6878d6] bg-white resize-y"
              >{formData.internalNotes}</textarea>
            </div>
          </div>

        </div>

        <div class="mt-8 pt-6 border-t border-slate-100 flex justify-end gap-3">
          <a href="/admin/clients" class="px-5 py-2.5 bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium rounded-lg transition-colors">
            Cancel
          </a>
          <button type="submit" class="px-5 py-2.5 bg-[#242a56] hover:bg-[#1a1e3e] text-white text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#242a56]">
            Create Client
          </button>
        </div>

      </form>
    </div>
    
  </div>
</AdminLayout>
