---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { softwareProducts } from '../../lib/db/schema/cms';
import { eq, asc } from 'drizzle-orm';

export const prerender = false;

const db = getDb((env as any).DB);
const allProducts = await db.select().from(softwareProducts)
  .where(eq(softwareProducts.isVisible, true))
  .orderBy(asc(softwareProducts.displayOrder))
  .all();
---
<MainLayout title="Software Products" description="SoftDows software products">
  <Section variant="light" size="large" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-[var(--color-brand-navy)] mb-6">Software Products</h1>
    </div>
  </Section>

  <Section variant="default" size="large">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allProducts.map(p => (
          <a href={`/products/${p.slug}/`} class="group block p-8 rounded-3xl bg-white border border-slate-100 shadow-sm hover:shadow-xl transition-all h-full flex flex-col">
            <h3 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-4">{p.name}</h3>
            <p class="text-slate-600 mb-6 flex-grow">{p.shortDescription}</p>
            <div class="text-[var(--color-brand-purple)] font-medium">Learn more &rarr;</div>
          </a>
        ))}
      </div>
    </div>
  </Section>
</MainLayout>
