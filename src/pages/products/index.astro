---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';



// Cloudflare Edge Caching Header (Zero Worker Compute Cost)


// Curated UI/UX Showcase Data for the 6 Products
const productShowcases = [
  {
    slug: 'biddalok',
    name: 'Biddalok',
    category: 'EdTech & School ERP',
    tagline: 'The Complete Academic Operating System',
    summary: 'A unified digital management platform for schools and colleges. Connects students, teachers, and administrators through structured attendance, instant result publishing, and fee ledgers.',
    accent: {
      gradient: 'from-blue-600 to-indigo-700',
      badge: 'bg-indigo-50 text-indigo-700 border-indigo-200/80',
      glow: 'shadow-indigo-500/10 hover:border-indigo-400/60',
      iconBg: 'bg-indigo-600',
      borderAccent: 'border-indigo-500/20'
    },
    status: 'Live Production',
    target: 'Schools, Colleges & Academic Institutions',
    previewType: 'academic',
    features: [
      { title: 'Student & Faculty Portals', desc: 'Personalized accounts with profiles, class routines, and leave management.' },
      { title: 'Automated Result Processing', desc: '1-click computation of exams, grade points, transcripts, and merit lists.' },
      { title: 'Accounting & Fee Reconciliation', desc: 'Online and cash fee collection ledgers with zero manual calculation errors.' },
      { title: 'Instant Parent SMS Dispatch', desc: 'Broadcast results, emergency closures, and attendance alerts to parents.' }
    ]
  },
  {
    slug: 'mymosque',
    name: 'myMosque',
    category: 'Civic & Community Platform',
    tagline: 'Modern Mosque Administration & Community Hub',
    summary: 'Purpose-engineered management software for central mosques and community organizations. Combines dynamic digital prayer time display with transparent donation accounting and catchment communication.',
    accent: {
      gradient: 'from-emerald-600 to-teal-700',
      badge: 'bg-emerald-50 text-emerald-700 border-emerald-200/80',
      glow: 'shadow-emerald-500/10 hover:border-emerald-400/60',
      iconBg: 'bg-emerald-600',
      borderAccent: 'border-emerald-500/20'
    },
    status: 'Live Production',
    target: 'Mosque Committees, Awqaf & Civic Centers',
    previewType: 'mosque',
    features: [
      { title: 'Autonomous Digital Prayer Screen', desc: 'High-visibility LED/TV screen interface updating automatically with sunrise/sunset.' },
      { title: 'Transparent Zakat & Donation Ledger', desc: 'Digital receipt issuance, donor records, and transparent monthly expense audits.' },
      { title: 'Catchment Area SMS Alerts', desc: 'Broadcast Friday announcements, Janazah notifications, and charity drives.' },
      { title: 'Facility Maintenance Tracking', desc: 'Asset logs for audio systems, air conditioners, power backups, and renovations.' }
    ]
  },
  {
    slug: 'eduweb',
    name: 'EduWeb',
    category: 'Institutional Web Engine',
    tagline: 'Turnkey Educational Portal & Notice Engine',
    summary: 'Turnkey high-speed web infrastructure built specifically for academic organizations. Delivers ultra-fast loading across 3G mobile devices, dynamic circular uploads, and official domain security compliance.',
    accent: {
      gradient: 'from-cyan-600 to-blue-700',
      badge: 'bg-sky-50 text-sky-700 border-sky-200/80',
      glow: 'shadow-sky-500/10 hover:border-sky-400/60',
      iconBg: 'bg-sky-600',
      borderAccent: 'border-sky-500/20'
    },
    status: 'Ready to Deploy',
    target: 'Schools, Madrasahs & Educational Boards',
    previewType: 'eduweb',
    features: [
      { title: 'Sub-Second Edge Page Loads', desc: 'Optimized static edge rendering delivering immediate speed even on rural mobile data.' },
      { title: 'Dynamic Notice & Circular Board', desc: 'No-code PDF uploads, dynamic photo galleries, and official speech archives.' },
      { title: 'Official .edu.bd Domain Ready', desc: 'Full BTCL DNS routing, SSL security enforcement, and government web standards.' },
      { title: 'Parent & Mobile First Design', desc: 'Streamlined UI designed for seamless navigation on low-resolution smartphones.' }
    ]
  },
  {
    slug: 'smarttutor',
    name: 'SmartTutor',
    category: 'Learning Management System (LMS)',
    tagline: 'Next-Generation Digital Learning Architecture',
    summary: 'A structured e-learning and course distribution engine for educators and coaching academies. Features interactive lecture delivery, automatic quiz grading, and comprehensive student retention analytics.',
    accent: {
      gradient: 'from-violet-600 to-purple-700',
      badge: 'bg-violet-50 text-violet-700 border-violet-200/80',
      glow: 'shadow-violet-500/10 hover:border-violet-400/60',
      iconBg: 'bg-violet-600',
      borderAccent: 'border-violet-500/20'
    },
    status: 'Ready to Deploy',
    target: 'Coaching Centers, Academies & Private Mentors',
    previewType: 'lms',
    features: [
      { title: 'Structured Video Lesson Player', desc: 'Protected video streaming with timestamped lecture notes and downloadable PDFs.' },
      { title: 'Instant MCQ & Assessment Engine', desc: 'Automated exam scoring, rank generation, and detailed question explanations.' },
      { title: 'Student Retention Telemetry', desc: 'Visual analytics highlighting lesson completion rates and areas needing attention.' },
      { title: 'Dedicated Doubt-Clearing Room', desc: 'Direct question & answer threads between instructors and enrolled students.' }
    ]
  },
  {
    slug: 'experthunter',
    name: 'ExpertHunter',
    category: 'Talent Discovery Platform',
    tagline: 'Direct Professional Discovery & Matching',
    summary: 'An architectural platform connecting organizations with specialized, vetted professionals. Eliminates expensive staffing intermediaries through structured portfolios and direct inquiry routing.',
    accent: {
      gradient: 'from-amber-600 to-orange-700',
      badge: 'bg-amber-50 text-amber-800 border-amber-200/80',
      glow: 'shadow-amber-500/10 hover:border-amber-400/60',
      iconBg: 'bg-amber-600',
      borderAccent: 'border-amber-500/20'
    },
    status: 'Turnkey Engine',
    target: 'Enterprises, Consultancies & Talent Networks',
    previewType: 'talent',
    features: [
      { title: 'Verified Work Portfolios', desc: 'Documented proof-of-work, validated achievements, and credential badges.' },
      { title: 'Direct Hiring Communication', desc: 'Direct inquiry gateway between hiring organizations and specialized talent.' },
      { title: 'Domain Capability Indexing', desc: 'Granular filtering by technology stack, industry expertise, and availability.' },
      { title: 'Reputation Verification', desc: 'Authentic project feedback and transparent performance history.' }
    ]
  },
  {
    slug: 'easywebdev',
    name: 'EasyWebDev',
    category: 'Developer Platform & Tooling',
    tagline: 'High-Velocity Web Engineering Scaffolding',
    summary: 'Comprehensive scaffolding and developer tooling engineered to accelerate production web projects. Includes battle-tested boilerplates, serverless database adapters, and pre-built accessible UI foundations.',
    accent: {
      gradient: 'from-rose-600 to-pink-700',
      badge: 'bg-rose-50 text-rose-700 border-rose-200/80',
      glow: 'shadow-rose-500/10 hover:border-rose-400/60',
      iconBg: 'bg-rose-600',
      borderAccent: 'border-rose-500/20'
    },
    status: 'Developer Tools',
    target: 'Software Teams, Frontend Engineers & Agencies',
    previewType: 'dev',
    features: [
      { title: 'Production Scaffolding Starters', desc: 'Clean Astro, TypeScript, and Tailwind starting points optimized for edge CDN.' },
      { title: 'Serverless Database Presets', desc: 'Zero-downtime Cloudflare D1 integration with pre-built migration patterns.' },
      { title: 'Accessible UI Component Blocks', desc: 'Speed-tested, responsive components built with zero bloated third-party scripts.' },
      { title: 'Automated CI/CD Pipeline', desc: 'One-click Git repository connection directly to global edge hosting.' }
    ]
  }
];
---
export const prerender = true;

<MainLayout 
  title="Proprietary Software Platforms | SoftDows Product Suite" 
  description="Explore the SoftDows suite of turnkey software platforms. Built for schools, community organizations, and web operations with 100% source ownership and zero recurring seat fees."
>
  
  <!-- ========================================================================= -->
  <!-- 1. EDITORIAL LUXURY SHOWROOM HERO: Luminous, Clean, Human                 -->
  <!-- ========================================================================= -->
  <section class="relative pt-16 pb-16 md:pt-24 md:pb-24 bg-[#FAFBFD] border-b border-slate-200/80 overflow-hidden">
    
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[400px] bg-gradient-to-b from-indigo-100/60 via-blue-50/40 to-transparent rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 shadow-xs text-xs font-semibold text-slate-700">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-600"></span>
        </span>
        <span class="tracking-wide">PROPRIETARY SOFTWARE SUITE</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-[#192040] tracking-tight leading-[1.12]">
        Software Built with Purpose. <br />
