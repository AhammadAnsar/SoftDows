---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ConceptualVisual from '../../components/ui/ConceptualVisual.astro';
import { productsData } from '../../lib/content/products';

export function getStaticPaths() {
  return Object.values(productsData).filter(p => p.visibility === 'public').map(product => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

// Determine conceptual visual based on slug
const visualConcept = product.slug === 'domain-registration' ? 'seo' 
  : product.slug === 'web-hosting' ? 'maintenance' 
  : product.slug === 'biddalok' ? 'collaboration' 
  : product.slug === 'mymosque' ? 'case-study' 
  : 'custom-software';
---
<MainLayout title={product.seoTitle} description={product.seoDescription}>
  <Section variant="light" size="large" class="pt-28 pb-16 md:pt-40 md:pb-24 bg-slate-50 border-b border-slate-100">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-16 lg:gap-20">
      <div class="w-full lg:w-1/2">
        <div class="flex flex-wrap items-center gap-4 mb-6">
          <Badge variant="primary">Software Product</Badge>
          {product.status !== 'active' && <Badge class="bg-amber-100 text-amber-800 border-transparent uppercase tracking-wider text-xs">{product.status}</Badge>}
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[var(--color-brand-navy)] mb-4 tracking-tight leading-[1.05]">
          {product.name}
        </h1>
        <p class="text-2xl text-[var(--color-brand-purple)] font-medium mb-6">{product.tagline}</p>
        <p class="text-xl md:text-2xl font-light text-[var(--color-text-muted)] leading-relaxed mb-10 max-w-xl">
          {product.fullDescription}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <Button href={product.primaryCTA.url} variant="primary" size="large">{product.primaryCTA.label}</Button>
          {product.secondaryCTA && (
            <Button href={product.secondaryCTA.url} variant="outline" size="large">{product.secondaryCTA.label}</Button>
          )}
        </div>
      </div>
      <div class="w-full lg:w-1/2">
        <ConceptualVisual concept={visualConcept as any} class="w-full h-[400px] lg:h-[500px] shadow-2xl rounded-3xl" />
      </div>
    </div>
  </Section>

  {product.problem !== 'To be announced.' && (
    <Section variant="default" size="normal">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row gap-12 lg:gap-20">
        <div class="md:w-1/2">
          <h2 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-2">The Problem</h2>
          <p class="text-xl text-[var(--color-brand-navy)] font-medium leading-relaxed">{product.problem}</p>
        </div>
        <div class="md:w-1/2">
          <h2 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-2">Target Audience</h2>
          <p class="text-xl text-[var(--color-brand-navy)] font-medium leading-relaxed">{product.targetAudience}</p>
        </div>
      </div>
    </Section>
  )}

  {product.capabilities.length > 0 && (
    <Section variant="alternate" size="normal" class="bg-slate-50 border-y border-slate-100">
      <div class="max-w-3xl mb-12 text-center mx-auto">
        <Badge class="mb-4">Capabilities</Badge>
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-brand-navy)] mb-6">Platform Features</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {product.capabilities.map(cap => (
          <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-6">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--color-brand-navy)]">{cap}</h3>
          </div>
        ))}
      </div>
    </Section>
  )}

  {product.keyBenefits.length > 0 && (
    <Section variant="default" size="normal">
      <div class="max-w-3xl mb-12 text-center mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-brand-navy)] mb-6">Key Business Benefits</h2>
      </div>
      <div class="flex flex-wrap justify-center gap-6 max-w-5xl mx-auto">
        {product.keyBenefits.map(benefit => (
          <div class="flex items-center gap-3 px-6 py-4 bg-slate-50 border border-slate-200 rounded-xl">
             <div class="w-2 h-2 rounded-full bg-[var(--color-brand-purple)]"></div>
             <span class="text-lg font-bold text-[var(--color-brand-navy)]">{benefit}</span>
          </div>
        ))}
      </div>
    </Section>
  )}

  <Section variant="dark" size="normal" class="bg-[#0B0E23] text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    <div class="max-w-3xl mx-auto relative z-10">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Ready to leverage {product.shortName}?</h2>
      <p class="text-lg text-slate-300 mb-10 leading-relaxed font-light">Contact our team to discuss integration, capabilities, or technical specifications.</p>
      <Button href={product.primaryCTA.url} variant="inverse" size="large">{product.primaryCTA.label}</Button>
    </div>
  </Section>
</MainLayout>

