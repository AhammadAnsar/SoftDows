---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('insights');
  return items.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
import { render } from 'astro:content';
const { Content } = await render(entry);
---
export const prerender = true;
<MainLayout title={`${entry.data.title} | SoftDows Insights`} description={entry.data.description}>
  <article class="px-6 py-24 sm:py-32 lg:px-8 bg-white min-h-screen">
    <div class="mx-auto max-w-3xl">
      <div class="flex items-center gap-4 text-sm mb-4">
        <span class="font-semibold text-indigo-600">{entry.data.author}</span>
        <span class="text-slate-400">&bull;</span>
        <span class="text-slate-500">{entry.data.publishDate.toISOString().split('T')[0]}</span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl mb-6">{entry.data.title}</h1>
      
      <div class="mt-10 max-w-2xl prose prose-indigo prose-lg text-gray-600">
        <Content />
      </div>
    </div>
  </article>
</MainLayout>



