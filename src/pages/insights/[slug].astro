---
import Layout from '../../layouts/MainLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { articles } from '../../lib/db/schema/cms';
import { eq } from 'drizzle-orm';
import { marked } from 'marked'; 

const { slug } = Astro.params;

const db = getDb((env as any).DB);
const item = await db.select().from(articles).where(eq(articles.slug, slug as string)).get();

if (!item || item.status !== 'published') {
  return new Response('Not Found', { status: 404 });
}

const title = `${item.seoTitle || item.title} | SoftDows`;
const description = item.seoDescription || item.excerpt || '';
// Fast markdown parsing
const htmlContent = marked.parse(item.content);
---
<Layout title={title} description={description}>
  <div class="bg-white px-6 py-24 sm:py-32 lg:px-8">
    <div class="mx-auto max-w-3xl text-base leading-7 text-gray-700">
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">{item.title}</h1>
      <p class="mt-2 text-sm text-gray-500">By {item.authorName}</p>
      
      <div class="mt-10 max-w-2xl prose prose-indigo">
        <Fragment set:html={htmlContent} />
      </div>
    </div>
  </div>
</Layout>
