---
import Layout from '../../layouts/MainLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { articles } from '../../lib/db/schema/cms';
import { eq, desc } from 'drizzle-orm';

const db = getDb((env as any).DB);
const items = await db.select().from(articles).where(eq(articles.status, 'published')).orderBy(desc(articles.createdAt)).all();

const title = "Insights | SoftDows";
const description = "Latest news, articles, and insights from the SoftDows team.";
---
<Layout title={title} description={description}>
  <div class="bg-white px-6 py-24 sm:py-32 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Insights</h2>
        <p class="mt-2 text-lg leading-8 text-gray-600">Latest news, articles, and insights.</p>
      </div>
      <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-3">
        {items.map(item => (
          <article class="flex flex-col items-start justify-between">
            <div class="max-w-xl">
              <div class="group relative">
                <h3 class="mt-3 text-lg font-semibold leading-6 text-gray-900 group-hover:text-gray-600">
                  <a href={`/insights/${item.slug}`}>
                    <span class="absolute inset-0"></span>
                    {item.title}
                  </a>
                </h3>
                {item.excerpt && <p class="mt-5 line-clamp-3 text-sm leading-6 text-gray-600">{item.excerpt}</p>}
              </div>
              <div class="relative mt-8 flex items-center gap-x-4">
                <div class="text-sm leading-6">
                  <p class="font-semibold text-gray-900">
                    <span class="absolute inset-0"></span>
                    {item.authorName}
                  </p>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>
