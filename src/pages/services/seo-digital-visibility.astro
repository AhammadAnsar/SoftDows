---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import ConceptualVisual from '../../components/ui/ConceptualVisual.astro';
import { serviceDetails, serviceCta } from '../../lib/content/service-details';

const c = serviceDetails['seo-digital-visibility'];
const cta = serviceCta;
---

<MainLayout title={c.seo.title} description={c.seo.description}>
  <!-- HERO -->
  <Section variant="light" size="large" class="pt-28 pb-20 md:pt-40 md:pb-32 border-b border-slate-100 relative overflow-hidden bg-slate-50">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-[var(--color-brand-purple)]/5 via-transparent to-transparent opacity-70"></div>
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-20 relative z-10 max-w-7xl mx-auto">
      <div class="w-full lg:w-1/2">
        <Badge variant="primary" class="mb-6">{c.hero.eyebrow}</Badge>
        <h1 class="mb-8 text-5xl md:text-6xl text-[var(--color-brand-navy)] font-bold tracking-tight leading-[1.05]">
          {c.hero.heading}
        </h1>
        <p class="text-xl md:text-2xl font-light text-[var(--color-text-muted)] leading-relaxed max-w-xl">
          {c.hero.description}
        </p>
      </div>
      <div class="w-full lg:w-1/2">
        <ConceptualVisual concept="seo" class="w-full h-full min-h-[500px] shadow-2xl rounded-3xl" />
      </div>
    </div>
  </Section>

  <!-- CONTEXT -->
  <Section variant="default" size="normal" class="border-t border-slate-100">
    <div class="max-w-6xl mx-auto">
      <div class="mb-16 md:mb-20 max-w-3xl">
        <h2 class="text-3xl font-bold text-[var(--color-brand-navy)] mb-6">{c.context.heading}</h2>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
          {c.context.description}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {(c as any).context?.focusAreas.map((area: any) => (
          <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
            <h3 class="text-xl font-bold text-[var(--color-brand-navy)] mb-4">{area.title}</h3>
            <p class="text-[var(--color-text-muted)] leading-relaxed">{area.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section variant="alternate" size="normal" class="bg-slate-50 border-t border-slate-100 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-brand-navy)] mb-6 tracking-tight">{cta.heading}</h2>
      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-10">
        {cta.description}
      </p>
      <Button href={cta.primaryCta.url} variant="primary" class="px-10 py-3 text-lg">{cta.primaryCta.label}</Button>
    </div>
  </Section>
</MainLayout>







