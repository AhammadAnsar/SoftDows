---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import ConceptualVisual from '../../components/ui/ConceptualVisual.astro';
import { serviceDetails, serviceCta } from '../../lib/content/service-details';

const c = serviceDetails['custom-software-web-applications'];
const cta = serviceCta;
---

<MainLayout title={c.seo.title} description={c.seo.description}>
  <!-- HERO -->
  <Section variant="light" size="large" class="pt-28 pb-20 md:pt-40 md:pb-32 border-b border-slate-100 relative overflow-hidden bg-slate-50">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-[var(--color-brand-purple)]/5 via-transparent to-transparent opacity-70"></div>
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-20 relative z-10 max-w-7xl mx-auto">
      <div class="w-full lg:w-1/2">
        <Badge variant="primary" class="mb-6">{c.hero.eyebrow}</Badge>
        <h1 class="mb-8 text-5xl md:text-6xl text-[var(--color-brand-navy)] font-bold tracking-tight leading-[1.05]">
          {c.hero.heading}
        </h1>
        <p class="text-xl md:text-2xl font-light text-[var(--color-text-muted)] leading-relaxed max-w-xl">
          {c.hero.description}
        </p>
      </div>
      <div class="w-full lg:w-1/2">
        <ConceptualVisual concept="custom-software" class="w-full h-full min-h-[500px] shadow-2xl rounded-3xl" />
      </div>
    </div>
  </Section>

  <!-- CONTEXT -->
  <Section variant="default" size="normal">
    <div class="max-w-4xl mx-auto text-center mb-16">
      <h2 class="text-3xl font-bold text-[var(--color-brand-navy)] mb-6">{c.context.heading}</h2>
      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
        {c.context.description}
      </p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
      {c.context.outcomes.map((outcome: any) => (
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm text-center">
          <div class="w-12 h-12 mx-auto bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mb-4">
             <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <span class="text-slate-800 font-bold">{outcome}</span>
        </div>
      ))}
    </div>
  </Section>

  <!-- APPROACH -->
  <Section variant="alternate" size="normal" class="bg-[#0B0E23] text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,_var(--color-brand-purple)_0%,transparent_50%)] opacity-20"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    
    <div class="max-w-3xl mb-16 relative z-10">
      <Badge variant="primary" class="mb-4 bg-[var(--color-brand-purple)] text-white border-transparent">Engineering Methodology</Badge>
      <h2 class="text-4xl font-bold text-white mb-6 tracking-tight">{(c as any).approach?.heading}</h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">
      {(c as any).approach?.steps.map((step: any, index: number) => (
        <div class="bg-white/5 border border-white/10 rounded-2xl p-8 hover:bg-white/10 transition-colors duration-300 backdrop-blur-sm">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-brand-purple)] flex items-center justify-center text-xl font-black text-white mb-6 shadow-lg shadow-[var(--color-brand-purple)]/20">
            0{index + 1}
          </div>
          <h3 class="text-xl font-bold text-white mb-4">
            {step.title}
          </h3>
          <p class="text-slate-300 leading-relaxed font-light">{step.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <Section variant="default" size="normal" class="text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-brand-navy)] mb-6 tracking-tight">{cta.heading}</h2>
      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-10">
        {cta.description}
      </p>
      <Button href={cta.primaryCta.url} variant="primary" class="px-10 py-3 text-lg">{cta.primaryCta.label}</Button>
    </div>
  </Section>
</MainLayout>









