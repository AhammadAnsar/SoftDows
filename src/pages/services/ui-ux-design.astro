---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import ConceptualVisual from '../../components/ui/ConceptualVisual.astro';
import { serviceDetails, serviceCta } from '../../lib/content/service-details';

const c = serviceDetails['ui-ux-design'];
const cta = serviceCta;
---

<MainLayout title={c.seo.title} description={c.seo.description}>
  <!-- HERO -->
  <Section variant="light" size="large" class="pt-28 pb-20 md:pt-40 md:pb-32 border-b border-slate-100 relative overflow-hidden bg-slate-50">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-[var(--color-brand-purple)]/5 via-transparent to-transparent opacity-70"></div>
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-20 relative z-10 max-w-7xl mx-auto">
      <div class="w-full lg:w-1/2">
        <Badge variant="primary" class="mb-6">{c.hero.eyebrow}</Badge>
        <h1 class="mb-8 text-5xl md:text-6xl text-[var(--color-brand-navy)] font-bold tracking-tight leading-[1.05]">
          {c.hero.heading}
        </h1>
        <p class="text-xl md:text-2xl font-light text-[var(--color-text-muted)] leading-relaxed max-w-xl">
          {c.hero.description}
        </p>
      </div>
      <div class="w-full lg:w-1/2">
        <ConceptualVisual concept="ui-ux" class="w-full h-full min-h-[500px] shadow-2xl rounded-3xl" />
      </div>
    </div>
  </Section>

  <!-- PHILOSOPHY -->
  <Section variant="alternate" size="normal" class="bg-slate-50 border-t border-slate-100">
    <div class="max-w-6xl mx-auto">
      <div class="mb-12 max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-brand-navy)] mb-6 leading-tight">{(c as any).philosophy?.heading}</h2>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
          {(c as any).philosophy?.description}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-12">
        {(c as any).philosophy?.principles.map((principle: any, index: number) => (
          <div>
            <div class="text-6xl font-bold text-slate-200 mb-4 tracking-tighter">0{index + 1}</div>
            <h3 class="text-xl font-bold text-[var(--color-brand-navy)]">{principle}</h3>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section variant="default" size="normal">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-10 bg-[var(--color-brand-navy)] p-10 md:p-14 rounded-3xl text-white">
      <div class="md:w-2/3 text-center md:text-left">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">{cta.heading}</h2>
        <p class="text-[var(--color-brand-light)] opacity-90 leading-relaxed text-lg">
          {cta.description}
        </p>
      </div>
      <div class="md:w-1/3 flex justify-center md:justify-end shrink-0">
        <Button href={cta.primaryCta.url} variant="inverse" size="large" class="w-full sm:w-auto px-8">{cta.primaryCta.label}</Button>
      </div>
    </div>
  </Section>
</MainLayout>








