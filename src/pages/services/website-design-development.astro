---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import ConceptualVisual from '../../components/ui/ConceptualVisual.astro';
import { serviceDetails, serviceCta } from '../../lib/content/service-details';

const c = serviceDetails['website-design-development'];
const cta = serviceCta;
---

<MainLayout title={c.seo.title} description={c.seo.description}>
  <!-- HERO -->
  <Section variant="light" size="large" class="pt-28 pb-20 md:pt-40 md:pb-32 border-b border-slate-100 relative overflow-hidden bg-slate-50">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-[var(--color-brand-purple)]/5 via-transparent to-transparent opacity-70"></div>
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-20 relative z-10 max-w-7xl mx-auto">
      <div class="w-full lg:w-1/2">
        <Badge variant="primary" class="mb-6">{c.hero.eyebrow}</Badge>
        <h1 class="mb-8 text-5xl md:text-6xl text-[var(--color-brand-navy)] font-bold tracking-tight leading-[1.05]">
          {c.hero.heading}
        </h1>
        <p class="text-xl md:text-2xl font-light text-[var(--color-text-muted)] leading-relaxed max-w-xl">
          {c.hero.description}
        </p>
      </div>
      <div class="w-full lg:w-1/2">
        <ConceptualVisual concept="website-design" class="w-full h-full min-h-[500px] shadow-2xl rounded-3xl" />
      </div>
    </div>
  </Section>

  <!-- CONTEXT -->
  <Section variant="default" size="normal">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 max-w-6xl">
      <div class="lg:w-1/2">
        <h2 class="text-3xl font-bold text-[var(--color-brand-navy)] mb-6">{c.context.heading}</h2>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-8">
          {c.context.description}
        </p>
      </div>
      <div class="lg:w-1/2">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 md:p-10 h-full flex flex-col justify-center">
          <h3 class="text-xl font-bold text-[var(--color-brand-navy)] mb-6">Key Outcomes</h3>
          <ul class="space-y-4">
            {c.context.outcomes.map((outcome: any) => (
              <li class="flex items-start gap-4">
                <div class="flex-shrink-0 mt-1 w-6 h-6 rounded-full bg-green-100 flex items-center justify-center text-green-600">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-slate-800 font-medium text-lg">{outcome}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <!-- CAPABILITIES (Specific to this service) -->
  <Section variant="alternate" size="normal" class="bg-white border-y border-slate-100">
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl font-bold text-[var(--color-brand-navy)] mb-4">{c.capabilities.heading}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {c.capabilities.items.map((item: any, index: number) => (
        <div class="border border-slate-200 p-8 rounded-2xl hover:border-[var(--color-brand-purple)] transition-colors group">
          <div class="text-[var(--color-brand-purple)] text-lg font-bold mb-4 opacity-50 group-hover:opacity-100 transition-opacity">0{index + 1}</div>
          <h3 class="text-xl font-bold text-[var(--color-brand-navy)] mb-3">{item.title}</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <Section variant="dark" size="normal" class="bg-[#1a1f3c] text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 tracking-tight">{cta.heading}</h2>
      <p class="text-lg text-[var(--color-brand-light)] opacity-90 leading-relaxed mb-10">
        {cta.description}
      </p>
      <Button href={cta.primaryCta.url} variant="inverse" class="px-10 py-3 text-lg">{cta.primaryCta.label}</Button>
    </div>
  </Section>
</MainLayout>






