---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ConceptualVisual from '../../components/ui/ConceptualVisual.astro';
import { getPublishedServices } from '../../lib/content/services';

export function getStaticPaths() {
  return getPublishedServices().map(service => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
---
export const prerender = true;
<MainLayout title={`${service.title} | SoftDows`} description={service.desc}>
  <Section variant="light" size="large" class="pt-28 pb-16 md:pt-40 md:pb-24 bg-slate-50 border-b border-slate-100">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-16 lg:gap-20">
      <div class="w-full lg:w-1/2">
        <div class="flex flex-wrap items-center gap-4 mb-6">
          <Badge variant="primary">Service</Badge>
          {service.tags.map(tag => (
            <Badge variant="outline">{tag}</Badge>
          ))}
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[var(--color-brand-navy)] leading-[1.1] mb-6">
          {service.title}
        </h1>
        <p class="text-lg text-slate-600 mb-8 max-w-xl leading-relaxed">
          {service.desc}
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href={`/start-a-project/?service=${service.slug}`} variant="primary" size="large">Start a Project</Button>
          <Button href="/contact/" variant="outline" size="large">Contact Us</Button>
        </div>
      </div>
      <div class="w-full lg:w-1/2 h-[400px] md:h-[500px]">
        <ConceptualVisual concept="custom-software" class="w-full h-full rounded-2xl" />
      </div>
    </div>
  </Section>
</MainLayout>

