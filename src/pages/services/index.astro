---
import MainLayout from '../../layouts/MainLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { services } from '../../lib/db/schema/agency';
import { eq, asc } from 'drizzle-orm';

export const prerender = false;

// Cloudflare Edge Caching Header (Zero Worker Compute Cost)
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=3600, stale-while-revalidate=86400');

const db = getDb((env as any).DB);
const dbServices = await db.select().from(services)
  .where(eq(services.isVisible, true))
  .orderBy(asc(services.displayOrder))
  .all()
  .catch(() => []);

// Hero Slider Data (3 High-Impact Service Slides)
const heroSlides = [
  {
    id: 0,
    domain: 'SOFTWARE & WEB SYSTEMS',
    headline: 'Custom Web & Software Systems Built to Scale.',
    description: 'We architect bespoke digital platforms that streamline operations, eliminate manual workflows, and scale without per-user licensing fees.',
    badge: '100% Source Code Ownership',
    ctaPrimary: { label: 'Start Software Project', url: '/start-a-project/?service=custom-software-web-applications' },
    ctaSecondary: { label: 'View Specifications', url: '/services/custom-software-web-applications/' },
    visualTheme: 'indigo'
  },
  {
    id: 1,
    domain: 'REVENUE & COMMERCE',
    headline: 'Seamless eCommerce Engineered for High Conversions.',
    description: 'Frictionless checkout funnels with automated bKash, Nagad, and credit cards. Built on sub-second edge runtimes that never crash during sales spikes.',
    badge: 'Zero-Crash Traffic Architecture',
    ctaPrimary: { label: 'Launch Online Store', url: '/start-a-project/?service=ecommerce-development' },
    ctaSecondary: { label: 'View Store Architecture', url: '/services/ecommerce-development/' },
    visualTheme: 'emerald'
  },
  {
    id: 2,
    domain: 'CLOUD & 24/7 OPERATIONS',
    headline: 'Global Edge Cloud, Anycast DNS & 24/7 SLA.',
    description: 'Serverless global edge CDN delivery with <45ms latency worldwide, official BTCL .edu.bd setup, and proactive senior engineer maintenance support.',
    badge: '99.99% Uptime Guarantee',
    ctaPrimary: { label: 'Provision Cloud & SLA', url: '/start-a-project/?service=managed-web-hosting' },
    ctaSecondary: { label: 'Explore Infrastructure', url: '/services/managed-web-hosting/' },
    visualTheme: 'sky'
  }
];

// Clean 8 Services Catalog with rich visual elements and minimal text
const serviceGroups = [
  {
    groupTitle: 'Core Development & Systems',
    groupSubtitle: 'Robust digital platforms engineered for everyday operational reliability.',
    items: [
      {
        slug: 'custom-software-web-applications',
        title: 'Custom Software & Web Apps',
        desc: 'Bespoke web applications built around your exact operations. Centralize data, automate workflows, and eliminate recurring per-seat SaaS taxes.',
        tags: ['Private Database', 'Automated Workflows', 'No Seat Fees'],
        themeColor: 'from-blue-600 to-indigo-600',
        badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200/80',
        iconType: 'code'
      },
      {
        slug: 'website-design-development',
        title: 'Website Design & Development',
        desc: 'Ultra-fast, mobile-first brand websites that turn visitors into paying clients. Built on modern edge architecture that loads in milliseconds.',
        tags: ['< 800ms FCP', 'Core Web Vitals 100', 'Mobile Viewport'],
        themeColor: 'from-cyan-600 to-blue-600',
        badgeColor: 'bg-sky-50 text-sky-700 border-sky-200/80',
        iconType: 'web'
      },
      {
        slug: 'ecommerce-development',
        title: 'eCommerce Systems & Stores',
        desc: 'Frictionless checkout with real-time stock sync. Automated bKash, Nagad, and credit card payments designed for high mobile conversion.',
        tags: ['1-Click Checkout', 'bKash / Card Gateways', 'Courier Sync'],
        themeColor: 'from-emerald-600 to-teal-600',
        badgeColor: 'bg-emerald-50 text-emerald-700 border-emerald-200/80',
        iconType: 'cart'
      }
    ]
  },
  {
    groupTitle: 'Design & Search Authority',
    groupSubtitle: 'User-centered interfaces and technical foundations for organic discoverability.',
    items: [
      {
        slug: 'ui-ux-design',
        title: 'UI/UX & Design Systems',
        desc: 'Intuitive user interface design rooted in user psychology. We deliver comprehensive Figma design token libraries and clickable prototypes.',
        tags: ['Figma System', 'User Psychology', 'Clickable Prototype'],
        themeColor: 'from-violet-600 to-purple-600',
        badgeColor: 'bg-purple-50 text-purple-700 border-purple-200/80',
        iconType: 'figma'
      },
      {
        slug: 'seo-digital-visibility',
        title: 'Technical SEO & Digital Visibility',
        desc: 'Semantic HTML, Schema.org JSON-LD, and Core Web Vitals optimization that earns durable first-page Google search rankings.',
        tags: ['Lighthouse 100', 'Rich SERP Snippets', 'Organic Growth'],
        themeColor: 'from-amber-600 to-orange-600',
        badgeColor: 'bg-amber-50 text-amber-800 border-amber-200/80',
        iconType: 'seo'
      }
    ]
  },
  {
    groupTitle: 'Cloud, Infrastructure & SLA',
    groupSubtitle: 'High-availability global runtimes and continuous security protection.',
    items: [
      {
        slug: 'website-maintenance-support',
        title: 'Website Maintenance & Cloud Support',
        desc: 'Continuous security updates, automated daily off-site encrypted backups, and direct WhatsApp hotline access to senior engineers.',
        tags: ['99.99% Uptime SLA', 'Hourly Snapshots', 'Direct Hotline'],
        themeColor: 'from-rose-600 to-pink-600',
        badgeColor: 'bg-rose-50 text-rose-700 border-rose-200/80',
        iconType: 'shield'
      },
      {
        slug: 'domain-registration-management',
        title: 'Domain Registration & DNS',
        desc: 'Official BTCL .edu.bd / .bd domain acquisition, Anycast global DNS propagation, and DNSSEC protection with zero-lapse renewal guards.',
        tags: ['.edu.bd Ready', 'Anycast Global DNS', 'DNSSEC Crypto'],
        themeColor: 'from-cyan-600 to-teal-600',
        badgeColor: 'bg-cyan-50 text-cyan-800 border-cyan-200/80',
        iconType: 'dns'
      },
      {
        slug: 'managed-web-hosting',
        title: 'Managed Edge Cloud Hosting',
        desc: 'High-availability global edge CDN runtimes. Fast response times worldwide (<45ms TTFB), enterprise WAF, and zero shared server slowdowns.',
        tags: ['< 45ms Global TTFB', 'Enterprise WAF', 'Zero Cold Starts'],
        themeColor: 'from-teal-600 to-emerald-600',
        badgeColor: 'bg-teal-50 text-teal-800 border-teal-200/80',
        iconType: 'cloud'
      }
    ]
  }
];
---

<MainLayout 
  title="Digital Engineering Services | SoftDows" 
  description="Explore SoftDows digital services: Custom Software, Modern Web Design, eCommerce, UI/UX, SEO, Maintenance, Domains, and Managed Cloud."
>

  <!-- ========================================================================= -->
  <!-- 1. HERO SLIDER: Modern, Visual, Shape-Driven & Engaging                   -->
  <!-- ========================================================================= -->
  <section class="relative bg-[#0F172A] text-white pt-24 pb-16 md:pt-32 md:pb-24 overflow-hidden border-b border-slate-800">
    
    <div class="absolute -top-32 left-1/4 w-96 h-96 rounded-full bg-indigo-500/20 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-10 w-96 h-96 rounded-full bg-cyan-500/15 blur-[120px] pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff0a_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Slider Main Stage -->
      <div class="relative min-h-[440px] flex items-center">
        
        {heroSlides.map((slide, index) => (
          <div 
            class={`hero-slide w-full transition-all duration-700 ${index === 0 ? 'opacity-100 translate-x-0 relative' : 'opacity-0 translate-x-8 absolute inset-0 pointer-events-none'}`}
            data-slide-index={index}
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
              
              <div class="lg:col-span-7 space-y-6">
                
                <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/15 text-xs font-mono font-bold text-cyan-300">
                  <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                  <span>{slide.domain}</span>
                </div>

                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.08]">
                  {slide.headline}
                </h1>

                <p class="text-base sm:text-lg text-slate-300 max-w-xl font-normal leading-relaxed">
                  {slide.description}
                </p>

                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/10 text-xs font-semibold text-emerald-300">
                  <span>✓</span>
                  <span>{slide.badge}</span>
                </div>

                <div class="flex flex-wrap items-center gap-3 pt-2">
                  <a 
                    href={slide.ctaPrimary.url} 
                    class="px-6 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs sm:text-sm font-bold rounded-xl shadow-lg transition-all flex items-center gap-2"
                  >
                    <span>{slide.ctaPrimary.label}</span>
                    <span>&rarr;</span>
                  </a>

                  <a 
                    href={slide.ctaSecondary.url} 
                    class="px-5 py-3.5 bg-white/10 hover:bg-white/20 text-white text-xs sm:text-sm font-semibold rounded-xl border border-white/15 transition-all"
                  >
                    {slide.ctaSecondary.label}
                  </a>
                </div>

              </div>

              <!-- Right: Rich Digital Vector Art & Geometric Shapes -->
              <div class="lg:col-span-5 flex justify-center">
                
                {slide.visualTheme === 'indigo' && (
                  <div class="relative w-full max-w-sm rounded-3xl bg-gradient-to-br from-indigo-900/60 to-slate-900 border border-indigo-500/30 p-6 shadow-2xl backdrop-blur-md space-y-4">
                    <div class="flex items-center justify-between pb-3 border-b border-indigo-500/20">
                      <div class="flex gap-1.5">
                        <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
                        <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
                        <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
                      </div>
                      <span class="text-[10px] font-mono text-indigo-300">softdows-core-app</span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-center text-xs font-mono">
                      <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                        <div class="text-xl mb-1">⚡</div>
                        <div class="text-white font-bold">Fast APIs</div>
                        <div class="text-[10px] text-slate-400">&lt; 35ms TTFB</div>
                      </div>
                      <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                        <div class="text-xl mb-1">🔒</div>
                        <div class="text-white font-bold">Private DB</div>
                        <div class="text-[10px] text-slate-400">100% Isolated</div>
                      </div>
                    </div>

                    <div class="p-3 rounded-xl bg-indigo-500/10 border border-indigo-500/30 text-xs text-indigo-200 font-mono">
                      ✓ Automated Workflows · 0 User-Seat Taxes
                    </div>
                  </div>
                )}

                {slide.visualTheme === 'emerald' && (
                  <div class="relative w-full max-w-sm rounded-3xl bg-gradient-to-br from-emerald-950/60 to-slate-900 border border-emerald-500/30 p-6 shadow-2xl backdrop-blur-md space-y-4">
                    <div class="flex items-center justify-between pb-3 border-b border-emerald-500/20">
                      <span class="text-xs font-bold text-emerald-400">CHECKOUT PIPELINE</span>
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300">SUB-SECOND</span>
                    </div>

                    <div class="grid grid-cols-3 gap-2 text-center text-xs font-mono">
                      <div class="p-2.5 rounded-xl bg-white/5 border border-white/10">
                        <div class="text-lg">🛒</div>
                        <div class="text-[10px] text-slate-300 mt-1">Cart</div>
                      </div>
                      <div class="p-2.5 rounded-xl bg-white/5 border border-white/10">
                        <div class="text-lg">📱</div>
                        <div class="text-[10px] text-slate-300 mt-1">bKash/Card</div>
                      </div>
                      <div class="p-2.5 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 font-bold">
                        <div class="text-lg">✓</div>
                        <div class="text-[10px] mt-1">Order Paid</div>
                      </div>
                    </div>

                    <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-xs text-emerald-200 font-mono">
                      ✓ High-Conversion Checkout · Instant Stock Sync
                    </div>
                  </div>
                )}

                {slide.visualTheme === 'sky' && (
                  <div class="relative w-full max-w-sm rounded-3xl bg-gradient-to-br from-sky-950/60 to-slate-900 border border-cyan-500/30 p-6 shadow-2xl backdrop-blur-md space-y-4">
                    <div class="flex items-center justify-between pb-3 border-b border-cyan-500/20">
                      <span class="text-xs font-bold text-cyan-400">GLOBAL EDGE CDN</span>
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300">300+ NODES</span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-center text-xs font-mono">
                      <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                        <div class="text-base font-bold text-white">&lt; 45ms</div>
                        <div class="text-[10px] text-slate-400">GLOBAL PING</div>
                      </div>
                      <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                        <div class="text-base font-bold text-emerald-400">99.99%</div>
                        <div class="text-[10px] text-slate-400">UPTIME SLA</div>
                      </div>
                    </div>

                    <div class="p-3 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-xs text-cyan-200 font-mono">
                      ✓ Anycast DNS Propagation · Zero Cold Starts
                    </div>
                  </div>
                )}

              </div>

            </div>
          </div>
        ))}

      </div>

      <!-- Slider Controls & Progress Indicators -->
      <div class="flex items-center justify-between pt-8 border-t border-slate-800">
        
        <div class="flex items-center gap-2">
          {heroSlides.map((_, i) => (
            <button 
              type="button" 
              class={`slide-indicator-btn h-2.5 rounded-full transition-all duration-300 ${i === 0 ? 'w-10 bg-cyan-400' : 'w-3 bg-white/20 hover:bg-white/40'}`}
              data-target-index={i}
              aria-label={`Go to slide ${i + 1}`}
            ></button>
          ))}
        </div>

        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="prev-slide-btn"
            class="w-10 h-10 rounded-xl bg-white/5 hover:bg-white/15 border border-white/10 flex items-center justify-center text-white transition-all"
            aria-label="Previous slide"
          >
            &#8592;
          </button>
          <button 
            type="button" 
            id="next-slide-btn"
            class="w-10 h-10 rounded-xl bg-white/5 hover:bg-white/15 border border-white/10 flex items-center justify-center text-white transition-all"
            aria-label="Next slide"
          >
            &#8594;
          </button>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. THE 8 SERVICES: Grouped, Clean, Minimal & High-Converting              -->
  <!-- ========================================================================= -->
  <section class="py-16 md:py-24 bg-[#FAFBFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {serviceGroups.map((group) => (
        <div class="space-y-6">
          
          <div class="border-b border-slate-200/80 pb-3">
            <h2 class="text-xl sm:text-2xl font-black text-[#0F172A] tracking-tight">
              {group.groupTitle}
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
              {group.groupSubtitle}
            </p>
          </div>

          <div class={`grid grid-cols-1 md:grid-cols-${group.items.length > 2 ? '3' : '2'} gap-6`}>
            {group.items.map((service) => (
              <div class="group bg-white rounded-2xl border border-slate-200/80 p-6 shadow-2xs hover:shadow-md hover:border-slate-300 transition-all duration-300 flex flex-col justify-between">
                
                <div>
                  
                  <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${service.themeColor} text-white flex items-center justify-center mb-5 shadow-sm group-hover:scale-105 transition-transform duration-300`}>
                    {service.iconType === 'code' && (
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                    )}
                    {service.iconType === 'web' && (
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                    )}
                    {service.iconType === 'cart' && (
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                    )}
                    {service.iconType === 'figma' && (
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>
                    )}
                    {service.iconType === 'seo' && (
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
                    )}
                    {service.iconType === 'shield' && (
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                    )}
                    {service.iconType === 'dns' && (
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    )}
                    {service.iconType === 'cloud' && (
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>
                    )}
                  </div>

                  <h3 class="text-lg font-bold text-[#0F172A] mb-2 group-hover:text-indigo-600 transition-colors">
                    {service.title}
                  </h3>

                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6 font-normal">
                    {service.desc}
                  </p>

                </div>

                <div>
                  
                  <div class="flex flex-wrap gap-1.5 mb-6 pt-4 border-t border-slate-100">
                    {service.tags.map((tag) => (
                      <span class="text-[11px] font-medium text-slate-600 bg-slate-50 px-2.5 py-1 rounded-md border border-slate-150">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <div class="flex items-center justify-between pt-2">
                    <a 
                      href={`/start-a-project/?service=${service.slug}`} 
                      class="text-xs font-bold text-slate-900 group-hover:text-indigo-600 transition-colors flex items-center gap-1.5"
                    >
                      <span>Start this service</span>
                      <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                    </a>

                    <a 
                      href={`/services/${service.slug}/`} 
                      class="text-[11px] text-slate-400 hover:text-slate-700 transition-colors"
                    >
                      Details
                    </a>
                  </div>

                </div>

              </div>
            ))}
          </div>

        </div>
      ))}

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. HONEST CLIENT REASSURANCE: 3 Clear Pillars                             -->
  <!-- ========================================================================= -->
  <section class="py-16 md:py-24 bg-white border-t border-slate-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0F172A]">
          Why Deals Succeed With SoftDows
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          We built our studio to eliminate common client frustrations with typical agencies.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="p-6 rounded-2xl bg-slate-50/70 border border-slate-200/80 space-y-3">
          <div class="text-2xl">🤝</div>
          <h3 class="text-base font-bold text-[#0F172A]">Complete IP Ownership</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            You own 100% of your source code, repositories, and database schemas. We never lock you into dependencies or retainers.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50/70 border border-slate-200/80 space-y-3">
          <div class="text-2xl">⚡</div>
          <h3 class="text-base font-bold text-[#0F172A]">Sub-Second Speed</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            We engineer lightweight code on modern edge CDNs. Your visitors enjoy instantaneous page loads on mobile phones without lag.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50/70 border border-slate-200/80 space-y-3">
          <div class="text-2xl">💬</div>
          <h3 class="text-base font-bold text-[#0F172A]">Direct Senior Communication</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            No middle managers or lost messages. You talk directly with the senior engineers actually writing your code.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. GENTLE, HIGH-CONVERTING INVITATION                                     -->
  <!-- ========================================================================= -->
