---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { services } from '../../lib/db/schema/agency';
import { eq, asc } from 'drizzle-orm';

export const prerender = false;

const db = getDb((env as any).DB);
const allServices = await db.select().from(services)
  .where(eq(services.isVisible, true))
  .orderBy(asc(services.displayOrder))
  .all();
---
<MainLayout title="Our Services" description="SoftDows digital services">
  <Section variant="light" size="large" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-[var(--color-brand-navy)] mb-6">Our Services</h1>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto">Comprehensive digital engineering solutions.</p>
    </div>
  </Section>

  <Section variant="default" size="large">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8">
        {allServices.map(service => (
          <a href={`/services/${service.slug}/`} class="group block p-8 rounded-3xl bg-white border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 h-full flex flex-col">
            <h3 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-4">{service.name}</h3>
            <p class="text-slate-600 leading-relaxed mb-6 flex-grow">{service.shortDescription}</p>
            <div class="text-[var(--color-brand-purple)] font-medium inline-flex items-center gap-2 group-hover:gap-3 transition-all">
              Learn more <span aria-hidden="true">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </Section>
</MainLayout>
