  <!-- Interactive Slider Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = document.querySelectorAll('.hero-slide');
      const indicators = document.querySelectorAll('.slide-indicator-btn');
      const prevBtn = document.getElementById('prev-slide-btn');
      const nextBtn = document.getElementById('next-slide-btn');

      let currentIndex = 0;
      let slideInterval;

      function showSlide(index) {
        slides.forEach((slide, i) => {
          if (i === index) {
            slide.classList.remove('opacity-0', 'translate-x-8', 'absolute', 'pointer-events-none');
            slide.classList.add('opacity-100', 'translate-x-0', 'relative');
          } else {
            slide.classList.remove('opacity-100', 'translate-x-0', 'relative');
            slide.classList.add('opacity-0', 'translate-x-8', 'absolute', 'pointer-events-none');
          }
        });

        indicators.forEach((ind, i) => {
          if (i === index) {
            ind.classList.remove('w-3', 'bg-white/20');
            ind.classList.add('w-10', 'bg-cyan-400');
          } else {
            ind.classList.remove('w-10', 'bg-cyan-400');
            ind.classList.add('w-3', 'bg-white/20');
          }
        });

        currentIndex = index;
      }

      function nextSlide() {
        const next = (currentIndex + 1) % slides.length;
        showSlide(next);
      }

      function prevSlide() {
        const prev = (currentIndex - 1 + slides.length) % slides.length;
        showSlide(prev);
      }

      if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); resetTimer(); });
      if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); resetTimer(); });

      indicators.forEach(ind => {
        ind.addEventListener('click', () => {
          const target = parseInt(ind.getAttribute('data-target-index') || '0', 10);
          showSlide(target);
          resetTimer();
        });
      });

      function resetTimer() {
        clearInterval(slideInterval);
        slideInterval = setInterval(nextSlide, 6000);
      }

      slideInterval = setInterval(nextSlide, 6000);
    });
  </script>

