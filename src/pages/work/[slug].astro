---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('work');
  return items.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
import { render } from 'astro:content';
const { Content } = await render(entry);
---
<MainLayout title={`${entry.data.title} | SoftDows Work`} description={entry.data.projectSummary}>
  <article class="px-6 py-24 sm:py-32 lg:px-8 bg-white min-h-screen">
    <div class="mx-auto max-w-3xl">
      <p class="text-base font-semibold leading-7 text-indigo-600">{entry.data.industry}</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">{entry.data.title}</h1>
      <p class="mt-6 text-xl leading-8 text-gray-700">{entry.data.projectSummary}</p>
      
      <div class="mt-10 max-w-2xl prose prose-indigo prose-lg text-gray-600">
        <Content />
      </div>
    </div>
  </article>
</MainLayout>



