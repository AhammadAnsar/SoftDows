---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { servicesData } from '../../config/services';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const allWork = await getCollection('work');
  // Only build pages for published projects
  const publishedWork = allWork.filter(project => !project.data.isDraft);
  
  return publishedWork.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { 
  title, 
  seoTitle, 
  seoDescription, 
  client, 
  industry, 
  projectSummary, 
  featuredImage, 
  imageAlt, 
  challenge, 
  objectives, 
  solution, 
  approach, 
  results, 
  testimonial, 
  servicesUsed, 
  deliverables, 
  projectUrl 
} = entry.data;

// Map services used to real service objects
const relatedServices = servicesData.filter(s => servicesUsed?.includes(s.id));
---

<MainLayout 
  title={seoTitle || `${title} | Case Study | SoftDows`}
  description={seoDescription || projectSummary}
>
  <!-- HERO -->
  <Section variant="dark" size="large" class="pt-32 pb-32 md:pt-48 md:pb-40 bg-[var(--color-brand-navy)] text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-indigo-900/50 to-transparent pointer-events-none"></div>
    <div class="absolute top-0 right-0 w-full max-w-2xl aspect-square bg-[var(--color-brand-purple)]/20 rounded-full blur-[120px] pointer-events-none"></div>
    
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <Badge variant="inverse" class="mb-8">{industry}</Badge>
      <h1 class="mb-8 text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05]">
        {title}
      </h1>
      <p class="mb-12 text-xl md:text-2xl text-[var(--color-brand-light)] font-light leading-relaxed max-w-3xl mx-auto opacity-90">
        {projectSummary}
      </p>
      {client && (
        <div class="flex items-center justify-center gap-4 text-white font-medium border-t border-white/10 pt-8 mt-4 max-w-lg mx-auto">
          <span class="text-[var(--color-brand-light)] opacity-70 uppercase tracking-widest text-sm">Client Partner</span>
          <span class="text-lg">{client}</span>
        </div>
      )}
    </div>
  </Section>

  <!-- FEATURED IMAGE OR PLACEHOLDER -->
  <div class="px-6 lg:px-8 max-w-7xl mx-auto -mt-20 md:-mt-32 relative z-20 mb-16 md:mb-24">
    {featuredImage ? (
      <div class="rounded-[2rem] overflow-hidden shadow-2xl border-4 border-white bg-slate-50 aspect-video group">
        <img 
          src={typeof featuredImage === 'string' ? featuredImage : featuredImage.src} 
          alt={imageAlt || `Featured image for ${title}`} 
          class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
        />
      </div>
    ) : (
      <div class="rounded-[2rem] overflow-hidden shadow-2xl border-4 border-white bg-slate-100 aspect-video flex items-center justify-center relative group">
        <div class="absolute inset-0 bg-gradient-to-br from-indigo-50 to-slate-100 opacity-50 group-hover:scale-105 transition-transform duration-700"></div>
        <div class="text-center relative z-10 p-8">
           <svg class="w-16 h-16 mx-auto text-slate-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
           <h3 class="text-xl font-bold text-slate-400">Cinematic Case Study Media</h3>
           <p class="text-slate-400 mt-2">Awaiting high-resolution asset from CMS</p>
        </div>
      </div>
    )}
  </div>

  <!-- PROJECT OVERVIEW / DETAILS -->
  <Section variant="default" size="normal">
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-16 pb-16 border-b border-[var(--color-border-subtle)]">
        {deliverables && deliverables.length > 0 && (
          <div class="md:col-span-2">
            <h3 class="text-xl font-bold mb-4 text-[var(--color-brand-navy)]">Deliverables</h3>
            <ul class="space-y-3">
              {deliverables.map(item => (
                <li class="flex items-start gap-3">
                  <svg class="h-6 w-6 text-[var(--color-brand-purple)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span class="text-[var(--color-text-main)]">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        
        <div>
          {projectUrl && (
            <div class="mb-8">
              <h3 class="text-lg font-bold mb-2 text-[var(--color-brand-navy)]">Live Project</h3>
              <a href={projectUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--color-brand-purple)] hover:underline break-all">
                {projectUrl.replace(/^https?:\/\//, '')}
              </a>
            </div>
          )}
          {relatedServices.length > 0 && (
            <div>
              <h3 class="text-lg font-bold mb-3 text-[var(--color-brand-navy)]">Services Applied</h3>
              <div class="flex flex-wrap gap-2">
                {relatedServices.map(service => (
                  <a href={service.href} class="inline-block px-3 py-1 bg-[var(--color-surface-alt)] hover:bg-gray-100 text-sm font-medium text-[var(--color-brand-navy)] rounded-full transition-colors">
                    {service.title}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      <!-- MAIN CONTENT BLOCKS -->
      <div class="space-y-16">
        {challenge && (
          <div>
            <h2 class="text-3xl font-bold mb-6 text-[var(--color-brand-navy)]">The Challenge</h2>
            <div class="prose prose-lg text-[var(--color-text-muted)] max-w-none" set:html={challenge} />
          </div>
        )}

        {objectives && (
          <div>
            <h2 class="text-3xl font-bold mb-6 text-[var(--color-brand-navy)]">Objectives</h2>
            <div class="prose prose-lg text-[var(--color-text-muted)] max-w-none" set:html={objectives} />
          </div>
        )}

        {solution && (
          <div>
            <h2 class="text-3xl font-bold mb-6 text-[var(--color-brand-navy)]">The Solution</h2>
            <div class="prose prose-lg text-[var(--color-text-muted)] max-w-none" set:html={solution} />
          </div>
        )}

        {approach && (
          <div>
            <h2 class="text-3xl font-bold mb-6 text-[var(--color-brand-navy)]">Implementation & Approach</h2>
            <div class="prose prose-lg text-[var(--color-text-muted)] max-w-none" set:html={approach} />
          </div>
        )}
        
        {results && results.length > 0 && (
          <div>
            <h2 class="text-3xl font-bold mb-6 text-[var(--color-brand-navy)]">Verified Results</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {results.map(result => (
                <div class="bg-[var(--color-surface-alt)] p-6 rounded-xl border border-[var(--color-border-subtle)]">
                  <p class="text-lg font-medium text-[var(--color-brand-navy)]">{result}</p>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </Section>

  <!-- TESTIMONIAL -->
  {testimonial && (
    <Section variant="alternate" size="normal">
      <div class="max-w-4xl mx-auto">
        <blockquote class="bg-white p-8 md:p-12 rounded-2xl border border-[var(--color-border-subtle)] shadow-sm text-center">
          <svg class="w-10 h-10 mx-auto mb-6 text-[var(--color-brand-purple)] opacity-30" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
          <p class="text-xl md:text-2xl font-medium text-[var(--color-brand-navy)] leading-relaxed mb-8">
            "{testimonial.quote}"
          </p>
          <cite class="not-italic">
            <span class="block font-bold text-[var(--color-brand-navy)]">{testimonial.author}</span>
            {testimonial.role && <span class="block text-[var(--color-text-muted)] mt-1">{testimonial.role}</span>}
          </cite>
        </blockquote>
      </div>
    </Section>
  )}

  <!-- FINAL CTA -->
  <Section variant="dark" size="normal" class="text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-6 text-3xl md:text-5xl font-bold text-white tracking-tight">Ready for similar results?</h2>
      <p class="mb-10 text-lg sm:text-xl text-[var(--color-brand-light)] opacity-90 leading-relaxed">
        Discuss your technical requirements with our engineering team.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
        <Button href="/start-a-project/" variant="secondary" class="w-full sm:w-auto text-lg px-8 py-3">Start a Project</Button>
        <Button href="/work/" variant="ghost" class="w-full sm:w-auto text-lg px-8 py-3 text-white hover:bg-white/10">View More Work</Button>
      </div>
    </div>
  </Section>
</MainLayout>


