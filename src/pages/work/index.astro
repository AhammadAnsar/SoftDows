---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const items = await getCollection('work');

const title = "Our Work | SoftDows";
const description = "Explore our case studies and successful projects.";
---
<MainLayout title={title} description={description}>
  <div class="bg-white px-6 py-24 sm:py-32 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Our Work</h2>
        <p class="mt-2 text-lg leading-8 text-gray-600">Discover how we help our clients succeed.</p>
      </div>
      <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-3">
        {items.map(item => (
          <article class="flex flex-col items-start justify-between bg-slate-50 p-6 rounded-2xl border border-slate-100 hover:shadow-lg transition-shadow">
            <div class="max-w-xl">
              <div class="flex items-center gap-x-4 text-xs">
                <span class="text-indigo-600 font-semibold bg-indigo-50 px-2 py-1 rounded-md">{item.data.industry}</span>
              </div>
              <div class="group relative">
                <h3 class="mt-3 text-lg font-semibold leading-6 text-slate-900 group-hover:text-indigo-600 transition-colors">
                  <a href={`/work/${item.id}/`}>
                    <span class="absolute inset-0"></span>
                    {item.data.title}
                  </a>
                </h3>
                <p class="mt-5 line-clamp-3 text-sm leading-6 text-slate-600">{item.data.projectSummary}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</MainLayout>


