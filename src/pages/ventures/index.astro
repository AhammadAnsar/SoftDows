    glowColor: 'group-hover:border-rose-400/50 group-hover:shadow-rose-500/10',
    metricBadge: '1M+ Monthly Readers',
    audienceIcon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
    tags: [
      { label: 'Public Notices', icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z' },
      { label: 'Exam Circulars', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
      { label: 'Instant Updates', icon: 'M13 10V3L4 14h7v7l9-11h-7z' }
    ]
  },
  bidyashikhi: {
    accentColor: '#059669',
    badgeBg: 'bg-emerald-50 border-emerald-200/80 text-emerald-700',
    badgeText: 'EdTech & Skill LMS',
    gradientBg: 'from-emerald-500/10 via-teal-500/5 to-transparent',
    glowColor: 'group-hover:border-emerald-400/50 group-hover:shadow-emerald-500/10',
    metricBadge: 'Accessible Learning',
    audienceIcon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
    tags: [
      { label: 'Skill Building', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
      { label: 'Bengali Tutorials', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
      { label: 'Academic Pathways', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' }
    ]
  },
  nicetrix: {
    accentColor: '#6366F1',
    badgeBg: 'bg-indigo-50 border-indigo-200/80 text-indigo-700',
    badgeText: 'Tech & Lifestyle Guides',
    gradientBg: 'from-indigo-500/10 via-purple-500/5 to-transparent',
    glowColor: 'group-hover:border-indigo-400/50 group-hover:shadow-indigo-500/10',
    metricBadge: 'Modern Tech Guides',
    audienceIcon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    tags: [
      { label: 'AI Trends', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
      { label: 'Everyday Tech', icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z' },
      { label: 'Career Tactics', icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' }
    ]
  },
  baharimart: {
    accentColor: '#EA580C',
    badgeBg: 'bg-amber-50 border-amber-200/80 text-amber-800',
    badgeText: 'Modern Commerce',
    gradientBg: 'from-amber-500/10 via-orange-500/5 to-transparent',
    glowColor: 'group-hover:border-amber-400/50 group-hover:shadow-amber-500/10',
    metricBadge: 'Direct-to-Consumer',
    audienceIcon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
    tags: [
      { label: 'eCommerce Engine', icon: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z' },
      { label: 'Instant Checkout', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
      { label: 'Consumer Goods', icon: 'M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4' }
