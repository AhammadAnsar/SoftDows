---
export const prerender = true;

<MainLayout 
  title="Ventures We Operate | SoftDows Venture Studio" 
  description="Discover proprietary digital brands, educational portals, and content networks incubated, engineered, and operated entirely by SoftDows."
>
  
  <!-- ========================================================================= -->
  <!-- 1. HERO: Futuristic Studio Stage with Geometric Mesh & Floating Badges   -->
  <!-- ========================================================================= -->
  <section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 bg-[#0A0D1E] text-white border-b border-slate-800">
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[800px] h-[400px] rounded-full bg-gradient-to-r from-[#5568d3]/20 via-purple-600/15 to-pink-500/10 blur-[120px]"></div>
      <div class="absolute top-[40%] -right-[10%] w-[500px] h-[500px] rounded-full bg-gradient-to-bl from-indigo-500/10 to-transparent blur-3xl"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:40px_40px]"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/[0.08] border border-white/10 text-xs font-semibold text-indigo-300 backdrop-blur-md mb-6">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="tracking-wider uppercase">Pillar 03 // Studio Brands</span>
      </div>

      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] mb-5 text-white">
          Digital Brands Born in <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-indigo-200 to-[#818cf8]">
            Our Own Laboratory
          </span>
        </h1>
        <p class="text-sm sm:text-lg text-slate-300 font-normal leading-relaxed max-w-2xl">
          We don't merely consult—we build, launch, and operate proprietary digital platforms that command organic reach and real-world scale.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mt-10 pt-8 border-t border-white/10">
        
        <div class="p-3.5 sm:p-4 rounded-xl bg-white/[0.04] border border-white/10 flex items-center gap-3 backdrop-blur-sm">
          <div class="w-10 h-10 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center shrink-0 border border-indigo-500/30">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <div>
            <div class="text-sm sm:text-base font-bold text-white">100% In-House</div>
            <div class="text-[10px] sm:text-xs text-slate-400">Zero External Lock-in</div>
          </div>
        </div>

        <div class="p-3.5 sm:p-4 rounded-xl bg-white/[0.04] border border-white/10 flex items-center gap-3 backdrop-blur-sm">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/30">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div>
            <div class="text-sm sm:text-base font-bold text-white">Sub-100ms Edge</div>
            <div class="text-[10px] sm:text-xs text-slate-400">Cloudflare Powered</div>
          </div>
        </div>

        <div class="p-3.5 sm:p-4 rounded-xl bg-white/[0.04] border border-white/10 flex items-center gap-3 backdrop-blur-sm">
          <div class="w-10 h-10 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center shrink-0 border border-purple-500/30">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <div>
            <div class="text-sm sm:text-base font-bold text-white">Millions Reached</div>
            <div class="text-[10px] sm:text-xs text-slate-400">Pure Organic Discovery</div>
          </div>
        </div>

        <div class="p-3.5 sm:p-4 rounded-xl bg-white/[0.04] border border-white/10 flex items-center gap-3 backdrop-blur-sm">
          <div class="w-10 h-10 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 border border-rose-500/30">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <div class="text-sm sm:text-base font-bold text-white">Production Testing</div>
            <div class="text-[10px] sm:text-xs text-slate-400">Battlefield for Code</div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. VENTURES SHOWCASE: Stylish, Shape-Infused Visual Cards                -->
  <!-- ========================================================================= -->
  <section class="py-16 md:py-24 bg-[#F8FAFD] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-12 gap-4">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-[#5568d3] mb-1">Portfolio Brands</div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-[#192040]">
            The Active Studio Fleet
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-xl">
            Each venture operates with continuous deployment, high-speed edge caching, and semantic content pipelines.
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs font-semibold text-emerald-800 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>4 Live Properties</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {allVentures.map((v) => {
          const style = ventureStyles[v.slug] || {
            accentColor: '#5568d3',
            badgeBg: 'bg-indigo-50 border-indigo-200 text-indigo-700',
            badgeText: v.category || 'Digital Platform',
            gradientBg: 'from-indigo-500/10 via-purple-500/5 to-transparent',
            glowColor: 'group-hover:border-indigo-400/50 group-hover:shadow-indigo-500/10',
            metricBadge: 'Active Venture',
            audienceIcon: 'M13 10V3L4 14h7v7l9-11h-7z',
            tags: [{ label: 'High Availability', icon: 'M9 12l2 2 4-4' }]
          };

          return (
            <div class={`group relative bg-white rounded-3xl border border-slate-200/90 shadow-sm hover:shadow-2xl transition-all duration-300 overflow-hidden flex flex-col justify-between ${style.glowColor} hover:-translate-y-1`}>
              
              <div class={`absolute top-0 left-0 right-0 h-32 bg-gradient-to-br ${style.gradientBg} pointer-events-none`}></div>

              <div class="relative p-6 sm:p-8">
                
                <div class="flex items-start justify-between gap-3 mb-6">
                  
                  <div class="relative">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-white border border-slate-200/80 p-2.5 shadow-sm group-hover:scale-105 group-hover:shadow-md transition-all duration-300 flex items-center justify-center">
                      {(v as any).logo ? (
                        <img 
                          src={(v as any).logo} 
                          alt={`${v.brandName} official logo`} 
                          class="w-full h-full object-contain rounded-md"
                          loading="lazy" 
                        />
                      ) : (
                        <span class="font-extrabold text-2xl text-[#192040]">{v.brandName.charAt(0)}</span>
                      )}
                    </div>
                    <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-white border-2 border-white flex items-center justify-center shadow-xs">
                      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    </span>
                  </div>

                  <div class="flex flex-col items-end gap-1.5">
                    <span class={`text-[10px] sm:text-xs font-bold px-2.5 py-1 rounded-md border ${style.badgeBg}`}>
                      {style.badgeText}
                    </span>
                    <span class="text-[10px] font-semibold text-slate-500 bg-slate-100/90 px-2 py-0.5 rounded border border-slate-200/60 flex items-center gap-1">
                      <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={style.audienceIcon} />
                      </svg>
                      <span>{style.metricBadge}</span>
                    </span>
                  </div>

                </div>

                <div class="mb-6">
                  <div class="flex items-baseline gap-2 mb-1">
                    <h3 class="text-xl sm:text-2xl font-extrabold text-[#192040] group-hover:text-[#5568d3] transition-colors tracking-tight">
                      {v.brandName}
                    </h3>
                    {(v as any).localName && (
                      <span class="text-xs sm:text-sm font-semibold text-slate-500 font-bengali">
                        ({(v as any).localName})
                      </span>
                    )}
                  </div>
                  
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-2">
                    {v.shortDescription}
                  </p>
                </div>

                <div class="flex flex-wrap gap-2 pt-2">
                  {style.tags.map(t => (
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-slate-700 bg-slate-50 hover:bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-200/70 transition-colors">
                      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={t.icon} />
                      </svg>
                      <span>{t.label}</span>
                    </span>
                  ))}
                </div>

              </div>

              <div class="px-6 py-4 sm:px-8 sm:py-4 bg-slate-50/70 border-t border-slate-100 flex items-center justify-between">
                
                {(v as any).externalUrl ? (
                  <a 
                    href={(v as any).externalUrl} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-xs font-semibold text-slate-600 hover:text-[#192040] transition-colors"
                  >
                    <span>Visit Live Site</span>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ) : (
                  <span class="text-xs font-medium text-slate-400">Internal Property</span>
                )}

                <a 
                  href={`/ventures/${v.slug}/`} 
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-[#5568d3] hover:text-indigo-700 transition-colors group-hover:translate-x-0.5 duration-200"
                >
                  <span>Inside Architecture</span>
                  <span>&rarr;</span>
                </a>

              </div>

            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. THE STUDIO FLYWHEEL: Geometric Architecture Workflow Diagram         -->
  <!-- ========================================================================= -->
  <section class="py-16 md:py-24 bg-white border-t border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="text-xs font-bold uppercase tracking-wider text-[#5568d3] mb-1">Operating Methodology</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#192040]">
          The Venture Growth Flywheel
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-2">
          How SoftDows conceives, engineers, and compounds value through self-sustaining digital assets.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        
        <!-- Step 1 -->
        <div class="relative p-6 sm:p-8 rounded-2xl bg-[#FAFBFD] border border-slate-200 flex flex-col justify-between group hover:border-[#5568d3]/30 transition-all">
          <div class="absolute -top-4 left-6 bg-[#192040] text-white text-[10px] font-mono font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
            Phase 01 // Signal
          </div>
          <div>
            <div class="w-12 h-12 rounded-xl bg-indigo-50 border border-indigo-100 text-[#5568d3] flex items-center justify-center mb-5 mt-2">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#192040] mb-2">Unmet Market Signals</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              We detect high-intent search queries and regional knowledge gaps where existing solutions are outdated or slow.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200/60 flex items-center gap-2 text-[11px] font-semibold text-indigo-600">
            <span>✓ Organic Demand First</span>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="relative p-6 sm:p-8 rounded-2xl bg-[#FAFBFD] border border-slate-200 flex flex-col justify-between group hover:border-emerald-400/30 transition-all">
          <div class="absolute -top-4 left-6 bg-emerald-800 text-white text-[10px] font-mono font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
            Phase 02 // Build
          </div>
          <div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center mb-5 mt-2">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#192040] mb-2">Edge-First Architecture</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Engineered with Astro SSG and Cloudflare CDN caches, delivering sub-second page loads at near-zero operating costs.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200/60 flex items-center gap-2 text-[11px] font-semibold text-emerald-600">
            <span>✓ Zero Server Overhead</span>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="relative p-6 sm:p-8 rounded-2xl bg-[#FAFBFD] border border-slate-200 flex flex-col justify-between group hover:border-purple-400/30 transition-all">
          <div class="absolute -top-4 left-6 bg-purple-900 text-white text-[10px] font-mono font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
            Phase 03 // Compound
          </div>
          <div>
            <div class="w-12 h-12 rounded-xl bg-purple-50 border border-purple-100 text-purple-600 flex items-center justify-center mb-5 mt-2">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#192040] mb-2">Compounding Audience</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              High domain trust and zero-paid-ad flywheels that turn millions of visitors into loyal daily community users.
