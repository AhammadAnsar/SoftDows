---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { ventures } from '../../lib/db/schema/cms';
import { eq, asc } from 'drizzle-orm';

export const prerender = false;

const db = getDb((env as any).DB);
const allVentures = await db.select().from(ventures)
  .where(eq(ventures.isVisible, true))
  .orderBy(asc(ventures.displayOrder))
  .all();
---
<MainLayout title="Ventures" description="SoftDows Internal Ventures">
  <Section variant="light" size="large" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6">Internal Ventures</h1>
    </div>
  </Section>
  <Section variant="default" size="large">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-8">
      {allVentures.map(v => (
        <a href={`/ventures/${v.slug}/`} class="block p-8 border rounded-3xl hover:shadow-xl transition-all">
          <h3 class="text-2xl font-bold mb-4">{v.brandName}</h3>
          <p class="text-slate-600">{v.shortDescription}</p>
        </a>
      ))}
    </div>
  </Section>
</MainLayout>
