---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Badge from '../../components/ui/Badge.astro';
import { getPublishedVentures } from '../../lib/content/ventures';

const publishedVentures = getPublishedVentures();
---
<MainLayout title="SoftDows Ventures | Owned & Operated Platforms" description="Explore SoftDows internal ventures, digital platforms, and brands.">
  <Section variant="light" size="large" class="pt-28 pb-20 md:pt-40 md:pb-32 bg-slate-50 border-b border-slate-100 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-100/50 via-transparent to-transparent opacity-70"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <Badge variant="primary" class="mb-6">Our Brands</Badge>
      <h1 class="mb-8 text-5xl md:text-6xl text-[var(--color-brand-navy)] font-bold tracking-tight leading-[1.05]">
        SoftDows Ventures
      </h1>
      <p class="text-xl md:text-2xl font-light text-[var(--color-text-muted)] leading-relaxed">
        Beyond our client work, we actively build, own, and operate a portfolio of digital platforms and regional brands.
      </p>
    </div>
  </Section>

  <Section variant="default" size="normal">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-6xl mx-auto">
      {publishedVentures.map(venture => (
        <a href={`/ventures/${venture.slug}/`} class="group flex flex-col md:flex-row gap-8 p-8 border border-slate-200 rounded-3xl hover:border-[var(--color-brand-purple)]/40 hover:shadow-xl transition-all duration-300 bg-white">
          <div class="flex-shrink-0">
            <div class="w-24 h-24 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center text-3xl font-bold text-[var(--color-brand-navy)] group-hover:scale-105 group-hover:shadow-md transition-all">
              {venture.brandName.substring(0, 2).toUpperCase()}
            </div>
          </div>
          <div class="flex flex-col justify-center">
            <h2 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-2 group-hover:text-[var(--color-brand-purple)] transition-colors">{venture.brandName}</h2>
            {venture.localName && <p class="text-slate-500 font-medium mb-3">{venture.localName}</p>}
            <p class="text-[var(--color-text-muted)] leading-relaxed mb-4">{venture.shortDescription}</p>
            <span class="text-[var(--color-brand-purple)] font-semibold inline-flex items-center">
              Explore {venture.brandName} &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </Section>
</MainLayout>
