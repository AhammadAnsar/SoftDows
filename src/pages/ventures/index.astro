---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import { getPublishedVentures } from '../../lib/content/ventures';



// Cloudflare Edge Caching Header (Zero Worker Compute Cost)


const allVentures = getPublishedVentures();

// Visual identity and aesthetic attributes for each venture
