---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { ventures } from '../../lib/db/schema/cms';
import { eq, and } from 'drizzle-orm';

export const prerender = false;

const db = getDb((env as any).DB);
const slug = Astro.params.slug as string;

const venture = await db.select().from(ventures)
  .where(and(eq(ventures.slug, slug), eq(ventures.isVisible, true)))
  .get();

if (!venture) return Astro.redirect('/404');
---
<MainLayout title={venture.seoTitle || venture.brandName} description={venture.seoDescription || undefined}>
  <Section variant="light" size="large" class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-bold mb-6">{venture.brandName}</h1>
      <p class="text-xl text-slate-600">{venture.fullDescription}</p>
      {venture.externalUrl && venture.slug !== 'gulfhive' && (
        <a href={venture.externalUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-block bg-[var(--color-brand-purple)] text-white px-6 py-3 rounded-md">Visit Website</a>
      )}
    </div>
  </Section>
</MainLayout>
