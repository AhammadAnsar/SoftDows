---
import MainLayout from '../../layouts/MainLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { ventures } from '../../lib/db/schema/cms';
import { eq, and } from 'drizzle-orm';

export const prerender = false;

// Optimize Cloudflare Resources by setting a cache-control header (Edge caching)
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=3600, stale-while-revalidate=86400');

const db = getDb((env as any).DB);
const slug = Astro.params.slug as string;

const venture = await db.select().from(ventures)
  .where(and(eq(ventures.slug, slug), eq(ventures.isVisible, true)))
  .get();

if (!venture) return Astro.redirect('/404');

// Fallback Generic SVG Icons
const icons = {
  check: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  lightning: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>`,
  star: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>`,
  globe: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>`,
  shield: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
  sparkles: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" /></svg>`,
  cube: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" /></svg>`,
  arrowRight: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>`,
  openNew: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>`
};

// Dynamic Theme Configuration based on Venture Slug
const themeConfig = {
  banglanotice: {
    gradient: 'from-red-600 to-rose-700',
    lightGradient: 'from-red-50 to-white',
    icon: icons.globe,
    features: [
      { icon: icons.lightning, title: 'Live Updates', desc: 'Real-time educational news and job circulars.' },
      { icon: icons.check, title: 'Verified Info', desc: '100% authentic and fact-checked notices.' },
      { icon: icons.star, title: 'Community Driven', desc: 'Serving millions of students and job seekers.' }
    ]
  },
  bidyashikhi: {
    gradient: 'from-teal-600 to-emerald-700',
    lightGradient: 'from-teal-50 to-white',
    icon: icons.sparkles,
    features: [
      { icon: icons.cube, title: 'E-Learning', desc: 'Interactive online courses and tutorials.' },
      { icon: icons.star, title: 'Skill Development', desc: 'Focusing on practical and career-oriented skills.' },
      { icon: icons.lightning, title: 'Rich Media', desc: 'High-quality video lessons and resources.' }
    ]
  },
  nicetrix: {
    gradient: 'from-blue-600 to-indigo-700',
    lightGradient: 'from-blue-50 to-white',
    icon: icons.cube,
    features: [
      { icon: icons.sparkles, title: 'Tech Insights', desc: 'Latest technology tips, tricks and tutorials.' },
      { icon: icons.shield, title: 'Cybersecurity', desc: 'Best practices for safe digital experiences.' },
      { icon: icons.lightning, title: 'Productivity', desc: 'Tools and guides to enhance digital workflow.' }
    ]
  },
  baharimart: {
    gradient: 'from-orange-500 to-pink-600',
    lightGradient: 'from-orange-50 to-white',
    icon: icons.cube,
    features: [
      { icon: icons.lightning, title: 'Fast Delivery', desc: 'Reliable and swift e-commerce logistics.' },
      { icon: icons.shield, title: 'Secure Payment', desc: 'Multiple safe payment gateways integrated.' },
      { icon: icons.check, title: 'Quality Products', desc: 'Curated selection of premium items.' }
    ]
  },
  gulfhive: {
    gradient: 'from-amber-500 to-yellow-600',
    lightGradient: 'from-amber-50 to-white',
    icon: icons.globe,
    features: [
      { icon: icons.check, title: 'Expat Jobs', desc: 'Connecting talent with opportunities in the Gulf.' },
      { icon: icons.star, title: 'Networking', desc: 'Building communities for expatriates.' },
      { icon: icons.cube, title: 'Guidance', desc: 'Visa, travel, and settling-in information.' }
    ]
  }
};

const currentTheme = themeConfig[slug as keyof typeof themeConfig] || {
  gradient: 'from-[var(--color-brand-navy)] to-[var(--color-brand-purple)]',
  lightGradient: 'from-slate-50 to-white',
  icon: icons.sparkles,
  features: [
    { icon: icons.star, title: 'Premium Quality', desc: 'Engineered for high performance and reliability.' },
    { icon: icons.shield, title: 'Secure & Safe', desc: 'Built with industry-leading security practices.' },
    { icon: icons.lightning, title: 'Fast Execution', desc: 'Optimized for speed and efficiency.' }
  ]
};
---
<MainLayout title={`${venture.brandName} | SoftDows Ventures`} description={venture.shortDescription || venture.fullDescription || undefined}>
  
  {/* HERO SECTION */}
  <section class={`relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-gradient-to-br ${currentTheme.gradient} text-white`}>
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 flex flex-col md:flex-row items-center gap-12">
      <div class="w-full md:w-1/2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-sm border border-white/30 mb-6">
          <div class="w-5 h-5" set:html={currentTheme.icon}></div>
          <span class="text-sm font-medium tracking-wide uppercase">A SoftDows Venture</span>
        </div>
        
        <h1 class="text-4xl md:text-6xl font-bold mb-4 tracking-tight">
          {venture.brandName}
        </h1>
        
        {venture.localName && (
          <h2 class="text-2xl md:text-3xl font-medium text-white/90 mb-6">{venture.localName}</h2>
        )}
        
        <p class="text-lg md:text-xl text-white/80 mb-8 max-w-xl leading-relaxed">
          {venture.shortDescription || "A digital initiative by SoftDows, designed to bring innovation and practical solutions to the market."}
        </p>
        
        <div class="flex flex-wrap items-center gap-4">
          {venture.externalUrl ? (
            <a href={venture.externalUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white text-slate-900 px-8 py-3.5 rounded-lg font-semibold hover:bg-slate-50 transition-colors shadow-lg hover:shadow-xl hover:-translate-y-0.5 transform duration-200">
              Visit {venture.brandName}
              <div class="w-5 h-5" set:html={icons.openNew}></div>
            </a>
          ) : (
            <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md border border-white/30 text-white px-8 py-3.5 rounded-lg font-semibold">
              <div class="w-5 h-5" set:html={icons.cube}></div>
              Coming Soon
            </div>
          )}
        </div>
      </div>
      
      <div class="w-full md:w-1/2 flex justify-center md:justify-end">
        {venture.coverVisualKey ? (
          <img src={venture.coverVisualKey} alt={venture.brandName} class="w-full max-w-lg rounded-2xl shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-500 object-cover aspect-video bg-white" />
        ) : (
          <div class="w-full max-w-lg aspect-video rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 shadow-2xl flex items-center justify-center rotate-2 hover:rotate-0 transition-transform duration-500">
             <div class="w-32 h-32 text-white/50" set:html={currentTheme.icon}></div>
          </div>
        )}
      </div>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" class="w-full h-auto text-slate-50 fill-current" preserveAspectRatio="none">
        <path d="M0,120 L1440,120 L1440,0 C1120,120 720,40 0,60 Z"></path>
      </svg>
    </div>
  </section>

  {/* MAIN CONTENT SECTION */}
  <section class={`py-20 md:py-28 bg-gradient-to-b ${currentTheme.lightGradient}`}>
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col md:flex-row gap-16">
        
        {/* Left Column: Description */}
        <div class="w-full md:w-7/12">
          <Badge class="mb-4">Overview</Badge>
          <h3 class="text-3xl font-bold text-[var(--color-brand-navy)] mb-6">About {venture.brandName}</h3>
          <div class="prose prose-lg prose-slate text-[var(--color-text-muted)]">
            <p class="whitespace-pre-line leading-relaxed">
              {venture.fullDescription || "Detailed description is being updated. Stay tuned to learn more about how this venture brings value to its audience through innovative digital solutions."}
            </p>
          </div>
          
          <div class="mt-12 p-8 bg-white rounded-2xl shadow-sm border border-slate-100 flex items-start gap-6 relative overflow-hidden group hover:shadow-md transition-shadow">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-[var(--color-brand-purple)]/5 rounded-full group-hover:scale-150 transition-transform duration-500"></div>
            <div class={`p-4 rounded-xl bg-gradient-to-br ${currentTheme.gradient} text-white shrink-0 relative z-10 w-16 h-16`}>
              <div class="w-full h-full" set:html={icons.shield}></div>
            </div>
            <div class="relative z-10">
              <h4 class="text-xl font-bold text-slate-900 mb-2">Powered by SoftDows</h4>
              <p class="text-slate-600 leading-relaxed text-sm">
                As a core SoftDows venture, {venture.brandName} benefits from our elite engineering principles: clean architecture, robust security, scalability, and exceptional user experience.
              </p>
            </div>
          </div>
        </div>

        {/* Right Column: Features & Highlights */}
        <div class="w-full md:w-5/12">
          <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 p-8 border border-slate-100 relative overflow-hidden">
            <h3 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-8 relative z-10">Venture Highlights</h3>
            
            <div class="space-y-8 relative z-10">
              {currentTheme.features.map(feature => (
                <div class="flex gap-5 group">
                  <div class={`mt-1 w-12 h-12 flex items-center justify-center rounded-full bg-slate-50 shrink-0 text-slate-700 group-hover:bg-slate-100 transition-colors`}>
                    <div class="w-6 h-6" set:html={feature.icon}></div>
                  </div>
                  <div>
                    <h4 class="text-lg font-bold text-slate-900 mb-1">{feature.title}</h4>
                    <p class="text-slate-600 text-sm">{feature.desc}</p>
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-10 pt-8 border-t border-slate-100 relative z-10">
              <p class="text-sm font-medium text-slate-500 uppercase tracking-wider mb-4">Venture Status</p>
              <div class="flex items-center gap-3">
                <span class="relative flex h-3 w-3">
                  <span class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${venture.status === 'active' ? 'bg-emerald-400' : 'bg-amber-400'}`}></span>
                  <span class={`relative inline-flex rounded-full h-3 w-3 ${venture.status === 'active' ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
                </span>
                <span class="font-semibold text-slate-900 capitalize">{venture.status}</span>
              </div>
            </div>
          </div>
        </div>
        
      </div>
    </div>
  </section>
  
  {/* CTA SECTION */}
  <section class="py-24 bg-white relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-brand-navy)] mb-6">Want to learn more about {venture.brandName}?</h2>
      <p class="text-lg text-[var(--color-text-muted)] mb-10 max-w-2xl mx-auto">
        Explore the official website to see the services, features, and community in action, or get in touch with us for business inquiries.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        {venture.externalUrl && (
          <a href={venture.externalUrl} target="_blank" rel="noopener noreferrer" class={`inline-flex items-center justify-center px-8 py-4 text-white font-semibold rounded-lg bg-gradient-to-r ${currentTheme.gradient} shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1`}>
            Visit Official Site
            <div class="w-5 h-5 ml-2" set:html={icons.arrowRight}></div>
          </a>
        )}
        <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 text-[var(--color-brand-navy)] font-semibold rounded-lg bg-slate-50 border border-slate-200 hover:bg-slate-100 transition-colors duration-300">
          Contact SoftDows
        </a>
      </div>
    </div>
  </section>

</MainLayout>
