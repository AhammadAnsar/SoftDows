---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/ui/Section.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ConceptualVisual from '../../components/ui/ConceptualVisual.astro';
import { venturesData } from '../../lib/content/ventures';

export function getStaticPaths() {
  return Object.values(venturesData).filter(v => v.publicVisibility && v.status !== 'hidden').map(venture => ({
    params: { slug: venture.slug },
    props: { venture },
  }));
}

const { venture } = Astro.props;
---
<MainLayout title={venture.seoTitle} description={venture.seoDescription}>
  <Section variant="light" size="large" class="pt-28 pb-16 md:pt-40 md:pb-24 bg-slate-50 border-b border-slate-100">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-16 lg:gap-20">
      <div class="w-full lg:w-1/2">
        <Badge variant="primary" class="mb-6">{venture.category}</Badge>
        <h1 class="text-5xl md:text-6xl font-bold text-[var(--color-brand-navy)] mb-4 tracking-tight leading-[1.05]">
          {venture.brandName}
        </h1>
        {venture.localName && <p class="text-2xl text-[var(--color-brand-purple)] font-medium mb-8">{venture.localName}</p>}
        <p class="text-xl text-[var(--color-text-muted)] leading-relaxed mb-10 max-w-xl font-light">
          {venture.description}
        </p>
        
        <div class="space-y-6 mb-10">
          <div>
            <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-2">SoftDows Role</h3>
            <p class="font-medium text-slate-800">{venture.softdowsRole}</p>
          </div>
          <div>
            <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-2">Primary Audience</h3>
            <p class="text-slate-800">{venture.audience}</p>
          </div>
        </div>

        {venture.externalUrl && (
          <Button href={venture.externalUrl} variant="primary" size="large">{venture.websiteCTA}</Button>
        )}
      </div>
      <div class="w-full lg:w-1/2">
        <ConceptualVisual concept="ui-ux" class="w-full h-[400px] lg:h-[550px] shadow-2xl rounded-3xl" />
      </div>
    </div>
  </Section>

  {venture.keyFocus.length > 0 && (
    <Section variant="default" size="normal">
      <div class="max-w-3xl mb-12 text-center mx-auto">
        <h2 class="text-3xl font-bold text-[var(--color-brand-navy)] mb-6">Key Focus Areas</h2>
      </div>
      <div class="flex flex-wrap justify-center gap-4 max-w-4xl mx-auto">
        {venture.keyFocus.map(focus => (
          <div class="px-6 py-3 bg-slate-50 border border-slate-200 rounded-full text-slate-800 font-medium">
            {focus}
          </div>
        ))}
      </div>
    </Section>
  )}
</MainLayout>
