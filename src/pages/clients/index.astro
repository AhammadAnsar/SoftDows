---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import { clientPartners } from '../../lib/content/clients';
---
<MainLayout 
  title="Client Success & Case Studies" 
  description="Explore how SoftDows empowers businesses and institutions with robust digital platforms and custom software."
>
  <div class="bg-[#FCFDFE] pt-12 pb-24 min-h-screen">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li><a href="/" class="hover:text-[#5568d3] transition-colors">Home</a></li>
          <li><span class="text-slate-300">/</span></li>
          <li><span class="text-slate-900 font-medium">Clients</span></li>
        </ol>
      </nav>

      <div class="mb-16 max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-extrabold text-[#192040] mb-4">Client Portfolio</h1>
        <p class="text-lg text-slate-600">Discover the organizations, institutions, and enterprises that trust SoftDows to engineer their digital infrastructure.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {clientPartners.map(client => (
          <a href={`/clients/${client.id}`} class="group flex flex-col bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-[#5568d3] hover:shadow-xl hover:shadow-[#5568d3]/10 transition-all duration-300">
            <div class="p-8 flex flex-col items-center justify-center bg-slate-50/50 border-b border-slate-100 aspect-video relative">
              <img src={client.logo} alt={`${client.name} Logo`} class="h-16 w-auto object-contain mix-blend-multiply group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <div class="flex items-start justify-between gap-4 mb-3">
                <h2 class="text-xl font-bold text-[#192040] leading-tight">{client.name}</h2>
              </div>
              
              {client.regionalBadge ? (
                <div class="inline-flex items-center px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 text-xs font-semibold mb-4 w-fit" dir={client.regionalBadge.match(/[\u0600-\u06FF]/) ? 'rtl' : 'ltr'}>
                  {client.regionalBadge}
                </div>
              ) : client.banglaName ? (
                <div class="inline-flex items-center px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 text-xs font-semibold mb-4 w-fit font-bengali">
                  {client.banglaName}
                </div>
              ) : null}

              <div class="mt-auto pt-4 flex items-center justify-between text-sm">
                <span class="text-slate-500 font-medium">{client.category}</span>
                <span class="text-[#5568d3] font-bold group-hover:translate-x-1 transition-transform inline-flex items-center">
                  View Case Study
                  <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>
</MainLayout>
