---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import { clientPartners } from '../../lib/content/clients';

export function getStaticPaths() {
  return clientPartners.map(client => ({
    params: { slug: client.id },
    props: { client }
  }));
}

const { client } = Astro.props;

// Schema.org structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${client.name} - Digital Transformation Case Study`,
  "publisher": {
    "@type": "Organization",
    "name": "SoftDows",
    "url": "https://softdows.com",
    "logo": "https://softdows.com/images/softdows-logo.png"
  },
  "about": {
    "@type": "Organization",
    "name": client.name,
    "url": client.url
  },
  "mainEntityOfPage": {
    "@type": "WebSite",
    "@id": `https://softdows.com/clients/${client.id}`
  }
};
---
<MainLayout 
  title={`${client.name} - Case Study`} 
  description={client.problem || `Discover how SoftDows engineered a ${client.category} for ${client.name}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="bg-[#FCFDFE] min-h-screen pt-12 pb-24">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li><a href="/" class="hover:text-[#5568d3] transition-colors">Home</a></li>
          <li><span class="text-slate-300">/</span></li>
          <li><a href="/clients" class="hover:text-[#5568d3] transition-colors">Clients</a></li>
          <li><span class="text-slate-300">/</span></li>
          <li><span class="text-slate-900 font-medium">{client.name}</span></li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <div class="mb-16">
        <div class="flex items-center gap-4 mb-6">
          <div class="p-4 bg-white rounded-xl shadow-sm border border-slate-100 h-24 w-24 flex items-center justify-center">
            <img src={client.logo} alt={client.name} class="max-h-full max-w-full object-contain" />
          </div>
          <div>
            <h1 class="text-4xl md:text-5xl font-extrabold text-[#192040] mb-2">{client.name}</h1>
            <p class="text-lg text-slate-500 font-medium">{client.category}</p>
          </div>
        </div>

        {client.regionalBadge ? (
          <div class="inline-flex items-center px-3 py-1.5 rounded-lg bg-blue-50 text-blue-700 text-sm font-bold border border-blue-100 shadow-sm" dir={client.regionalBadge.match(/[\u0600-\u06FF]/) ? 'rtl' : 'ltr'}>
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {client.regionalBadge}
          </div>
        ) : client.banglaName ? (
          <div class="inline-flex items-center px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 text-sm font-bold border border-emerald-100 shadow-sm font-bengali">
            {client.banglaName}
          </div>
        ) : null}
      </div>

      <!-- Main Layout Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: Case Study Details -->
        <div class="lg:col-span-5 space-y-10">
          
          {client.problem && client.solution && (
            <div class="space-y-8">
              <div>
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">The Challenge</h3>
                <p class="text-[#334155] leading-relaxed text-lg">{client.problem}</p>
              </div>
              <div class="pl-6 border-l-4 border-[#5568d3]">
                <h3 class="text-xs font-bold text-[#5568d3] uppercase tracking-widest mb-3">The Engineering Solution</h3>
                <p class="text-[#192040] font-medium leading-relaxed text-lg">{client.solution}</p>
              </div>
            </div>
          )}

          {client.realMetrics && (
            <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200">
              <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">Business Metrics</h3>
              <p class="text-[#334155] leading-relaxed font-medium">{client.realMetrics}</p>
            </div>
          )}

          <div class="grid grid-cols-2 gap-8 pt-6 border-t border-slate-100">
            {client.scope && (
              <div>
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Project Scope</h3>
                <ul class="space-y-2">
                  {client.scope.map(item => (
                    <li class="flex items-start text-sm text-[#334155] font-medium">
                      <svg class="w-4 h-4 text-emerald-500 mr-2 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {client.techStack && (
              <div>
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Technology Stack</h3>
                <div class="flex flex-wrap gap-2">
                  {client.techStack.map(tech => (
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-100 border border-slate-200 text-xs font-bold text-slate-700">
                      {tech.name}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
          
          <div class="pt-6 border-t border-slate-100">
             <a href={client.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-bold rounded-xl shadow-sm text-white bg-[#5568d3] hover:bg-[#4557c2] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#5568d3] w-full sm:w-auto">
                Visit Live Platform
                <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
             </a>
          </div>

        </div>

        <!-- Right: Visual Mockup -->
        <div class="lg:col-span-7">
          <div class="sticky top-32">
            <!-- Browser Chrome Mockup -->
            <div class="rounded-2xl overflow-hidden shadow-2xl shadow-slate-200/50 border border-slate-200 bg-white">
              <div class="bg-slate-50 px-4 py-3 border-b border-slate-200 flex items-center gap-4">
                <div class="flex gap-1.5 shrink-0">
                  <div class="w-3 h-3 rounded-full bg-slate-300"></div>
                  <div class="w-3 h-3 rounded-full bg-slate-300"></div>
                  <div class="w-3 h-3 rounded-full bg-slate-300"></div>
                </div>
                <div class="flex-grow flex justify-center">
                  <div class="bg-white px-4 py-1.5 rounded-md text-xs font-medium text-slate-500 border border-slate-200 flex items-center gap-2 max-w-sm w-full">
                    <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                    {client.domain}
                  </div>
                </div>
              </div>
              <div class="bg-slate-100 aspect-[16/10] relative flex items-center justify-center overflow-hidden">
                <img src={`/images/clients/${client.id}-snapshot.svg`} alt={`${client.name} Interface`} class="w-full h-full object-cover border-none" onerror="this.src='/images/clients/placeholder-snapshot.svg'; this.onerror=null;" />
              </div>
            </div>
            
            {client.hotline && (
              <div class="mt-6 text-center">
                <p class="text-sm font-medium text-slate-500">Live Support Hotline: <a href={`tel:${client.hotline.replace(/\s+/g, '')}`} class="text-[#5568d3] hover:underline font-bold">{client.hotline}</a></p>
              </div>
            )}
          </div>
        </div>

      </div>
    </div>
  </div>
</MainLayout>
