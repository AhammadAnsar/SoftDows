---
export const prerender = false;
import MainLayout from '../layouts/MainLayout.astro';
import { getDb } from '../lib/db';
import { leads } from '../lib/db/schema/crm';

let errors: Record<string, string> = {};
let isSuccess = false;
let formData = {
  name: '',
  email: '',
  company: '',
  requestedService: '',
  projectDescription: '',
  budgetRange: ''
};

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    
    // Honeypot field for basic bot protection
    const botTrap = data.get('website_url')?.toString();
    
    formData = {
      name: data.get('name')?.toString().trim() || '',
      email: data.get('email')?.toString().trim() || '',
      company: data.get('company')?.toString().trim() || '',
      requestedService: data.get('requestedService')?.toString().trim() || '',
      projectDescription: data.get('projectDescription')?.toString().trim() || '',
      budgetRange: data.get('budgetRange')?.toString().trim() || ''
    };

    if (botTrap) {
      // Silently succeed for bots
      isSuccess = true;
    } else {
      // Validate
      if (!formData.name) errors.name = 'Please provide your full name.';
      else if (formData.name.length > 100) errors.name = 'Name is too long.';
      
      if (!formData.email) errors.email = 'Please provide your email address.';
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(formData.email)) errors.email = 'Please provide a valid email address.';
      else if (formData.email.length > 255) errors.email = 'Email is too long.';
      
      const VALID_SERVICES = [
        'Website Design & Development',
        'Custom Software & Web Applications',
        'eCommerce Development',
        'UI/UX Design',
        'SEO & Digital Visibility',
        'Website Maintenance & Support',
        'Not sure / Need guidance'
      ];
      if (!formData.requestedService) {
        errors.requestedService = 'Please select a service.';
      } else if (!VALID_SERVICES.includes(formData.requestedService)) {
        errors.requestedService = 'Invalid service selected.';
      }
      
      if (!formData.projectDescription) errors.projectDescription = 'Please describe your project briefly.';
      else if (formData.projectDescription.length > 3000) errors.projectDescription = 'Description must be under 3000 characters.';

      if (Object.keys(errors).length === 0) {
        // Safe to insert
        const { env } = await import('cloudflare:workers');
        const db = getDb((env as any).DB);
        const newId = crypto.randomUUID();
        
        await db.insert(leads).values({
          id: newId,
          name: formData.name,
          email: formData.email,
          company: formData.company || null,
          requestedService: formData.requestedService,
          description: formData.projectDescription,
          budgetRange: formData.budgetRange || null,
          status: 'new'
        });
        
        isSuccess = true;
      }
    }
  } catch (err) {
    console.error('Lead submission error:', err);
    errors.system = 'An unexpected error occurred. Please try again later or contact us directly.';
  }
}
---

<MainLayout 
  title="Start a Project | SoftDows"
  description="Tell us about your project requirements. SoftDows provides premium Custom Software, Web Apps, eCommerce, and SEO services."
>
  <main class="min-h-screen bg-slate-50 pt-24 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">
      
      <!-- LEFT / MAIN: Form Area -->
      <div class="w-full lg:w-[65%] flex-shrink-0">
      {isSuccess ? (
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 sm:p-12 text-center">
          <div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h1 class="text-3xl font-bold text-slate-900 mb-4">Enquiry Received</h1>
          <p class="text-lg text-slate-600 mb-8 max-w-lg mx-auto">
            Thank you for reaching out. We've received your project details and our team will review them shortly. We'll be in touch to discuss the next steps.
          </p>
          <a href="/" class="inline-flex items-center justify-center px-8 py-3.5 rounded-lg bg-[var(--color-brand-purple)] text-white font-medium hover:bg-[#5264c8] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--color-brand-purple)]">
            Return Home
          </a>
        </div>
      ) : (
        <div class="bg-white rounded-3xl shadow-lg border border-slate-200 overflow-hidden">
          <div class="bg-[var(--color-brand-navy)] px-8 py-12 sm:px-14 text-center relative overflow-hidden">
            <div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-[var(--color-brand-purple)] opacity-20 rounded-full blur-3xl"></div>
            <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4 relative z-10 tracking-tight">Tell Us About Your Project</h1>
            <p class="text-[var(--color-brand-light)] opacity-90 text-lg max-w-xl mx-auto relative z-10 leading-relaxed">
              Submit your project details below. We'll review your requirements and get back to you to discuss scope, timeline, and next steps.
            </p>
          </div>

          <form method="POST" class="px-8 py-10 sm:px-14">
            
            {errors.system && (
              <div class="mb-8 p-4 bg-red-50 border border-red-200 rounded-lg text-red-600 font-medium">
                {errors.system}
              </div>
            )}

            {/* Honeypot */}
            <div class="hidden" aria-hidden="true">
              <label for="website_url">Website URL</label>
              <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off" />
            </div>

            <div class="space-y-6">
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-sm font-semibold text-slate-900 mb-1.5">Full Name <span class="text-red-500">*</span></label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    value={formData.name}
                    class:list={[
                      "w-full px-4 py-2.5 rounded-lg border bg-slate-50/50 hover:bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 transition-shadow",
                      errors.name ? "border-red-300 focus:border-red-500 focus:ring-red-500/20" : "border-slate-300 focus:border-[#6878d6] focus:ring-[#6878d6]/20"
                    ]}
                    aria-invalid={errors.name ? 'true' : undefined}
                    autocomplete="name"
                  />
                  {errors.name && <p class="mt-1.5 text-sm text-red-600">{errors.name}</p>}
                </div>

                <div>
                  <label for="email" class="block text-sm font-semibold text-slate-900 mb-1.5">Email Address <span class="text-red-500">*</span></label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    value={formData.email}
                    class:list={[
                      "w-full px-4 py-2.5 rounded-lg border bg-slate-50/50 hover:bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 transition-shadow",
                      errors.email ? "border-red-300 focus:border-red-500 focus:ring-red-500/20" : "border-slate-300 focus:border-[#6878d6] focus:ring-[#6878d6]/20"
                    ]}
                    aria-invalid={errors.email ? 'true' : undefined}
                    autocomplete="email"
                  />
                  {errors.email && <p class="mt-1.5 text-sm text-red-600">{errors.email}</p>}
                </div>
              </div>

              <div>
                <label for="company" class="block text-sm font-semibold text-slate-900 mb-1.5">Company / Organization <span class="text-slate-400 font-normal ml-1">(Optional)</span></label>
                <input 
                  type="text" 
                  id="company" 
                  name="company" 
                  value={formData.company}
                  class="w-full px-4 py-2.5 rounded-lg border border-slate-300 bg-slate-50/50 hover:bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#6878d6]/20 focus:border-[#6878d6] transition-shadow"
                  autocomplete="organization"
                />
              </div>

              <div>
                <label for="requestedService" class="block text-sm font-semibold text-slate-900 mb-1.5">What do you need? <span class="text-red-500">*</span></label>
                <div class="relative">
                  <select 
                    id="requestedService" 
                    name="requestedService" 
                    class:list={[
                      "w-full px-4 py-2.5 rounded-lg border bg-slate-50/50 hover:bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 transition-shadow appearance-none pr-10",
                      errors.requestedService ? "border-red-300 focus:border-red-500 focus:ring-red-500/20" : "border-slate-300 focus:border-[#6878d6] focus:ring-[#6878d6]/20"
                    ]}
                    aria-invalid={errors.requestedService ? 'true' : undefined}
                  >
                    <option value="" disabled selected={!formData.requestedService}>Select a service...</option>
                    <option value="Website Design & Development" selected={formData.requestedService === 'Website Design & Development'}>Website Design & Development</option>
                    <option value="Custom Software & Web Applications" selected={formData.requestedService === 'Custom Software & Web Applications'}>Custom Software & Web Applications</option>
                    <option value="eCommerce Development" selected={formData.requestedService === 'eCommerce Development'}>eCommerce Development</option>
                    <option value="UI/UX Design" selected={formData.requestedService === 'UI/UX Design'}>UI/UX Design</option>
                    <option value="SEO & Digital Visibility" selected={formData.requestedService === 'SEO & Digital Visibility'}>SEO & Digital Visibility</option>
                    <option value="Website Maintenance & Support" selected={formData.requestedService === 'Website Maintenance & Support'}>Website Maintenance & Support</option>
                    <option value="Not sure / Need guidance" selected={formData.requestedService === 'Not sure / Need guidance'}>Not sure / Need guidance</option>
                  </select>
                  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                  </div>
                </div>
                {errors.requestedService && <p class="mt-1.5 text-sm text-red-600">{errors.requestedService}</p>}
              </div>

              <div>
                <label for="budgetRange" class="block text-sm font-semibold text-slate-900 mb-1.5">Estimated Budget <span class="text-slate-400 font-normal ml-1">(Optional)</span></label>
                <div class="relative">
                  <select 
                    id="budgetRange" 
                    name="budgetRange" 
                    class="w-full px-4 py-2.5 rounded-lg border border-slate-300 bg-slate-50/50 hover:bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#6878d6]/20 focus:border-[#6878d6] transition-shadow appearance-none pr-10"
                  >
                    <option value="" disabled selected={!formData.budgetRange}>Select a range...</option>
                    <optgroup label="USD">
                      <option value="< $1,000 USD" selected={formData.budgetRange === '< $1,000 USD'}>Less than $1,000 USD</option>
                    <option value="$1,000 - $5,000 USD" selected={formData.budgetRange === '$1,000 - $5,000 USD'}>$1,000 - $5,000 USD</option>
                    <option value="$5,000 - $10,000 USD" selected={formData.budgetRange === '$5,000 - $10,000 USD'}>$5,000 - $10,000 USD</option>
                    <option value="$10,000+ USD" selected={formData.budgetRange === '$10,000+ USD'}>$10,000+ USD</option>
                  </optgroup>
                  <optgroup label="BDT">
                    <option value="< 1,00,000 BDT" selected={formData.budgetRange === '< 1,00,000 BDT'}>Less than 1,00,000 BDT</option>
                    <option value="1,00,000 - 5,00,000 BDT" selected={formData.budgetRange === '1,00,000 - 5,00,000 BDT'}>1,00,000 - 5,00,000 BDT</option>
                    <option value="5,00,000+ BDT" selected={formData.budgetRange === '5,00,000+ BDT'}>5,00,000+ BDT</option>
                  </optgroup>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </div>
              </div>
            </div>

            <div>
              <label for="projectDescription" class="block text-sm font-semibold text-slate-900 mb-1.5">Project Details <span class="text-red-500">*</span></label>
                <p class="text-sm text-slate-500 mb-2">Please describe your goals, features you need, and any specific requirements.</p>
                <textarea 
                  id="projectDescription" 
                  name="projectDescription" 
                  rows="5"
                  class:list={[
                    "w-full px-4 py-3 rounded-lg border bg-slate-50/50 hover:bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 transition-shadow resize-y",
                    errors.projectDescription ? "border-red-300 focus:border-red-500 focus:ring-red-500/20" : "border-slate-300 focus:border-[#6878d6] focus:ring-[#6878d6]/20"
                  ]}
                  aria-invalid={errors.projectDescription ? 'true' : undefined}
                >{formData.projectDescription}</textarea>
                {errors.projectDescription && <p class="mt-1.5 text-sm text-red-600">{errors.projectDescription}</p>}
              </div>

            </div>

            <div class="mt-8 pt-8 border-t border-slate-100 flex items-center justify-between flex-wrap gap-4">
              <p class="text-sm text-slate-500">
                Prefer email? Reach us at <a href="mailto:sales@softdows.com" class="font-medium text-[#6878d6] hover:underline">sales@softdows.com</a>
              </p>
              <button 
                type="submit" 
                class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-lg bg-[var(--color-brand-purple)] text-white font-medium hover:bg-[#5264c8] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--color-brand-purple)]"
              >
                Submit Project Enquiry
              </button>
            </div>

          </form>
        </div>
      )}
      </div>

      <!-- RIGHT / SUPPORTING: Context Panel -->
      <div class="w-full lg:w-[35%] flex-shrink-0 sticky top-32">
        <div class="bg-white rounded-3xl shadow-lg border border-slate-200 p-8">
           <h3 class="text-xl font-bold text-[var(--color-brand-navy)] mb-6">Our Consultation Process</h3>
           
           <div class="space-y-8 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-slate-200 before:to-transparent hidden-line">
             
             <div class="relative flex items-start gap-4">
               <div class="w-10 h-10 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0 z-10 text-[var(--color-brand-purple)]">
                 <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg>
               </div>
               <div class="pt-2">
                 <h4 class="font-bold text-slate-900">Tell us what you need</h4>
                 <p class="text-sm text-slate-500 mt-1">Submit your initial requirements, goals, and any technical preferences through this secure form.</p>
               </div>
             </div>

             <div class="relative flex items-start gap-4">
               <div class="w-10 h-10 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0 z-10 text-[var(--color-brand-purple)]">
                 <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
               </div>
               <div class="pt-2">
                 <h4 class="font-bold text-slate-900">We review your requirements</h4>
                 <p class="text-sm text-slate-500 mt-1">Our engineering and strategy team evaluates your submission to ensure we can provide genuine value.</p>
               </div>
             </div>

             <div class="relative flex items-start gap-4">
               <div class="w-10 h-10 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0 z-10 text-[var(--color-brand-purple)]">
                 <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" /></svg>
               </div>
               <div class="pt-2">
                 <h4 class="font-bold text-slate-900">We discuss scope & next steps</h4>
                 <p class="text-sm text-slate-500 mt-1">We schedule a direct consultation to align on architecture, timelines, and commercial structure.</p>
               </div>
             </div>
             
             {/* Simple visual connector fix for small relative container */}
             <style>
               .hidden-line::before { display: none; }
               .space-y-8 > div::before {
                 content: '';
                 position: absolute;
                 top: 40px;
                 bottom: -32px;
                 left: 20px;
                 width: 2px;
                 background: #f1f5f9;
                 z-index: 0;
               }
               .space-y-8 > div:last-child::before {
                 display: none;
               }
             </style>
           </div>
           
           <div class="mt-8 pt-6 border-t border-slate-100">
              <h4 class="font-bold text-slate-900 text-sm uppercase tracking-wider mb-3">Data Privacy</h4>
              <p class="text-sm text-slate-500">Your project details are used to review your enquiry and discuss appropriate next steps.</p>
           </div>
        </div>
      </div>

    </div>
  </main>
</MainLayout>














