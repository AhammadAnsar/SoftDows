---
// src/components/ui/LegalNotice.astro
---
<style>
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');
  .font-bengali {
    font-family: 'Hind Siliguri', sans-serif;
  }
  .modal-overlay {
    background-color: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
  }
</style>

<!-- Floating Trigger Button -->
<button id="legal-notice-trigger" class="fixed bottom-6 left-6 z-[45] flex items-center gap-2 px-4 py-2 bg-white/90 backdrop-blur text-slate-800 text-sm font-semibold rounded-full shadow-lg border border-slate-200 hover:shadow-xl hover:bg-slate-50 transition-all font-bengali transform hover:scale-105">
  <span class="text-amber-500 text-lg">⚠️</span> জরুরি বিজ্ঞপ্তি
</button>

<!-- Modal Overlay -->
<div id="legal-notice-modal" class="fixed inset-0 z-[60] flex items-center justify-center modal-overlay opacity-0 pointer-events-none transition-opacity duration-300 p-4">
  
  <!-- Modal Content -->
  <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full border-t-4 border-amber-500 overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]" id="legal-notice-content">
    
    <!-- Header -->
    <div class="bg-amber-50 px-4 sm:px-6 py-4 flex items-center gap-3 border-b border-amber-100 shrink-0">
      <span class="text-2xl hidden sm:inline-block">⚠️</span>
      <h3 class="font-bengali font-bold text-lg sm:text-xl text-amber-900 leading-snug">জরুরি সতর্কবার্তা ও দায়মুক্তি ঘোষণা</h3>
    </div>
    
    <!-- Body -->
    <div class="p-5 sm:p-6 md:p-8 overflow-y-auto">
      <p class="font-bengali text-slate-700 leading-relaxed sm:text-lg mb-4 text-justify text-sm">
        সর্বসাধারণের অবগতির জন্য জানানো যাচ্ছে যে, <strong>mygovbd.com</strong> নামক ডোমেইন বা ওয়েবসাইটটির সাথে <strong>SoftDows (softdows.com)</strong>-এর বর্তমানে কোনো ধরনের মালিকানা, পরিচালনা বা কারিগরি সম্পর্ক নেই।
      </p>
      <p class="font-bengali text-slate-700 leading-relaxed sm:text-lg mb-4 text-justify text-sm">
        ২০২৩ সালে শুধুমাত্র একটি তথ্যমূলক ব্লগ তৈরির চিন্তা থেকে ডোমেইনটি নিবন্ধন করা হলেও পরবর্তীতে তা আর ব্যবহার করা হয়নি এবং মেয়াদ শেষে নবায়ন (Renew) না করায় ডোমেইনটির নিয়ন্ত্রণ আমাদের কাছ থেকে স্বয়ংক্রিয়ভাবে বাতিল হয়ে যায়। সম্প্রতি কোনো অসাধু প্রতারক চক্র মেয়াদোত্তীর্ণ এই ডোমেইনটি পুনরায় কিনে ভুয়া অ্যাপোস্টিল (Apostille) বা সরকারি সনদ যাচাইয়ের নামে প্রতারণা করছে।
      </p>
      <p class="font-bengali text-slate-700 leading-relaxed sm:text-lg text-justify text-sm">
        ইন্টারনেটের পুরনো ক্যাশ বা পূর্ববর্তী WHOIS রেকর্ডের সূত্র ধরে কেউ বিভ্রান্ত হবেন না। এই বিষয়ে আমরা ইতোমধ্যে <strong>সিআইডি (সাইবার পুলিশ সেন্টার)</strong>-তে লিখিতভাবে আমাদের অবস্থান ও প্রমাণাদি দাখিল করেছি। সরকারি যেকোনো সেবার জন্য শুধুমাত্র <strong>.gov.bd</strong> যুক্ত অফিসিয়াল ওয়েবসাইট ব্যবহার করার অনুরোধ করা হলো।
      </p>
    </div>
    
    <!-- Footer Actions -->
    <div class="bg-slate-50 px-4 sm:px-6 py-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-end gap-3 shrink-0">
      <button id="legal-notice-close" class="w-full sm:w-auto px-6 py-2.5 rounded-lg text-slate-600 font-bengali font-semibold hover:bg-slate-200 transition-colors order-2 sm:order-1">
        বন্ধ করুন
      </button>
      <a href="/legal-disclaimer" class="w-full sm:w-auto px-6 py-2.5 rounded-lg bg-[var(--color-brand-navy)] text-white font-bengali font-semibold hover:bg-slate-800 transition-colors shadow-sm text-center order-1 sm:order-2" id="legal-notice-readmore">
        বিস্তারিত আইনি নোটিশ পড়ুন
      </a>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('legal-notice-modal');
  const content = document.getElementById('legal-notice-content');
  const triggerBtn = document.getElementById('legal-notice-trigger');
  const closeBtn = document.getElementById('legal-notice-close');
  const readMoreBtn = document.getElementById('legal-notice-readmore');

  function openModal() {
    if(modal && content) {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      content.classList.remove('scale-95');
      content.classList.add('scale-100');
      // prevent body scroll
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if(modal && content) {
      modal.classList.add('opacity-0', 'pointer-events-none');
      content.classList.remove('scale-100');
      content.classList.add('scale-95');
      document.body.style.overflow = '';
    }
  }

  // Event Listeners
  if (triggerBtn) triggerBtn.addEventListener('click', openModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (readMoreBtn) readMoreBtn.addEventListener('click', closeModal);
  
  // Close on overlay click
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }
</script>
