---
import Badge from './Badge.astro';
import Button from './Button.astro';

interface Props {
  project: any;
}
const { project } = Astro.props;
---

<div class="group flex flex-col bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300">
  <!-- Image Placeholder or Actual Image -->
  <a href={`/work/${project.id}/`} class="block w-full aspect-video bg-slate-100 overflow-hidden relative focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--color-brand-purple)]">
    <div class="absolute inset-0 flex items-center justify-center text-slate-300 group-hover:scale-105 transition-transform duration-500">
       <svg class="w-16 h-16 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
    </div>
  </a>
  <div class="p-8 flex flex-col flex-grow">
    <div class="flex items-center gap-3 mb-4">
      <Badge variant="outline">{project.data.industry}</Badge>
    </div>
    <h3 class="text-2xl font-bold text-[var(--color-brand-navy)] mb-3 group-hover:text-[var(--color-brand-purple)] transition-colors">
      <a href={`/work/${project.id}/`} class="focus-visible:outline-none focus-visible:underline underline-offset-4">{project.data.title}</a>
    </h3>
    <p class="text-[var(--color-text-muted)] leading-relaxed mb-8 flex-grow">
      {project.data.projectSummary}
    </p>
    <div class="mt-auto pt-6 border-t border-slate-100 flex items-center justify-between">
      <a href={`/work/${project.id}/`} class="text-[var(--color-brand-purple)] font-medium text-sm tracking-wide uppercase group-hover:underline underline-offset-4 focus-visible:outline-none">Read case study</a>
      <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-[var(--color-brand-purple)] transform group-hover:translate-x-2 group-hover:bg-[var(--color-brand-light)] transition-all">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </div>
    </div>
  </div>
</div>

