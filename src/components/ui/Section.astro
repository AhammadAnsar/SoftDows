---
interface Props {
  variant?: 'default' | 'alternate' | 'dark' | 'light' | 'primary';
  size?: 'normal' | 'narrow' | 'wide' | 'large';
  class?: string;
}

const { 
  variant = 'default', 
  size = 'normal', 
  class: className = '' 
} = Astro.props;

const bgStyles = variant === 'alternate' ? 'bg-[var(--color-surface-alt)]' : 
                 variant === 'dark' ? 'bg-[var(--color-brand-navy)] text-white' : 
                 variant === 'primary' ? 'bg-[var(--color-brand-purple)] text-white' : 
                 variant === 'light' ? 'bg-slate-50' : 'bg-white';
const paddingStyles = size === 'large' ? 'py-20 md:py-32' : 'py-16 md:py-24';

let containerSize = "max-w-7xl";
if (size === 'narrow') containerSize = "max-w-3xl";
if (size === 'wide') containerSize = "max-w-[100rem]";
---
<section class={`${bgStyles} ${paddingStyles} ${className}`}>
  <div class={`mx-auto w-full px-6 md:px-8 ${containerSize}`}>
    <slot />
  </div>
</section>

