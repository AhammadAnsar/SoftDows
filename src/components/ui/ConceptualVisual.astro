      <div class="relative z-10 flex flex-col items-center transform group-hover:scale-105 transition-transform duration-700">
        <span class="text-7xl md:text-8xl font-bold tracking-tighter text-transparent bg-clip-text bg-gradient-to-br from-white via-slate-200 to-slate-500">
          {name.split(' ').map(n => n[0]).join('')}
