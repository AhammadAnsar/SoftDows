---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline' | 'inverse' | 'inverse-outline' | 'text';
  size?: 'normal' | 'large' | 'small';
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  class?: string;
  disabled?: boolean;
}

const { 
  variant = 'primary', 
  size = 'normal',
  type = 'button', 
  href, 
  class: className = '', 
  disabled = false 
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-semibold transition-all duration-300 ease-out rounded-[var(--radius-btn)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 hover:-translate-y-[2px] active:translate-y-[0px] active:scale-[0.98]";

const sizes = {
  small: "px-4 py-2 text-sm min-h-[36px]",
  normal: "px-6 py-2.5 text-base min-h-[44px]",
  large: "px-8 py-3.5 text-lg min-h-[52px]"
};

const variants = {
  primary: "bg-[var(--color-brand-purple)] text-white shadow-md hover:shadow-lg hover:bg-[#5264c8] hover:shadow-[var(--color-brand-purple)]/20 focus-visible:ring-[var(--color-brand-purple)] border border-transparent",
  secondary: "bg-[var(--color-brand-light)] text-[var(--color-brand-navy)] shadow-sm hover:shadow-md hover:bg-[#e0e7ff] focus-visible:ring-[var(--color-brand-navy)] border border-transparent",
  outline: "bg-transparent text-[var(--color-brand-navy)] border-2 border-slate-300 hover:border-[var(--color-brand-purple)] hover:text-[var(--color-brand-purple)] hover:bg-slate-50 focus-visible:ring-[var(--color-brand-navy)]",
  ghost: "bg-transparent text-[var(--color-brand-navy)] hover:bg-slate-100 focus-visible:ring-[var(--color-brand-navy)] border border-transparent",
  text: "bg-transparent text-[var(--color-brand-purple)] hover:text-[#5264c8] hover:underline underline-offset-4 focus-visible:ring-[var(--color-brand-purple)] border border-transparent !px-0 hover:-translate-y-0 active:scale-100",
  inverse: "bg-white text-[var(--color-brand-navy)] shadow-md hover:shadow-lg hover:bg-slate-50 focus-visible:ring-white focus-visible:ring-offset-[var(--color-brand-navy)] border border-transparent",
  "inverse-outline": "bg-transparent text-white border-2 border-white/30 hover:border-white hover:bg-white/10 focus-visible:ring-white focus-visible:ring-offset-[var(--color-brand-navy)]"
};

const classes = `${baseStyles} ${sizes[size]} ${variants[variant]} ${className}`;
---
{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} disabled={disabled}>
    <slot />
  </button>
)}

