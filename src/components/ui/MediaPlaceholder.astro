---
interface Props {
  type?: 'hero' | 'card' | 'feature' | 'portrait';
  class?: string;
  label?: string;
}

const { 
  type = 'card',
  class: className = '',
  label
} = Astro.props;

// Determine aspect ratio based on type
const aspectRatioClass = {
  hero: 'aspect-[21/9] md:aspect-[2.5/1]',
  card: 'aspect-[4/3] sm:aspect-video',
  feature: 'aspect-square md:aspect-[4/3]',
  portrait: 'aspect-[3/4]'
}[type];

const displayLabel = label || `${type.charAt(0).toUpperCase() + type.slice(1)} Media Content`;
---

<div class={`relative overflow-hidden bg-slate-50 border border-slate-100 rounded-2xl flex flex-col items-center justify-center group ${aspectRatioClass} ${className}`}>
  {/* Geometric subtle background */}
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px] pointer-events-none"></div>
  <div class="absolute inset-0 bg-gradient-to-tr from-slate-100/50 to-transparent"></div>
  
  {/* Animated subtle shapes */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-3/4 max-w-sm aspect-square bg-[var(--color-brand-purple)]/5 rounded-full blur-3xl group-hover:bg-[var(--color-brand-purple)]/10 transition-colors duration-700"></div>

  {/* Content Layer */}
  <div class="relative z-10 flex flex-col items-center justify-center p-6 text-center transform group-hover:scale-105 transition-transform duration-500">
    <div class="w-16 h-16 mb-4 rounded-2xl bg-white shadow-sm border border-slate-100 flex items-center justify-center text-slate-400 group-hover:text-[var(--color-brand-purple)] transition-colors">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>
    <span class="text-sm font-semibold tracking-wider text-slate-500 uppercase">{displayLabel}</span>
    <span class="text-xs text-slate-400 mt-2 font-mono">Awaiting CMS Asset</span>
  </div>
</div>

