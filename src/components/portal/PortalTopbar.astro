---
import type { User } from 'better-auth';

interface Props {
  user: User;
}

const { user } = Astro.props;
---
<header class="h-16 bg-white border-b border-[#e2e8f0] flex items-center justify-between px-4 md:px-6 shrink-0">
  <div class="flex items-center md:hidden">
    <a href="/portal" class="text-xl font-bold text-[#242a56]">SoftDows</a>
  </div>
  
  <div class="hidden md:block flex-1"></div>

  <div class="flex items-center gap-4">
    <div class="relative group">
      <button class="flex items-center gap-2 hover:bg-slate-50 rounded-lg p-1.5 pr-3 transition-colors">
        <div class="w-8 h-8 rounded-full bg-[#6878d6] text-white flex items-center justify-center text-sm font-bold">
          {user.name.charAt(0).toUpperCase()}
        </div>
        <span class="text-sm font-medium text-[#242a56] hidden sm:block">{user.name}</span>
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      
      <div class="absolute right-0 mt-1 w-48 bg-white rounded-xl shadow-lg border border-slate-200 py-1 hidden group-hover:block z-50">
        <div class="px-4 py-2 border-b border-slate-100">
          <p class="text-sm font-medium text-slate-800">{user.name}</p>
          <p class="text-xs text-slate-500 truncate">{user.email}</p>
        </div>
        <a href="/portal/profile" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50">Profile</a>
        <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50">Sign Out</a>
      </div>
    </div>
  </div>
</header>
