  },

  // Ventures
  '/ventures/banglanotice/': {
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    desc: 'National academic notice & circular network',
    color: 'text-emerald-600 bg-emerald-50 group-hover/sub:bg-emerald-600 group-hover/sub:text-white'
  },
  '/ventures/bidyashikhi/': {
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
    desc: 'Structured curriculum & interactive learning',
    color: 'text-blue-600 bg-blue-50 group-hover/sub:bg-blue-600 group-hover/sub:text-white'
  },
  '/ventures/nicetrix/': {
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    desc: 'Digital workflow, tech insights & productivity',
    color: 'text-purple-600 bg-purple-50 group-hover/sub:bg-purple-600 group-hover/sub:text-white'
  },
  '/ventures/baharimart/': {
    icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
    desc: 'Curated e-commerce storefront experiment',
    color: 'text-amber-600 bg-amber-50 group-hover/sub:bg-amber-600 group-hover/sub:text-white'
  },

  // Company
  '/about/': {
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
    desc: 'Our engineering philosophy & background',
    color: 'text-indigo-600 bg-indigo-50 group-hover/sub:bg-indigo-600 group-hover/sub:text-white'
  },
  '/team/': {
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
