---
import { mainNav as fallbackMainNav } from '../../config/navigation';
import { contactConfig } from '../../config/site';
import Button from '../ui/Button.astro';


const mainNav = fallbackMainNav;

const currentPath = Astro.url.pathname;

// 100% Static Icon & Micro-description mappings (Zero DB overhead)
