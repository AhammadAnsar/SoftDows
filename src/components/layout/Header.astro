};

// 100% Static Top-level menu item icons
const topLevelIcons: Record<string, string> = {
  'Home': 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  'Services': 'M13 10V3L4 14h7v7l9-11h-7z',
  'Clients': 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
    'Products': 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  'Ventures': 'M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z',
  'Company': 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4'
};
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-xl shadow-xs transition-all duration-300">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8 gap-4">
    
    <!-- Logo with smart micro-status -->
    <a href="/" class="inline-flex items-center gap-2.5 z-50 shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 rounded-xl transition-all hover:opacity-90">
      <img src="/logo.png" alt="SoftDows" class="h-8 sm:h-9 md:h-10 w-auto object-contain" />
    </a>

    <!-- Desktop Nav with Top-Level & Mega-Menu Icons -->
    <nav class="hidden md:flex items-center gap-1.5 lg:gap-2 shrink-0" aria-label="Main Navigation">
      {mainNav.map((item: any) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        const hasChildren = item.children && item.children.length > 0;
        const iconD = topLevelIcons[item.label] || '';
        
        return hasChildren ? (
          <div class="group relative py-6">
            <a 
              href={item.href} 
              class={`flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 ${
                isActive 
                  ? 'bg-slate-100 text-[#0F172A] shadow-2xs' 
                  : 'text-slate-600 hover:text-[#0F172A] hover:bg-slate-50'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {iconD && (
                <svg class="w-4 h-4 text-slate-400 group-hover:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={iconD} />
                </svg>
              )}
              <span>{item.label}</span>
              <svg class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            
            <!-- Smart Mega Menu Dropdown with Static Icons & Subtitles -->
            <div class={`absolute left-1/2 -translate-x-1/2 top-full ${
              (item.children?.length || 0) > 1 ? 'w-[680px]' : 'w-[420px]'
            } bg-white border border-slate-200/90 shadow-2xl rounded-3xl p-6 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0 z-50`}>
              
              <div class={`grid gap-6 ${(item.children?.length || 0) > 1 ? 'grid-cols-2' : 'grid-cols-1'}`}>
                {item.children?.map((group: any) => (
                  <div>
                    <h3 class="text-[11px] font-bold font-mono text-slate-400 uppercase tracking-wider mb-3 px-2">
                      {group.group}
                    </h3>
                    <ul class="space-y-1">
                      {group.items.map((link: any) => {
                        const meta = subItemMeta[link.href] || {
                          icon: 'M9 5l7 7-7 7',
                          desc: 'Explore platform capabilities',
                          color: 'text-slate-600 bg-slate-100 group-hover/sub:bg-indigo-600 group-hover/sub:text-white'
                        };

                        return (
                          <li>
                            <a 
                              href={link.href} 
                              class="group/sub flex items-start gap-3 p-2.5 rounded-2xl hover:bg-slate-50 transition-colors"
                            >
                              <div class={`w-9 h-9 rounded-xl flex items-center justify-center shrink-0 transition-colors ${meta.color}`}>
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={meta.icon} />
                                </svg>
                              </div>
                              <div class="space-y-0.5">
                                <div class="text-xs font-bold text-[#0F172A] group-hover/sub:text-indigo-600 transition-colors">
                                  {link.label}
                                </div>
                                <div class="text-[11px] text-slate-500 line-clamp-1 font-normal">
                                  {meta.desc}
                                </div>
                              </div>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </div>

              <!-- Mega Menu Footer Link -->
              <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between px-2">
                <a 
                  href={item.href} 
                  class="text-xs font-bold text-indigo-600 hover:text-indigo-700 transition-colors flex items-center gap-1.5"
                >
                  <span>View All {item.label}</span>
                  <span>&rarr;</span>
                </a>

                <span class="text-[11px] text-slate-400 font-mono">
                  100% In-House Engineering
                </span>
              </div>

            </div>
          </div>
        ) : (
          <a 
            href={item.href} 
            class={`flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 ${
              isActive 
                ? 'bg-slate-100 text-[#0F172A] shadow-2xs' 
                : 'text-slate-600 hover:text-[#0F172A] hover:bg-slate-50'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {iconD && (
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={iconD} />
              </svg>
            )}
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <!-- Right Side CTA & Mobile Hamburger -->
    <div class="flex items-center justify-end gap-3 z-50 shrink-0">
      
      <!-- Quick Contact Hotline Pill (Official SoftDows Number) -->
      <a 
        href={`tel:${contactConfig.phonePrimary.replace(/\s+/g, '')}`} 
        class="hidden xl:flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-medium text-slate-700 transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>+880 1737-011052</span>
      </a>

      <Button href="/start-a-project/" class="hidden sm:inline-flex whitespace-nowrap shadow-xs" variant="primary">
        Start a Project
      </Button>
      
      <button 
        type="button" 
        id="mobile-menu-button"
        class="md:hidden flex items-center justify-center p-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg class="h-6 w-6 menu-icon-open" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg class="h-6 w-6 hidden menu-icon-close" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Menu Drawer -->
  <div class="md:hidden hidden absolute top-full left-0 w-full bg-white border-b border-slate-200 shadow-xl overflow-y-auto max-h-[calc(100vh-5rem)]" id="mobile-menu">
    <div class="space-y-2 p-6">
      {mainNav.map((item: any, index: number) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        const hasChildren = item.children && item.children.length > 0;
        const iconD = topLevelIcons[item.label] || '';
        
        return hasChildren ? (
          <div class="py-2 border-b border-slate-100 last:border-0">
            <button class="mobile-accordion-btn flex items-center justify-between w-full py-2 text-base font-bold text-[#0F172A]" aria-expanded="false" aria-controls={`mobile-menu-${index}`}>
              <div class="flex items-center gap-2">
                {iconD && (
                  <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={iconD} />
                  </svg>
                )}
                <span>{item.label}</span>
              </div>
              <svg class="w-5 h-5 transition-transform accordion-icon text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div id={`mobile-menu-${index}`} class="hidden pl-2 pr-2 py-3 space-y-4">
              {item.children?.map((group: any) => (
                <div>
                  <h4 class="text-[10px] font-bold font-mono text-slate-400 uppercase tracking-wider mb-2">{group.group}</h4>
                  <ul class="space-y-2 pl-2 border-l-2 border-slate-100">
                    {group.items.map((link: any) => (
                      <li>
                        <a href={link.href} class="block py-1 text-sm font-semibold text-slate-700 hover:text-indigo-600">
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <a href={item.href} class="block pt-2 text-sm font-bold text-indigo-600">
                View All {item.label} &rarr;
              </a>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class={`flex items-center gap-2.5 rounded-xl px-3 py-3 text-base font-semibold transition-colors ${
              isActive 
                ? 'bg-indigo-50 text-indigo-700' 
                : 'text-slate-700 hover:bg-slate-50 hover:text-indigo-600'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {iconD && (
              <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={iconD} />
              </svg>
            )}
            <span>{item.label}</span>
          </a>
        );
      })}
      
      <div class="pt-4 sm:hidden">
        <Button href="/start-a-project/" class="w-full shadow-md" variant="primary">
          Start a Project
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.querySelector('.menu-icon-open');
  const iconClose = document.querySelector('.menu-icon-close');
  
  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }

  const accordions = document.querySelectorAll('.mobile-accordion-btn');
  accordions.forEach(acc => {
    acc.addEventListener('click', () => {
      const expanded = acc.getAttribute('aria-expanded') === 'true';
      acc.setAttribute('aria-expanded', String(!expanded));
      const target = document.getElementById(acc.getAttribute('aria-controls')!);
      const icon = acc.querySelector('.accordion-icon');
      
      if (target && icon) {
        target.classList.toggle('hidden');
        if (expanded) {
          (icon as HTMLElement).style.transform = 'rotate(0deg)';
        } else {
          (icon as HTMLElement).style.transform = 'rotate(180deg)';
        }
      }
    });
  });
</script>




