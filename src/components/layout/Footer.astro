---
import { getCollection } from 'astro:content';
import { footerNav as fallbackFooterNav } from '../../config/navigation';
import { siteConfig, contactConfig as fallbackContactConfig } from '../../config/site';

import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { getFooterNavigation, getGlobalSiteSettings } from '../../lib/cms/content';

const db = getDb((env as any).DB);
const [dbFooterNav, dbSettings] = await Promise.all([
  getFooterNavigation(db).catch(() => null),
  getGlobalSiteSettings(db).catch(() => ({} as Record<string, string>))
]);

const footerNav = dbFooterNav || fallbackFooterNav;

const contactConfig = {
  address: dbSettings['contact_address'] || fallbackContactConfig.address,
  phone: dbSettings['contact_phone'] || fallbackContactConfig.phone,
  email: dbSettings['contact_email'] || fallbackContactConfig.email,
  social: fallbackContactConfig.social // Social could be merged too
};

const copyrightText = dbSettings['footer_copyright'] || `© ${new Date().getFullYear()} SoftDows. All rights reserved.`;

const allWork = await getCollection('work').catch(() => []);
const hasPublishedWork = allWork.filter((p: any) => !p.data.isDraft).length > 0;
const filteredCompanyNav = hasPublishedWork ? footerNav.company : (footerNav.company || []).filter((item: any) => item.href !== '/work/');
---
<footer class="bg-[var(--color-brand-navy)] text-white relative overflow-hidden pt-16 pb-8 md:pt-24 md:pb-12 mt-auto border-t border-slate-800">
  {/* Abstract geometric background */}
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none opacity-20"></div>
  <div class="absolute top-0 right-0 w-full max-w-2xl aspect-square bg-[var(--color-brand-purple)]/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-5 xl:gap-8">
      
      <!-- Brand & Positioning Column -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-block text-3xl font-bold tracking-tight text-white mb-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--color-brand-navy)] focus-visible:ring-white rounded-md transition-colors hover:text-[var(--color-brand-light)]">
          {siteConfig.name}
        </a>
        <p class="text-[var(--color-brand-light)] opacity-70 text-base leading-relaxed max-w-sm mb-8 font-light">
          {siteConfig.description}
        </p>
        
        <div class="flex flex-col gap-4 text-sm text-white">
          <a href={`mailto:${contactConfig.email}`} class="flex items-center gap-3 hover:text-white group transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--color-brand-navy)] focus-visible:ring-white rounded-sm w-fit font-medium">
            <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-white/10 transition-colors">
              <svg class="h-5 w-5 text-[var(--color-brand-light)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            {contactConfig.email}
          </a>
          <a href={`tel:${contactConfig.phonePrimary.replace(/\s+/g, '')}`} class="flex items-center gap-3 hover:text-white group transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--color-brand-navy)] focus-visible:ring-white rounded-sm w-fit font-medium">
            <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-white/10 transition-colors">
              <svg class="h-5 w-5 text-[var(--color-brand-light)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.08-7.074-6.974l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            {contactConfig.phonePrimary}
          </a>
        </div>
      </div>

      <!-- Navigation Columns -->
      <div class="lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
        <div>
          <h3 class="text-xs font-bold text-white tracking-widest uppercase mb-6 opacity-60">Services</h3>
          <ul class="flex flex-col gap-4">
            {footerNav.services.map(item => (
              <li>
                <a href={item.href} class="text-sm text-[var(--color-brand-light)] opacity-80 hover:opacity-100 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--color-brand-navy)] focus-visible:ring-white rounded-sm">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-xs font-bold text-white tracking-widest uppercase mb-6 opacity-60">Products</h3>
          <ul class="flex flex-col gap-4">
            {footerNav.products.map(item => (
              <li>
                <a href={item.href} class="text-sm text-[var(--color-brand-light)] opacity-80 hover:opacity-100 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--color-brand-navy)] focus-visible:ring-white rounded-sm">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-xs font-bold text-white tracking-widest uppercase mb-6 opacity-60">Company</h3>
          <ul class="flex flex-col gap-4">
            {filteredCompanyNav.map(item => (
              <li>
                <a href={item.href} class="text-sm text-[var(--color-brand-light)] opacity-80 hover:opacity-100 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--color-brand-navy)] focus-visible:ring-white rounded-sm">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-xs font-bold text-white tracking-widest uppercase mb-6 opacity-60">Legal</h3>
          <ul class="flex flex-col gap-4">
            {footerNav.legal.map(item => (
              <li>
                <a href={item.href} class="text-sm text-[var(--color-brand-light)] opacity-80 hover:opacity-100 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--color-brand-navy)] focus-visible:ring-white rounded-sm">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Copyright Area -->
    <div class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="text-sm text-[var(--color-brand-light)] opacity-60 text-center md:text-left">
        {copyrightText}
      </p>
      
      <!-- Only mapping configured socials if available in future -->
      <div class="flex gap-4">
        {contactConfig.socials?.map((social: { name: string, url: string }) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer" class="text-[var(--color-brand-light)] opacity-60 hover:opacity-100 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--color-brand-navy)] focus-visible:ring-white rounded-sm text-sm">
            {social.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>


