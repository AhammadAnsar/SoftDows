---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../ui/Section.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---
<MainLayout title={`${title} | SoftDows`} noindex={true}>
  <Section variant="default" size="narrow" class="text-center">
    <Badge class="mb-4">Future Phase Content</Badge>
    <h1 class="mb-6">{title}</h1>
    <p class="text-[var(--color-text-muted)]">{description || `This page is architecturally planned and will be built in a future phase.`}</p>
  </Section>
</MainLayout>

