---
import { getAuthorizedNavigation } from '../../lib/admin/navigation';
import type { AppRole } from '../../lib/auth/permissions';
import AdminIcon from './AdminIcon.astro';

interface Props {
  role: AppRole;
  currentPath: string;
}

const { role, currentPath } = Astro.props;
const navigation = getAuthorizedNavigation(role);
---

<aside 
  id="admin-sidebar" 
  class="fixed top-0 left-0 z-50 w-64 h-[100dvh] bg-[#242a56] text-[#eff2ff] transition-transform duration-300 ease-in-out transform -translate-x-full lg:translate-x-0 lg:static lg:h-screen lg:block flex flex-col shadow-xl lg:shadow-none"
  aria-label="Sidebar Navigation"
>
  <!-- Logo Area -->
  <div class="h-16 flex items-center px-6 bg-[#1a1e3e] border-b border-[#30386c] shrink-0">
    <a href="/admin" class="text-white font-bold text-xl tracking-tight flex items-center gap-2 hover:text-[#6878d6] transition-colors focus:outline-none focus:ring-2 focus:ring-[#6878d6] rounded-md">
      <div class="w-8 h-8 bg-[#6878d6] rounded flex items-center justify-center text-white font-black shadow-sm">
        S
      </div>
      SoftDows
    </a>
  </div>

  <!-- Navigation Links -->
  <div class="flex-1 overflow-y-auto py-5 px-3 space-y-6 no-scrollbar" id="sidebar-nav-container">
    {navigation.map((group) => (
      <div>
        <h3 class="px-3 text-[11px] font-bold text-[#8a96d1] uppercase tracking-widest mb-2.5">
          {group.label}
        </h3>
        <ul class="space-y-0.5">
          {group.items.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center gap-3 px-3 py-2 rounded-lg transition-all duration-200 text-sm font-medium border border-transparent focus:outline-none focus:ring-2 focus:ring-[#eff2ff]",
                    isActive 
                      ? "bg-[#6878d6] text-white shadow-sm border-[#7a8add] js-active-nav-item" 
                      : "text-[#cbd5e1] hover:bg-[#30386c] hover:text-white"
                  ]}
                  aria-current={isActive ? "page" : undefined}
                >
                  <AdminIcon name={item.icon} class="w-4 h-4" />
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</aside>

<!-- Mobile Overlay -->
<div 
  id="admin-sidebar-overlay"
  class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-40 hidden lg:hidden opacity-0 transition-opacity duration-300"
  aria-hidden="true"
></div>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

<script>
  const sidebar = document.getElementById('admin-sidebar');
  const overlay = document.getElementById('admin-sidebar-overlay');
  const toggleBtns = document.querySelectorAll('.js-sidebar-toggle');

  let isOpen = false;

  function toggleSidebar() {
    isOpen = !isOpen;
    if (isOpen) {
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('hidden');
      setTimeout(() => overlay?.classList.remove('opacity-0'), 10);
      document.body.style.overflow = 'hidden';
    } else {
      sidebar?.classList.add('-translate-x-full');
      overlay?.classList.add('opacity-0');
      setTimeout(() => overlay?.classList.add('hidden'), 300);
      document.body.style.overflow = '';
    }
  }

  toggleBtns.forEach(btn => btn.addEventListener('click', toggleSidebar));
  overlay?.addEventListener('click', toggleSidebar);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      toggleSidebar();
    }
  });

  // Handle window resize to clean up state if moving from mobile to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && isOpen) { // lg breakpoint is 1024px
      isOpen = false;
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.add('hidden', 'opacity-0');
      document.body.style.overflow = '';
    }
  });

  // Ensure active item is visible in scrollable area on load
  document.addEventListener('DOMContentLoaded', () => {
    // Small delay ensures layout is complete before calculating scroll position
    setTimeout(() => {
      const activeItem = document.querySelector('.js-active-nav-item');
      if (activeItem && sidebar) {
        // Use block: 'center' to put it nicely in the middle of the scroll area if possible
        activeItem.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }, 100);
  });
</script>

