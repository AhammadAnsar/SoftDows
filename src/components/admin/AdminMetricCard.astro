---
import AdminIcon from './AdminIcon.astro';

interface Props {
  label: string;
  value: string | number;
  icon: string;
  href?: string;
}

const { label, value, icon, href } = Astro.props;
---

<div class="bg-white rounded-xl border border-[#e2e8f0] p-5 flex flex-col h-full shadow-[0_2px_10px_-3px_rgba(6,81,237,0.05)] hover:shadow-[0_4px_20px_-5px_rgba(6,81,237,0.1)] transition-all duration-300">
  <div class="flex items-start justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-[#64748b]">{label}</p>
      <div class="mt-2">
        <p class="text-3xl font-bold text-[#242a56]">{value}</p>
      </div>
    </div>
    <div class="p-2.5 bg-[#eff2ff] rounded-lg text-[#6878d6]">
      <AdminIcon name={icon} class="w-5 h-5" />
    </div>
  </div>
  
  <div class="mt-auto pt-5">
    {href ? (
      <a href={href} class="text-sm font-semibold text-[#6878d6] hover:text-[#242a56] transition-colors inline-flex items-center gap-1">
        View records <AdminIcon name="menu" class="w-3 h-3" />
      </a>
    ) : (
      <span class="text-sm font-medium text-[#94a3b8] flex items-center gap-1.5">
        <div class="w-1.5 h-1.5 rounded-full bg-[#cbd5e1]"></div> No active records
      </span>
    )}
  </div>
</div>

