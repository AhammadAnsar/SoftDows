---
import AdminIcon from './AdminIcon.astro';

interface Props {
  title: string;
  description: string;
  icon?: string;
  actionLabel?: string;
  actionHref?: string;
}

const { title, description, icon, actionLabel, actionHref } = Astro.props;
---

<div class="flex flex-col items-center justify-center py-16 px-4 text-center bg-white rounded-xl border border-[#e2e8f0] border-dashed">
  {icon && (
    <div class="w-14 h-14 rounded-full bg-[#f8fafc] border border-[#f1f5f9] flex items-center justify-center text-[#94a3b8] mb-5 shadow-sm">
      <AdminIcon name={icon} class="w-6 h-6" />
    </div>
  )}
  <h3 class="text-base font-semibold text-[#242a56]">{title}</h3>
  <p class="mt-2 text-sm text-[#64748b] max-w-sm">{description}</p>
  
  {actionLabel && actionHref && (
    <div class="mt-6">
      <a 
        href={actionHref}
        class="inline-flex items-center justify-center px-4 py-2.5 text-sm font-medium text-white bg-[#6878d6] rounded-lg hover:bg-[#5a68c0] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#6878d6] transition-all shadow-sm"
      >
        <AdminIcon name="plus" class="w-4 h-4 mr-2" />
        {actionLabel}
      </a>
    </div>
  )}
</div>

