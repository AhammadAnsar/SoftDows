---
import type { User } from 'better-auth';
import type { AppRole } from '../lib/auth/permissions';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import AdminTopbar from '../components/admin/AdminTopbar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  user: User & { role?: AppRole };
}

const { title, user } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en" class="bg-slate-50 antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | SoftDows Admin</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class="flex h-screen overflow-hidden text-slate-800">
  
  <AdminSidebar role={user.role as AppRole} currentPath={currentPath} />

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <AdminTopbar user={user} />
    
    <main class="flex-1 overflow-y-auto p-4 lg:p-8">
      <div class="max-w-7xl mx-auto">
        <slot />
      </div>
    </main>
  </div>

</body>
</html>

