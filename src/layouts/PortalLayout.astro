---
import type { User } from 'better-auth';
import PortalSidebar from '../components/portal/PortalSidebar.astro';
import PortalTopbar from '../components/portal/PortalTopbar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  user: User;
}

const { title, user } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en" class="bg-slate-50 antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>{title} | SoftDows Client Portal</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class="flex h-screen overflow-hidden text-slate-800">
  
  <PortalSidebar currentPath={currentPath} />

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <PortalTopbar user={user} />
    
    <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8 bg-slate-50">
      <div class="max-w-7xl mx-auto">
        <slot />
      </div>
    </main>
  </div>
</body>
</html>
